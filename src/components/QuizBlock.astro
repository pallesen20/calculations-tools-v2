---
interface Question {
  q: string;
  options: [string, string, string, string];
  correct: 0 | 1 | 2 | 3;
  explanation: string;
}

interface Props {
  topic: string;
  questions: Question[];
  pageUrl: string;
}

const { topic, questions, pageUrl } = Astro.props;
const KEYS = ['A', 'B', 'C', 'D'] as const;
---

<section class="quiz-block" id="quiz" data-topic={topic} data-page-url={pageUrl}>
  <div class="quiz-header">
    <span class="quiz-eyebrow">Test your knowledge</span>
    <h2 class="quiz-title">Quiz: how well do you know {topic}?</h2>
    <p class="quiz-meta">5 questions &middot; ~2 min</p>
  </div>
  <div class="quiz-prog-wrap" aria-hidden="true">
    <div class="quiz-prog-track">
      <div class="quiz-prog-fill" id="qz-bar"></div>
    </div>
    <span class="quiz-prog-label"><span id="qz-step">1</span> / {questions.length}</span>
  </div>
  <div class="quiz-questions" id="qz-questions">
    {questions.map((q, i) => (
      <div class="quiz-q" data-qi={i}>
        <p class="quiz-q-text"><span class="quiz-q-num">{i + 1}.</span> {q.q}</p>
        <div class="quiz-opts" role="group" aria-label={`Options for question ${i + 1}`}>
          {q.options.map((opt, j) => (
            <button
              class="quiz-opt"
              data-qi={i}
              data-oi={j}
              data-correct={j === q.correct ? 'true' : 'false'}
              type="button"
            >
              <span class="quiz-opt-key">{KEYS[j]}</span>
              <span class="quiz-opt-text">{opt}</span>
            </button>
          ))}
        </div>
        <div class="quiz-exp" aria-live="polite">
          <span class="quiz-exp-icon">&#x2139;</span>
          <span>{q.explanation}</span>
        </div>
      </div>
    ))}
  </div>
  <div class="quiz-actions" id="qz-actions">
    <button class="quiz-next-btn" id="qz-next" disabled type="button">Next question &rarr;</button>
  </div>
  <div class="quiz-score-screen" id="qz-score" aria-hidden="true">
    <div class="quiz-score-ring">
      <span class="quiz-score-n" id="qz-score-n">0</span>
      <span class="quiz-score-of">/ {questions.length}</span>
    </div>
    <p class="quiz-score-msg" id="qz-score-msg"></p>
    <div class="quiz-score-btns" id="qz-score-btns">
      <button class="quiz-share-btn" id="qz-share" type="button">Share result</button>
      <button class="quiz-retry-btn" id="qz-retry" type="button">Try again</button>
    </div>
    <div class="quiz-share-to" id="qz-share-to">
      <span class="quiz-share-label">Share to</span>
      <div class="quiz-share-icons">
        <a class="quiz-si quiz-si-x" id="qz-sh-x" href="#" target="_blank" rel="noopener noreferrer" aria-label="Share on X">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.258 5.63 5.906-5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a class="quiz-si quiz-si-li" id="qz-sh-li" href="#" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" data-copy="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a class="quiz-si quiz-si-fb" id="qz-sh-fb" href="#" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" data-copy="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <button class="quiz-si quiz-si-link" id="qz-sh-link" type="button" aria-label="Share via link">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </button>
      </div>
      <p class="quiz-copy-hint" id="qz-copy-hint"></p>
    </div>
  </div>
</section>
<style is:global>
  .quiz-block {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-radius: 16px;
    padding: 1.75rem;
    margin: 2rem 0;
  }
  .quiz-eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(139, 92, 246, 0.9);
    margin-bottom: 0.35rem;
  }
  .quiz-title {
    margin-top: 0 !important;
  }
  .quiz-meta {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 1.25rem;
  }
  .quiz-prog-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .quiz-prog-track {
    flex: 1;
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
  }
  .quiz-prog-fill {
    height: 100%;
    background: linear-gradient(90deg, #7c3aed, #a78bfa);
    border-radius: 4px;
    width: 0%;
    transition: width 0.35s ease;
  }
  .quiz-prog-label {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }
  .quiz-q {
    display: none;
  }
  .quiz-q.active {
    display: block;
  }
  .quiz-q-num {
    color: rgba(139, 92, 246, 0.8);
    font-weight: 700;
    margin-right: 0.35em;
  }
  .quiz-q-text {
    font-size: 1rem;
    font-weight: 600;
    color: white;
    line-height: 1.55;
    margin: 0 0 1rem;
  }
  .quiz-opts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .quiz-opt {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .quiz-opt:hover:not(:disabled) {
    background: rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.4);
  }
  .quiz-opt-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    min-width: 22px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    font-size: 0.72rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 1px;
  }
  .quiz-opt-text {
    line-height: 1.45;
  }
  .quiz-opt.correct {
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.5);
    color: rgba(255, 255, 255, 0.95);
  }
  .quiz-opt.correct .quiz-opt-key {
    background: rgba(34, 197, 94, 0.35);
    color: #86efac;
  }
  .quiz-opt.wrong {
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.4);
    color: rgba(255, 255, 255, 0.7);
  }
  .quiz-opt.wrong .quiz-opt-key {
    background: rgba(239, 68, 68, 0.25);
    color: #fca5a5;
  }
  .quiz-opt:disabled {
    cursor: default;
  }
  .quiz-exp {
    display: none;
    align-items: flex-start;
    gap: 0.5rem;
    background: rgba(139, 92, 246, 0.1);
    border-left: 3px solid rgba(139, 92, 246, 0.5);
    border-radius: 0 8px 8px 0;
    padding: 0.65rem 0.9rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.55;
    margin-top: 0.5rem;
  }
  .quiz-exp.visible {
    display: flex;
  }
  .quiz-exp-icon {
    color: rgba(139, 92, 246, 0.8);
    font-style: normal;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .quiz-actions {
    margin-top: 1rem;
    display: flex;
    justify-content: flex-end;
  }
  .quiz-next-btn {
    padding: 0.6rem 1.25rem;
    background: rgba(139, 92, 246, 0.25);
    border: 1px solid rgba(139, 92, 246, 0.5);
    border-radius: 8px;
    color: white;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .quiz-next-btn:hover:not(:disabled) {
    background: rgba(139, 92, 246, 0.4);
  }
  .quiz-next-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .quiz-score-screen {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem 0 0.5rem;
  }
  .quiz-score-screen:not([aria-hidden="true"]) {
    display: flex;
  }
  .quiz-score-ring {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    margin-bottom: 0.75rem;
  }
  .quiz-score-n {
    font-size: 3.5rem;
    font-weight: 800;
    color: white;
    line-height: 1;
  }
  .quiz-score-of {
    font-size: 1.5rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
  }
  .quiz-score-msg {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 1.25rem;
    max-width: 360px;
  }
  .quiz-score-btns {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .quiz-share-btn {
    padding: 0.55rem 1.1rem;
    background: rgba(139, 92, 246, 0.3);
    border: 1px solid rgba(139, 92, 246, 0.55);
    border-radius: 8px;
    color: white;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .quiz-share-btn:hover {
    background: rgba(139, 92, 246, 0.45);
  }
  .quiz-retry-btn {
    padding: 0.55rem 1.1rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .quiz-retry-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .quiz-share-to {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .quiz-share-to.visible {
    display: flex;
  }
  .quiz-share-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.45);
  }
  .quiz-share-icons {
    display: flex;
    gap: 0.65rem;
  }
  .quiz-si {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: white;
    transition: transform 0.15s ease, opacity 0.15s ease;
    text-decoration: none;
  }
  .quiz-si:hover {
    transform: scale(1.1);
    opacity: 0.9;
  }
  .quiz-si-x    { background: #000; border: 1px solid rgba(255,255,255,0.2); }
  .quiz-si-li   { background: #0A66C2; }
  .quiz-si-fb   { background: #1877F2; }
  .quiz-si-link { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); }
  .quiz-copy-hint {
    font-size: 0.78rem;
    color: rgba(34, 197, 94, 0.9);
    margin: 0.1rem 0 0;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }
  .quiz-copy-hint.visible {
    opacity: 1;
  }
</style>

<script>
(function () {
  const block = document.getElementById('quiz');
  if (!block) return;

  const topic = (block as HTMLElement).dataset.topic ?? '';
  const pageUrl = (block as HTMLElement).dataset.pageUrl ?? window.location.href;
  const questionEls = block.querySelectorAll<HTMLElement>('.quiz-q');
  const total = questionEls.length;
  let current = 0;
  let score = 0;
  let answered = false;
  let quizStarted = false;

  const bar      = document.getElementById('qz-bar') as HTMLElement;
  const stepEl   = document.getElementById('qz-step') as HTMLElement;
  const nextBtn  = document.getElementById('qz-next') as HTMLButtonElement;
  const questionsWrap = document.getElementById('qz-questions') as HTMLElement;
  const actionsWrap   = document.getElementById('qz-actions') as HTMLElement;
  const scoreScreen   = document.getElementById('qz-score') as HTMLElement;
  const scoreNumEl    = document.getElementById('qz-score-n') as HTMLElement;
  const scoreMsgEl    = document.getElementById('qz-score-msg') as HTMLElement;
  const shareBtn      = document.getElementById('qz-share') as HTMLButtonElement;
  const retryBtn      = document.getElementById('qz-retry') as HTMLButtonElement;
  const scoreBtns     = document.getElementById('qz-score-btns') as HTMLElement;
  const shareTo       = document.getElementById('qz-share-to') as HTMLElement;
  const shX           = document.getElementById('qz-sh-x') as HTMLAnchorElement;
  const shLi          = document.getElementById('qz-sh-li') as HTMLAnchorElement;
  const shFb          = document.getElementById('qz-sh-fb') as HTMLAnchorElement;
  const shLink        = document.getElementById('qz-sh-link') as HTMLButtonElement;
  const copyHint      = document.getElementById('qz-copy-hint') as HTMLElement;
  let shareText = '';
  let hintTimer: ReturnType<typeof setTimeout>;

  const MSGS = [
    'Keep studying - the answers are all on this page.',
    "You're just getting started - read through the content above and try again.",
    'Not bad - review the formula and examples to go further.',
    'Good foundation - one more read and you could ace this.',
    `Almost an expert - strong ${topic} knowledge.`,
    `Perfect score! You know your ${topic} inside and out.`,
  ];

  function showQuestion(index: number) {
    questionEls.forEach((q, i) => q.classList.toggle('active', i === index));
    stepEl.textContent = String(index + 1);
    bar.style.width = ((index / total) * 100) + '%';
    nextBtn.disabled = true;
    nextBtn.textContent = index < total - 1 ? 'Next question →' : 'See results';
    answered = false;
  }

  function handleOption(e: Event) {
    if (answered) return;
    const btn = e.currentTarget as HTMLButtonElement;
    const qi = Number(btn.dataset.qi);
    if (qi !== current) return;

    answered = true;

    if (!quizStarted) {
      quizStarted = true;
      (window as any).dataLayer = (window as any).dataLayer || [];
      (window as any).dataLayer.push({
        event: 'quiz_started',
        quiz_topic: topic,
        page_path: window.location.pathname,
      });
    }

    const correct = btn.dataset.correct === 'true';
    if (correct) score++;

    const qDiv = questionEls[qi];
    qDiv.querySelectorAll<HTMLButtonElement>('.quiz-opt').forEach(opt => {
      opt.disabled = true;
      if (opt.dataset.correct === 'true') opt.classList.add('correct');
      else if (opt === btn) opt.classList.add('wrong');
    });

    const exp = qDiv.querySelector<HTMLElement>('.quiz-exp');
    if (exp) exp.classList.add('visible');

    nextBtn.disabled = false;
  }

  block.querySelectorAll('.quiz-opt').forEach(btn => btn.addEventListener('click', handleOption));

  nextBtn.addEventListener('click', () => {
    current++;
    if (current >= total) {
      showResult();
    } else {
      showQuestion(current);
    }
  });

  function showResult() {
    questionsWrap.style.display = 'none';
    actionsWrap.style.display = 'none';
    scoreScreen.removeAttribute('aria-hidden');
    scoreNumEl.textContent = String(score);
    scoreMsgEl.textContent = MSGS[score] ?? '';
    bar.style.width = '100%';
    stepEl.textContent = String(total);
  }

  shareBtn.addEventListener('click', () => {
    shareText = `I scored ${score}/5 on the ${topic} quiz on calculations.tools - can you beat me?`;
    const enc = encodeURIComponent;
    shX.href  = `https://twitter.com/intent/tweet?text=${enc(shareText)}&url=${enc(pageUrl)}`;
    shLi.href = `https://www.linkedin.com/sharing/share-offsite/?url=${enc(pageUrl)}`;
    shFb.href = `https://www.facebook.com/sharer/sharer.php?u=${enc(pageUrl)}`;
    scoreBtns.style.display = 'none';
    shareTo.classList.add('visible');
  });

  function showHint(msg: string) {
    copyHint.textContent = msg;
    copyHint.classList.add('visible');
    clearTimeout(hintTimer);
    hintTimer = setTimeout(() => copyHint.classList.remove('visible'), 2500);
  }

  [shLi, shFb].forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const href = (e.currentTarget as HTMLAnchorElement).href;
      navigator.clipboard.writeText(shareText).catch(() => {});
      showHint('Score text copied - paste it into your post');
      window.open(href, '_blank', 'noopener,noreferrer');
    });
  });

  shLink.addEventListener('click', () => {
    if (navigator.share) {
      navigator.share({ title: `${topic} quiz`, text: shareText, url: pageUrl }).catch(() => {});
    } else {
      navigator.clipboard.writeText(pageUrl).catch(() => {});
      showHint('Link copied!');
    }
  });

  retryBtn.addEventListener('click', () => {
    current = 0;
    score = 0;
    answered = false;
    questionEls.forEach(q => {
      q.classList.remove('active');
      q.querySelectorAll<HTMLButtonElement>('.quiz-opt').forEach(opt => {
        opt.disabled = false;
        opt.classList.remove('correct', 'wrong');
      });
      const exp = q.querySelector<HTMLElement>('.quiz-exp');
      if (exp) exp.classList.remove('visible');
    });
    questionsWrap.style.display = '';
    actionsWrap.style.display = '';
    scoreScreen.setAttribute('aria-hidden', 'true');
    scoreBtns.style.display = '';
    shareTo.classList.remove('visible');
    showQuestion(0);
  });

  showQuestion(0);
})();
</script>
