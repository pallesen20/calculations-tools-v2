import QuizBlock from '../../components/QuizBlock.astro';

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'explained-to-beginner', label: 'Height conversion explained to a beginner' },
  { id: 'cm-to-feet',      label: 'cm to feet and inches' },
  { id: 'feet-to-cm',      label: 'feet and inches to cm' },
  { id: 'height-formats',  label: 'Height formats explained' },
  { id: 'cm-spelling',     label: 'Centimetres vs centimeters' },
  { id: 'reference',       label: 'Common height reference table' },
  { id: 'common-mistakes', label: 'Common mistakes' },
  { id: 'faq',             label: 'FAQs' },
  { id: 'quiz',            label: 'Quiz: test your knowledge' },
  { id: 'related-tools',   label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'How many centimeters are in exactly one inch?',
    options: ['2.50 cm', '2.54 cm', '2.58 cm', '30.48 cm'] as [string, string, string, string],
    correct: 1 as const,
    explanation: '1 inch = exactly 2.54 cm, a fixed international standard defined in 1959. This is precise, not an approximation, so all inch-to-cm conversions are exact.',
  },
  {
    q: 'What is 180 cm converted to feet and inches?',
    options: ['5 ft 9.0 in', '5 ft 11.0 in', '5 ft 10.9 in', '6 ft 0.0 in'] as [string, string, string, string],
    correct: 2 as const,
    explanation: '180 / 2.54 = 70.866 total inches. That is 5 feet (60 in) plus 10.866 remaining inches, giving 5 ft 10.9 in.',
  },
  {
    q: 'What is the correct first step when converting 5 ft 11 in to centimeters?',
    options: ['Multiply 5.11 by 30.48', 'Multiply 5 by 2.54 and 11 by 2.54 separately', 'Convert to total inches: (5 x 12) + 11 = 71 inches', 'Divide 5.11 by 0.394'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'You must first convert to total inches: (5 x 12) + 11 = 71, then multiply by 2.54 to get 180.34 cm. Entering 5.11 as decimal feet gives a completely different result.',
  },
  {
    q: 'According to the reference table, which value in cm corresponds to exactly 6 feet 0 inches?',
    options: ['180.3 cm', '182.9 cm', '185.4 cm', '187.9 cm'] as [string, string, string, string],
    correct: 1 as const,
    explanation: '6 ft 0 in = 6 x 30.48 = 182.88 cm, shown as 182.9 cm in the table. Each foot is exactly 30.48 cm.',
  },
  {
    q: 'Someone types 5.11 into a decimal feet field. What height have they actually entered?',
    options: ['5 ft 11 in (180.34 cm)', '5 ft 1.32 in (155.8 cm)', '5 ft 10.9 in (180 cm)', '5 ft 5 in (165.1 cm)'] as [string, string, string, string],
    correct: 1 as const,
    explanation: '5.11 decimal feet means 5 feet and 0.11 x 12 = 1.32 inches, giving 155.8 cm. The page flags this as the most common height conversion error, producing a 24 cm gap from the intended 5 ft 11 in.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const schema = [
