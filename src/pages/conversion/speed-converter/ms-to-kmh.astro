---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';
import type { Source } from '../../../components/Sources.astro';
import QuizBlock from '../../../components/QuizBlock.astro';

const f = {
  msToKmh: "$$\\text{km/h} = \\text{m/s} \\times 3.6$$",
  kmhToMs: "$$\\text{m/s} = \\frac{\\text{km/h}}{3.6}$$",
  msToMph: "$$\\text{mph} = \\text{m/s} \\times 2.23694$$",
  msToFts: "$$\\text{ft/s} = \\text{m/s} \\times 3.28084$$",
  msToKn:  "$$\\text{kn} = \\text{m/s} \\times 1.94384$$",
};

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'formula',         label: 'How to convert m/s to km/h' },
  { id: 'reverse',         label: 'How to convert km/h to m/s' },
  { id: 'other-units',     label: 'm/s to mph, ft/s, and knots' },
  { id: 'reference-table', label: 'Speed reference table' },
  { id: 'when-to-use',     label: 'When you need this conversion' },
  { id: 'faq',             label: 'FAQs' },
  { id: 'quiz',            label: 'Quiz: test your knowledge' },
  { id: 'related-tools',   label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'What is the exact factor to convert meters per second (m/s) to kilometers per hour (km/h)?',
    options: ['3.6', '2.237', '1.944', '3.281'] as [string, string, string, string],
    correct: 0 as const,
    explanation: 'km/h = m/s × 3.6. The factor is exact because 1 hour = 3,600 seconds and 1 km = 1,000 meters, so 3,600 ÷ 1,000 = 3.6 with no rounding.',
  },
  {
    q: 'According to the reference table on this page, what is 10 m/s in ft/s?',
    options: ['22.4 ft/s', '19.4 ft/s', '32.8 ft/s', '36.0 ft/s'] as [string, string, string, string],
    correct: 2 as const,
    explanation: '10 m/s × 3.28084 = 32.81 ft/s. The factor comes from the international foot definition: 1 ft = 0.3048 m exactly, so 1 m = 3.28084 ft.',
  },
  {
    q: 'Why do physics equations use m/s rather than km/h?',
    options: ['m/s is easier to calculate mentally', 'km/h is not internationally recognized', 'Using km/h introduces a 3.6 factor into every equation for force, energy, and momentum', 'm/s is used on most road signs worldwide'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'm/s is the SI coherent derived unit. Force (newtons), energy (joules), and momentum (kg·m/s) are all defined with meters and seconds, so switching to km/h would require dividing by 3.6 in every calculation.',
  },
  {
    q: 'A car travels at the common EU motorway speed limit of 100 km/h. What is this in m/s?',
    options: ['25.0 m/s', '27.78 m/s', '33.33 m/s', '22.37 m/s'] as [string, string, string, string],
    correct: 1 as const,
    explanation: '100 km/h ÷ 3.6 = 27.778 m/s. This recurring decimal is exactly 250/9 m/s. The reference table on this page lists 27.78 m/s as the EU motorway speed equivalent.',
  },
  {
    q: 'From the reference table on this page, what real-world event corresponds to 17 m/s (61.2 km/h)?',
    options: ['Normal walking pace', 'Usain Bolt peak sprint speed', 'Beaufort Force 8 (gale)', 'High-speed train (TGV)'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'The reference table lists 17 m/s = 61.2 km/h = 38 mph as Beaufort Force 8 (gale). The NOAA NWS Beaufort scale defines a gale as 34-40 knots (39-46 mph), consistent with 17 m/s.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const sources: Source[] = [
  {
    author: 'Thompson, A. and Taylor, B.N.',
    title: 'NIST Guide to the SI, Appendix B.8: Factors for Units Listed Alphabetically',
    journal: 'NIST Special Publication 811',
    year: 2008,
    url: 'https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8',
