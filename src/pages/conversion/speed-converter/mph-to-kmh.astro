---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';

const f = {
  mphToKph: "$$\\text{km/h} = \\text{mph} \\times 1.609344$$",
  kphToMph: "$$\\text{mph} = \\frac{\\text{km/h}}{1.609344}$$",
};

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'formula',         label: 'How to convert mph to km/h' },
  { id: 'reverse',         label: 'How to convert km/h to mph' },
  { id: 'reference-table', label: 'mph to km/h reference table' },
  { id: 'when-to-use',     label: 'When you need this conversion' },
  { id: 'faq',             label: 'FAQs' },
  { id: 'related-tools',   label: 'Related tools' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "mph to km/h Converter",
    "url": "https://calculations.tools/conversion/speed-converter/mph-to-kmh",
    "description": "Convert miles per hour to kilometers per hour (km/h) instantly. Formula: km/h = mph × 1.609344. Includes reverse km/h to mph conversion and a full reference table.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to convert mph to km/h",
    "description": "Convert miles per hour to kilometers per hour using the exact international conversion factor.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter mph value", "text": "Type your miles per hour value in the mph field. The km/h result updates instantly." },
      { "@type": "HowToStep", "position": 2, "name": "Read the result", "text": "The converted km/h value appears immediately. For 60 mph, the result is 96.56 km/h." },
      { "@type": "HowToStep", "position": 3, "name": "Convert in reverse", "text": "Type in the km/h field to convert back to mph. The converter works in both directions." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many km/h is 60 mph?",
        "acceptedAnswer": { "@type": "Answer", "text": "60 mph equals 96.56 km/h. Multiply any mph value by 1.609344 to get the exact km/h equivalent. This factor is exact because one international mile equals 1,609.344 meters by definition since the International Yard and Pound Agreement of 1959." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between mph and km/h?",
        "acceptedAnswer": { "@type": "Answer", "text": "mph (miles per hour) measures speed in miles. km/h (kilometers per hour, also written kph or kmh) measures speed in kilometers. 1 mph = 1.609344 km/h. The US, UK, and Liberia use mph for road signs; every other country uses km/h. The same speed expressed in km/h will always be a larger number than in mph - for example, the 70 mph UK motorway limit is 112.65 km/h." }
      },
      {
        "@type": "Question",
        "name": "What is 100 km/h in mph?",
        "acceptedAnswer": { "@type": "Answer", "text": "100 km/h equals 62.14 mph. Divide any km/h value by 1.609344 to get mph. The common European motorway limit of 100 km/h is about 62 mph, below the UK motorway limit of 70 mph (112.65 km/h)." }
      },
      {
        "@type": "Question",
        "name": "Is 1 mph equal to 1.6 km/h?",
        "acceptedAnswer": { "@type": "Answer", "text": "Approximately, yes - but the exact factor is 1.609344, not 1.6. Using 1.6 introduces a 0.58% error. At 100 mph that gives 160 km/h instead of the correct 160.93 km/h. For casual use the shortcut is fine; for navigation or engineering, always use the full factor." }
      },
      {
        "@type": "Question",
        "name": "How do you mentally convert mph to km/h?",
        "acceptedAnswer": { "@type": "Answer", "text": "Multiply by 1.6 for a quick estimate (0.58% low), or multiply by 8 and divide by 5 for slightly better accuracy (error under 0.03%). For 60 mph: 60 × 8 = 480, ÷ 5 = 96 km/h. Exact answer: 96.56 km/h." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between kph, kmh, and km/h?",
        "acceptedAnswer": { "@type": "Answer", "text": "Nothing - kph, kmh, and km/h all mean the same thing: kilometers per hour. 'kph' follows the same pattern as 'mph'. 'kmh' squashes the unit together without a slash. 'km/h' is the official SI notation. All three are identical in meaning. If you search 'mph to kmh' or 'mph to kph' you need the same conversion: multiply mph by 1.609344." }
      }
    ]
  }
];
---
<CalculatorLayout
  title="mph to km/h Converter"
  metaTitle="mph to km/h Converter | Miles Per Hour to Kilometers/Hour"
  description="Convert mph to km/h (kph) instantly. Formula: km/h = mph × 1.609344. Reverse km/h to mph included. Reference table for road speeds from walking pace to 186 mph."
  canonical="https://calculations.tools/conversion/speed-converter/mph-to-kmh"
  tocItems={tocItems}
  embedSlug="mph-to-kmh"
  schema={schema}
  ogFormula="km/h = mph × 1.609344"
  ogExample="60 mph = 60 × 1.609344 = 96.56 km/h"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container">
        <div class="calculator-header">
          <h2>Instantly Convert mph to kph</h2>
          <p>Type in either field - converts instantly in both directions</p>
        </div>
        <div class="pair-inputs">
          <div class="pair-field">
            <label for="mk-a">Miles per hour (mph)</label>
            <input id="mk-a" type="text" inputmode="decimal" placeholder="e.g. 60" />
          </div>
          <div class="pair-eq">=</div>
          <div class="pair-field">
            <label for="mk-b">Kilometers per hour (km/h)</label>
            <input id="mk-b" type="text" inputmode="decimal" placeholder="e.g. 96.56" />
          </div>
        </div>
        <div class="pair-formula-note">1 mph = 1.609344 km/h &nbsp;·&nbsp; 1 km/h = 0.621371 mph</div>
      </div>
    </section>
    <script src="/js/mph-to-kmh.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>To convert mph to km/h (also written kph or kmh), multiply by <strong>1.609344</strong>. So 60 mph = 96.56 km/h. For the reverse, divide km/h by 1.609344. The factor is exact - one international mile is defined as exactly 1,609.344 meters since 1959.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>KMH = KPH = KM/H. All three mean kilometers per hour, just different abbreviations.</li>
          <li>Exact factor: 1 mph = 1.609344 km/h (international definition, locked in 1959).</li>
          <li>Quick mental check: multiply mph by 1.6 for a close estimate (0.58% low).</li>
          <li>Only 3 countries use mph for road speeds: US, UK, and Liberia (NIST, 2023).</li>
          <li>100 km/h (common European motorway limit) = 62.14 mph.</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use this mph to km/h converter</h2>
      <p>Type any value in the mph field and the km/h result appears instantly. You can also type in the km/h field to convert back to mph - the converter works in both directions without pressing a button.</p>
      <h2 id="formula">How do you convert mph to km/h?</h2>
      <p>Multiply miles per hour by 1.609344. This factor is exact: one international mile is defined as exactly 1,609.344 meters, agreed upon in the International Yard and Pound Agreement of 1959 (signed by the US, UK, Canada, Australia, New Zealand, and South Africa). There is no rounding - the conversion is perfectly precise.</p>
      <Formula expr={f.mphToKph} />
      <p>Worked examples: 30 mph = 48.28 km/h. 70 mph = 112.65 km/h. 100 mph = 160.93 km/h.</p>
      <p>Mental shortcut: multiply by 8 and divide by 5 (since 1.609344 ≈ 8/5). For 50 mph: 50 × 8 = 400, ÷ 5 = 80 km/h. Exact answer: 80.47 km/h - the 8/5 shortcut is within 0.03%.</p>
      <h2 id="reverse">How do you convert km/h to mph?</h2>
      <p>Divide km/h by 1.609344, or multiply by 0.621371. The <a href="/conversion/speed-converter">speed converter hub</a> handles all units simultaneously if you need more than just this pair. The reverse factor 0.621371 is the reciprocal of 1.609344 and is equally exact.</p>
      <Formula expr={f.kphToMph} />
      <p>Worked examples: 50 km/h = 31.07 mph. 100 km/h = 62.14 mph. 130 km/h = 80.78 mph.</p>
      <p>Mental shortcut: multiply km/h by 0.6 for a rough estimate (2.5% low). For 100 km/h: 100 × 0.6 = 60 mph (actual 62.14 mph). Better: halve the km/h and add 12%.</p>
      <h2 id="reference-table">mph to km/h reference table</h2>
      <p>Common speed values converted using the exact factor 1.609344, rounded to two decimal places.</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>mph</th><th>km/h</th><th>Common context</th></tr>
          </thead>
          <tbody>
            <tr><td>5 mph</td><td>8.05 km/h</td><td>Walking pace</td></tr>
            <tr><td>10 mph</td><td>16.09 km/h</td><td>Slow cycling</td></tr>
            <tr><td>20 mph</td><td>32.19 km/h</td><td>Residential speed limit (UK/US)</td></tr>
            <tr><td>25 mph</td><td>40.23 km/h</td><td>School zone (US)</td></tr>
            <tr><td>30 mph</td><td>48.28 km/h</td><td>Urban speed limit (UK)</td></tr>
            <tr><td>40 mph</td><td>64.37 km/h</td><td>Rural road (US)</td></tr>
            <tr><td>50 mph</td><td>80.47 km/h</td><td>Rural road (UK)</td></tr>
            <tr><td>55 mph</td><td>88.51 km/h</td><td>Highway (some US states)</td></tr>
            <tr><td>60 mph</td><td>96.56 km/h</td><td>Dual carriageway (UK)</td></tr>
            <tr><td>65 mph</td><td>104.61 km/h</td><td>Interstate (many US states)</td></tr>
            <tr><td>70 mph</td><td>112.65 km/h</td><td>Motorway limit (UK)</td></tr>
            <tr><td>80 mph</td><td>128.75 km/h</td><td>Unrestricted autobahn lower range</td></tr>
            <tr><td>100 mph</td><td>160.93 km/h</td><td>Track day / performance cars</td></tr>
            <tr><td>120 mph</td><td>193.12 km/h</td><td>High-performance sports car</td></tr>
            <tr><td>186 mph</td><td>299.33 km/h</td><td>Bugatti Veyron top speed (approx.)</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="when-to-use">When do you need to convert mph to km/h?</h2>
      <p>The mph/km/h split follows a clear geographic line. According to NIST (2023), only the US, UK, and Liberia still use mph for road speeds - every other country uses km/h. This creates daily conversion needs for travellers, drivers importing foreign vehicles, and anyone reading international car specifications.</p>
      <ul>
        <li><strong>Driving abroad</strong> - a UK or US driver in continental Europe needs to read km/h signs. A 130 km/h motorway limit is 80.8 mph.</li>
        <li><strong>Car specifications</strong> - European manufacturers publish top speed in km/h. A "250 km/h electronically limited" car reaches 155.3 mph.</li>
        <li><strong>Cycling and fitness</strong> - GPS devices often switch units by region; converting pace between mph and km/h is routine for athletes who travel.</li>
        <li><strong>Importing vehicles</strong> - speedometers may show mph on a km/h road network, requiring a mental offset on every reading.</li>
      </ul>
      <h2 id="faq">FAQs about converting mph to km/h</h2>
      <h3>What is the difference between mph and km/h?</h3>
      <p>mph (miles per hour) and km/h (kilometers per hour) measure the same thing - speed - but in different units. One mile = 1.609344 km, so 1 mph = 1.609344 km/h. A speed expressed in km/h is always a larger number than the same speed in mph. The 70 mph UK motorway limit is 112.65 km/h; the 130 km/h French motorway limit is 80.78 mph.</p>
      <p>km/h is also written kph or kmh - all three abbreviations are identical in meaning. "kph" follows the same pattern as "mph" (letters only), while "km/h" is the official SI notation. You'll see km/h on road signs and in engineering specs; kph and kmh are more common in everyday conversation.</p>
      <h3>How many km/h is 60 mph?</h3>
      <p>60 mph = 96.56 km/h. Multiply 60 by the exact factor 1.609344. This is roughly the speed of a car on a UK dual carriageway. The European equivalent limit is typically 100 km/h - about 4 km/h faster.</p>
      <h3>What is 100 km/h in mph?</h3>
      <p>100 km/h = 62.14 mph. This is the standard motorway limit across most of Europe. It's about 8 mph below the UK's 70 mph motorway limit and roughly the same as the US federal 60 mph benchmark.</p>
      <h3>Is 1 mph equal to 1.6 km/h?</h3>
      <p>Almost - the exact factor is 1.609344. Using 1.6 introduces a 0.58% error. At 100 mph that's 160 km/h instead of 160.93 km/h. For everyday use the difference is negligible; for navigation or engineering, always use the full factor.</p>
      <h3>What is the difference between kph, kmh, and km/h?</h3>
      <p>Nothing - they are the same unit with three different abbreviations. All mean "kilometers per hour." "kph" follows the pattern of "mph" (one letter per word). "kmh" squashes the full unit symbol together. The official SI notation is "km/h" with a slash. All three - kph, kmh, and km/h - refer to exactly the same measurement. If you search "mph to kmh" or "mph to kph" you need the same conversion: multiply mph by 1.609344.</p>
      <h3>Why do the US and UK still use mph?</h3>
      <p>Both countries adopted road speed systems before metric became the global standard. Changing every road sign, speedometer regulation, and law is expensive and politically difficult. The UK metricated most everyday measurements in 1965 but excluded road speeds. The US has never completed a formal metrication programme for consumer use.</p>
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">⚡</span>
          <div>
            <a href="/conversion/speed-converter">Speed Converter (all units)</a>
            <p>Convert between km/h, mph, m/s, knots, ft/s, and more simultaneously.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">⚡</span>
          <div>
            <a href="/conversion/speed-converter/knots-to-mph">Knots to mph Converter</a>
            <p>Convert between knots and mph - used in aviation, maritime navigation, and weather.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">⚡</span>
          <div>
            <a href="/conversion/speed-converter/ms-to-kmh">m/s to km/h Converter</a>
            <p>Convert meters per second to km/h - the standard physics-to-road-speed conversion.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">∶</span>
          <div>
            <a href="/math/ratio-calculator/unit-rate">Unit Rate Calculator</a>
            <p>Calculate speed as a unit rate from raw distance and time measurements.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">📏</span>
          <div>
            <a href="/conversion/length-converter">Length Converter</a>
            <p>Convert between miles, kilometers, nautical miles, feet, and more.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</CalculatorLayout>
<style is:global>
  .pair-inputs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: end; margin-bottom: 1rem; }
  .pair-field label { display: block; font-size: 0.8rem; color: rgba(255,255,255,0.7); margin-bottom: 0.35rem; }
  .pair-field input { width: 100%; padding: 0.6rem 0.75rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: white; font-size: 1rem; box-sizing: border-box; }
  .pair-eq { font-size: 1.5rem; color: rgba(255,255,255,0.5); padding-bottom: 0.35rem; }
  .pair-formula-note { text-align: center; font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 0.5rem; }
  @media (max-width: 480px) { .pair-inputs { grid-template-columns: 1fr; } .pair-eq { text-align: center; padding-bottom: 0; } }
</style>
