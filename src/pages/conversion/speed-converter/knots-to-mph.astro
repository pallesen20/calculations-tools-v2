const f = {
  knotsToMph: "$$\\text{mph} = \\text{knots} \\times \\frac{1852}{1609.344} \\approx \\text{knots} \\times 1.15078$$",
  mphToKnots: "$$\\text{knots} = \\frac{\\text{mph}}{1.15078}$$",
};

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'what-is-a-knot',  label: 'What is a knot (and kts)?' },
  { id: 'formula',         label: 'How to convert knots to mph' },
  { id: 'reverse',         label: 'How to convert mph to knots' },
  { id: 'reference-table', label: 'Knots to mph reference table' },
