const f = {
  usd:       "$$\\text{EUR/JPY} = \\text{(EUR/USD)} × \\text{(USD/JPY)}$$",
};

const tocItems = [
  { id: 'how-to-use',           label: 'How to use this converter' },
  { id: 'explained-to-beginner', label: 'Exchange rates explained simply' },
  { id: 'mid-market',           label: 'The mid-market rate' },
  { id: 'how-rates-work',       label: 'How exchange rates work' },
  { id: 'provider-comparison',  label: 'Comparing exchange providers' },
  { id: 'popular-pairs',        label: 'Popular currency pairs' },
  { id: 'all-pairs',            label: 'All currency pair converters' },
  { id: 'travelers',            label: 'Practical tips for travelers' },
  { id: 'common-mistakes',      label: 'Common mistakes' },
  { id: 'faq',                  label: 'FAQs' },
  { id: 'quiz',                 label: 'Quiz: test your knowledge' },
  { id: 'related-tools',        label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'What is the mid-market exchange rate?',
    options: [
      'The average of exchange rates across all major bank branches',
      'The midpoint between the bid (buy) and ask (sell) prices in the interbank market',
      'The rate offered to retail customers with a standard 2% markup included',
      'The European Central Bank\'s published daily reference rate',
    ] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'The mid-market rate is the midpoint between the bid and ask prices on the global forex market. Banks use it when trading with each other - no markup is added, which is why it differs from the retail rate any consumer actually gets.',
  },
  {
    q: 'A bank applies a 3% markup when converting 1,000 EUR. Approximately how much EUR value is lost to the markup?',
    options: [
      'About 10 EUR',
      'About 30 EUR',
      'About 50 EUR',
      'About 100 EUR',
    ] as [string, string, string, string],
    correct: 1 as const,
    explanation: '3% of 1,000 EUR is 30 EUR. The page describes this as equivalent to a 30-euro fee - just less visible because it is hidden inside the rate rather than charged as a line item.',
  },
  {
    q: 'Why does the US dollar typically act as an intermediary when converting between two non-USD currencies (e.g. EUR to JPY)?',
    options: [
      'International regulations require all FX trades to route through USD',
      'The USD is the only currency the ECB accepts for settlement',
      'USD pairs have the deepest liquidity and tightest spreads, making triangular routing cheaper than a standalone cross-rate book',
      'The dollar has the lowest exchange fees of any currency globally',
    ] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'According to the BIS 2022 Triennial Survey, the USD appears on one side of 88% of all global FX transactions. Because EUR/USD and USD/JPY both have extremely tight spreads, pricing EUR/JPY by multiplying the two USD legs is cheaper than maintaining a separate book. Any discrepancy is immediately arbitraged away.',
  },
  {
    q: 'According to the provider comparison table on this page, which option typically offers the lowest markup above mid-market for international transfers?',
    options: [
      'Bank wire transfer (2-5% markup)',
      'Airport exchange desk (8-12% markup)',
      'Fintech transfer services like Wise or Revolut (0.35-0.6% markup)',
      'Standard credit card abroad (1-2% plus foreign transaction fee)',
    ] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'The provider table shows fintech services have a typical markup of 0.35-0.6% on major pairs plus a small flat fee - the closest to mid-market of any listed option. Airport desks are the most expensive at 8-12% above mid-market.',
  },
  {
    q: 'When a card terminal abroad asks "Pay in USD?" instead of the local currency, what does the page recommend?',
    options: [
      'Pay in USD to lock in the current rate before it changes',
      'Pay in USD - it is more secure and easier to track in your statement',
      'Decline and pay in local currency - the merchant\'s DCC rate is typically 3-6% worse',
      'Ask the merchant to apply the mid-market rate before choosing',
    ] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'This is Dynamic Currency Conversion (DCC). The page warns that the DCC rate built into the "pay in home currency" prompt is consistently 3-6% worse than your card network\'s own rate. Paying in local currency saves 3-6% on that transaction - often 20-50 euros or dollars on a hotel or car rental.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const sources: Source[] = [
  {
    author: 'Bank for International Settlements',
    title: 'Triennial Central Bank Survey: Foreign exchange turnover in April 2022',
    journal: 'BIS',
    year: 2022,
    url: 'https://www.bis.org/statistics/rpfx22.htm',
  },
  {
    author: 'European Central Bank',
    title: 'Euro Foreign Exchange Reference Rates',
    journal: 'ECB',
    year: 2024,
    url: 'https://www.ecb.europa.eu/stats/policy_and_exchange_rates/euro_reference_exchange_rates/html/index.en.html',
  },
  {
    author: 'World Bank',
    title: 'Purchasing Power Parity Conversion Factor (GDP)',
    journal: 'World Bank Open Data',
    year: 2024,
    url: 'https://data.worldbank.org/indicator/PA.NUS.PPP',
