const TOP_INDEXED_PAIRS: [string, string][] = [
  ['USD','EUR'], ['EUR','USD'], ['USD','GBP'], ['GBP','USD'],
  ['USD','JPY'], ['JPY','USD'], ['USD','CAD'], ['CAD','USD'],
  ['USD','AUD'], ['AUD','USD'], ['USD','CHF'], ['CHF','USD'],
  ['USD','NZD'], ['NZD','USD'], ['USD','INR'], ['INR','USD'],
  ['USD','CNY'], ['CNY','USD'], ['USD','HKD'], ['HKD','USD'],
  ['USD','SGD'], ['SGD','USD'], ['USD','MXN'], ['MXN','USD'],
  ['USD','KRW'], ['KRW','USD'], ['EUR','GBP'], ['GBP','EUR'],
  ['EUR','JPY'], ['JPY','EUR'], ['EUR','CHF'], ['CHF','EUR'],
  ['EUR','CAD'], ['CAD','EUR'], ['EUR','AUD'], ['AUD','EUR'],
  ['GBP','JPY'], ['JPY','GBP'], ['GBP','AUD'], ['AUD','GBP'],
  ['GBP','INR'], ['INR','GBP'], ['GBP','CHF'], ['CHF','GBP'],
