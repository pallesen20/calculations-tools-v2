---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';

const f = {
  fwd: "$$\\text{ml} = \\text{cups} \\times 236.588$$",
  rev: "$$\\text{cups} = \\text{ml} \\div 236.588$$",
};

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'formula',         label: 'How to convert cups to ml' },
  { id: 'reverse',         label: 'How to convert ml to cups' },
  { id: 'reference-table', label: 'Cups to ml reference table' },
  { id: 'fractions',       label: 'Fractional cups in ml' },
  { id: 'faq',             label: 'FAQs' },
  { id: 'related-tools',   label: 'Related tools' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Cups to Milliliters Converter",
    "url": "https://calculations.tools/conversion/volume-converter/cup-to-ml",
    "description": "Convert US cups to milliliters for cooking and baking. 1 cup = 236.588 ml, 1/2 cup = 118.3 ml, 1/4 cup = 59.1 ml, 2 cups = 473.2 ml.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to convert cups to milliliters",
    "description": "Multiply the number of US cups by 236.588 to get milliliters.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter cup value", "text": "Type your cup value in the cups field. The ml result updates instantly. Use decimals for fractions: 0.5 for half a cup." },
      { "@type": "HowToStep", "position": 2, "name": "Read the result", "text": "The converted ml value appears immediately. For 1 cup, the result is 236.6 ml." },
      { "@type": "HowToStep", "position": 3, "name": "Convert in reverse", "text": "Type in the ml field to convert back to cups." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many ml is 1 cup?", "acceptedAnswer": { "@type": "Answer", "text": "1 US cup equals 236.588 ml (commonly rounded to 237 ml or 240 ml in recipes). The official US customary cup is exactly 236.588 ml." } },
      { "@type": "Question", "name": "How many ml is half a cup?", "acceptedAnswer": { "@type": "Answer", "text": "Half a cup (1/2 cup) equals 118.3 ml. Multiply 0.5 by 236.588: 0.5 × 236.588 = 118.3 ml." } },
      { "@type": "Question", "name": "How many ml is 1/4 cup?", "acceptedAnswer": { "@type": "Answer", "text": "1/4 cup equals 59.15 ml. Multiply 0.25 by 236.588: 0.25 × 236.588 = 59.15 ml." } },
      { "@type": "Question", "name": "How many cups is 250 ml?", "acceptedAnswer": { "@type": "Answer", "text": "250 ml equals 1.057 cups - just over 1 cup. Divide 250 by 236.588: 250 ÷ 236.588 = 1.057 cups." } }
    ]
  }
];
---
<CalculatorLayout
  title="Cups to Milliliters Converter"
  metaTitle="Cups to Milliliters Converter | Instantly convert cups to ml"
  description="Convert US cups to ml for cooking and baking. 1 cup = 236.6 ml, 1/2 cup = 118.3 ml, 1/4 cup = 59.1 ml, 1/3 cup = 78.9 ml. Full fractions table included."
  canonical="https://calculations.tools/conversion/volume-converter/cup-to-ml"
  tocItems={tocItems}
  embedSlug="cup-to-ml"
  schema={schema}
  ogFormula="ml = cups × 236.588"
  ogExample="1 cup = 236.6 ml"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container">
        <div class="calculator-header">
          <h2>Instantly Convert cups to mL</h2>
          <p>Type in either field - converts instantly in both directions</p>
        </div>
        <div class="pair-inputs">
          <div class="pair-field">
            <label for="lp-a">Cups</label>
            <input id="lp-a" type="text" inputmode="decimal" placeholder="e.g. 1" />
          </div>
          <div class="pair-eq">=</div>
          <div class="pair-field">
            <label for="lp-b">Milliliters (ml)</label>
            <input id="lp-b" type="text" inputmode="decimal" placeholder="e.g. 236.6" />
          </div>
        </div>
        <div class="pair-formula-note">1 cup = 236.588 ml &nbsp;·&nbsp; US customary cups</div>
      </div>
    </section>
    <script src="/js/cup-to-ml.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>To convert cups to milliliters, multiply by <strong>236.588</strong>. So 1 cup = 236.6 ml, 1/2 cup = 118.3 ml, and 1/4 cup = 59.1 ml. This converter uses the US customary cup (236.588 ml) - the standard for American recipes.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>Formula: ml = cups × 236.588. US cup = 236.588 ml (not 240 ml, though many recipes round up).</li>
          <li>1/4 cup = 59.1 ml. 1/3 cup = 78.9 ml. 1/2 cup = 118.3 ml. 3/4 cup = 177.4 ml.</li>
          <li>Metric recipes often call 250 ml "1 cup" - that's 1.057 US cups, a minor difference in practice.</li>
          <li>Reverse: cups = ml ÷ 236.588.</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use our cups to mL converter</h2>
      <p>Type any cup value in the cups field and the ml result appears instantly. Use decimals for fractions: type 0.5 for half a cup, 0.25 for a quarter cup, 0.333 for a third cup. Both directions work without pressing a button.</p>
      <h2 id="formula">How do you convert cups to ml?</h2>
      <p>Multiply the number of US cups by 236.588. The US customary cup is defined as exactly 8 US fluid ounces = 8 × 29.5735 ml = 236.588 ml. Many recipes round this to 240 ml for simplicity, which is accurate enough for most cooking.</p>
      <Formula expr={f.fwd} />
      <p>Worked examples: 1/4 cup = 59.1 ml. 1/3 cup = 78.9 ml. 1/2 cup = 118.3 ml. 3/4 cup = 177.4 ml. 1 cup = 236.6 ml. 1.5 cups = 354.9 ml. 2 cups = 473.2 ml.</p>
      <h2 id="reverse">How do you convert ml to cups?</h2>
      <p class="also-see">Divide milliliters by 236.588. See the dedicated <a href="/conversion/volume-converter/ml-to-cup">ml to cups converter</a> for a ml-first reference table.</p>
      <Formula expr={f.rev} />
      <p>Worked examples: 60 ml = 0.254 cups. 120 ml = 0.507 cups. 180 ml = 0.761 cups. 240 ml = 1.014 cups. 500 ml = 2.113 cups.</p>
      <h2 id="reference-table">Cups to milliliters reference table</h2>
      <p>Whole and mixed cup values converted to ml, covering common recipe quantities:</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Cups</th><th>Milliliters (ml)</th><th>Context</th></tr>
          </thead>
          <tbody>
            <tr><td>1/8 cup</td><td>29.57 ml</td><td>2 tablespoons</td></tr>
            <tr><td>1/4 cup</td><td>59.15 ml</td><td>4 tablespoons</td></tr>
            <tr><td>1/3 cup</td><td>78.86 ml</td><td>5 tbsp + 1 tsp</td></tr>
            <tr><td>1/2 cup</td><td>118.3 ml</td><td>8 tablespoons</td></tr>
            <tr><td>2/3 cup</td><td>157.7 ml</td><td>10 tbsp + 2 tsp</td></tr>
            <tr><td>3/4 cup</td><td>177.4 ml</td><td>12 tablespoons</td></tr>
            <tr><td>1 cup</td><td>236.6 ml</td><td>Standard US cup / 8 fl oz</td></tr>
            <tr><td>1.5 cups</td><td>354.9 ml</td><td>1 cup + 1/2 cup</td></tr>
            <tr><td>2 cups</td><td>473.2 ml</td><td>1 US pint</td></tr>
            <tr><td>3 cups</td><td>709.8 ml</td><td>Large mixing bowl amount</td></tr>
            <tr><td>4 cups</td><td>946.4 ml</td><td>1 quart</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="fractions">Common cup fractions in milliliters</h2>
      <p>Recipe cup fractions converted to exact ml values. Use these when measuring with a metric measuring jug:</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Cup fraction</th><th>Decimal</th><th>Exact ml</th><th>Rounded ml</th></tr>
          </thead>
          <tbody>
            <tr><td>1/8 cup</td><td>0.125</td><td>29.57 ml</td><td>30 ml</td></tr>
            <tr><td>1/4 cup</td><td>0.25</td><td>59.15 ml</td><td>60 ml</td></tr>
            <tr><td>1/3 cup</td><td>0.333</td><td>78.86 ml</td><td>79 ml</td></tr>
            <tr><td>1/2 cup</td><td>0.5</td><td>118.3 ml</td><td>118 ml</td></tr>
            <tr><td>2/3 cup</td><td>0.667</td><td>157.7 ml</td><td>158 ml</td></tr>
            <tr><td>3/4 cup</td><td>0.75</td><td>177.4 ml</td><td>177 ml</td></tr>
            <tr><td>1 cup</td><td>1.0</td><td>236.6 ml</td><td>237 ml</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="faq">FAQs about converting cups to ml</h2>
      <h3>How many ml is 1 cup?</h3>
      <p>1 US cup equals 236.588 ml. Many recipes round this to 240 ml or 250 ml for convenience. For baking, use 236.6 ml for precision. For cooking liquids, rounding to 240 ml is fine.</p>
      <h3>How many ml is half a cup?</h3>
      <p>Half a cup equals 118.3 ml. 0.5 × 236.588 = 118.3 ml. For most recipes, 118 ml or 120 ml is close enough.</p>
      <h3>How many ml is 1/4 cup?</h3>
      <p>1/4 cup equals 59.15 ml. 0.25 × 236.588 = 59.15 ml. This equals 4 tablespoons (4 × 14.79 ml = 59.1 ml).</p>
      <h3>How many cups is 250 ml?</h3>
      <p>250 ml equals 1.057 US cups - just over 1 cup. Many metric recipes treat 250 ml as "1 cup" - this is close enough for most cooking purposes.</p>
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/ml-to-cup">Milliliters to Cups</a>
            <p>Reverse conversion - enter ml and get cups instantly.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/cup-to-fl-oz">Cups to Fluid Ounces</a>
            <p>Convert cups to fl oz - 1 cup = 8 fl oz.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/tbsp-to-ml">Tablespoons to Milliliters</a>
            <p>Convert tablespoons to ml - 1 tbsp = 14.79 ml.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter">Volume Converter (all units)</a>
            <p>Convert between all volume units - ml, L, fl oz, cups, gallons, and more.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</CalculatorLayout>
<style is:global>
  .pair-inputs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: end; margin-bottom: 1rem; }
  .pair-field label { display: block; font-size: 0.8rem; color: rgba(255,255,255,0.7); margin-bottom: 0.35rem; }
  .pair-field input { width: 100%; padding: 0.6rem 0.75rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: white; font-size: 1rem; box-sizing: border-box; }
  .pair-eq { font-size: 1.5rem; color: rgba(255,255,255,0.5); padding-bottom: 0.35rem; }
  .pair-formula-note { text-align: center; font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 0.5rem; }
  @media (max-width: 480px) { .pair-inputs { grid-template-columns: 1fr; } .pair-eq { text-align: center; padding-bottom: 0; } }
</style>