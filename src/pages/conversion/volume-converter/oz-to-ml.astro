---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';

const f = {
  fwd: "$$\\text{ml} = \\text{oz} \\times 29.5735$$",
  rev: "$$\\text{oz} = \\text{ml} \\times 0.033814$$",
};

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'formula',         label: 'How to convert oz to ml' },
  { id: 'reverse',         label: 'How to convert ml to oz' },
  { id: 'reference-table', label: 'oz to ml reference table' },
  { id: 'faq',             label: 'FAQs' },
  { id: 'related-tools',   label: 'Related tools' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Ounces to Milliliters Converter",
    "url": "https://calculations.tools/conversion/volume-converter/oz-to-ml",
    "description": "Convert fluid ounces (oz) to milliliters instantly. Formula: ml = oz × 29.5735. 1 oz = 29.57 ml, 8 oz = 236.6 ml, 16 oz = 473.2 ml.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to convert oz to ml",
    "description": "Multiply fluid ounces by 29.5735 to get milliliters.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter oz value", "text": "Type your oz value in the oz field. The ml result updates instantly." },
      { "@type": "HowToStep", "position": 2, "name": "Read the result", "text": "The converted ml value appears immediately. For 8 oz, the result is 236.6 ml." },
      { "@type": "HowToStep", "position": 3, "name": "Convert in reverse", "text": "Type in the ml field to convert back to oz." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many ml is 1 oz?", "acceptedAnswer": { "@type": "Answer", "text": "1 fluid oz equals 29.5735 ml. Multiply 1 by 29.5735: 1 × 29.5735 = 29.57 ml. This is the US fluid ounce definition." } },
      { "@type": "Question", "name": "How many ml is 8 oz?", "acceptedAnswer": { "@type": "Answer", "text": "8 oz equals 236.6 ml. Multiply 8 by 29.5735: 8 × 29.5735 = 236.6 ml. This equals 1 US cup." } },
      { "@type": "Question", "name": "How many ml is 16 oz?", "acceptedAnswer": { "@type": "Answer", "text": "16 oz equals 473.2 ml. Multiply 16 by 29.5735: 16 × 29.5735 = 473.2 ml. This equals 1 US pint." } },
      { "@type": "Question", "name": "How many oz is 500 ml?", "acceptedAnswer": { "@type": "Answer", "text": "500 ml equals 16.91 oz. Multiply 500 by 0.033814: 500 × 0.033814 = 16.91 fl oz." } }
    ]
  }
];
---
<CalculatorLayout
  title="Ounces to Milliliters Converter"
  metaTitle="Ounces to Milliliters Converter | Instantly convert oz to ml"
  description="Convert fluid ounces (oz) to milliliters instantly. 1 oz = 29.57 ml, 8 oz = 236.6 ml, 16 oz = 473 ml. Enter oz or ml - converts both directions."
  canonical="https://calculations.tools/conversion/volume-converter/oz-to-ml"
  tocItems={tocItems}
  embedSlug="oz-to-ml"
  schema={schema}
  ogFormula="ml = oz × 29.5735"
  ogExample="8 oz = 236.6 ml"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container">
        <div class="calculator-header">
          <h2>Instantly convert oz to ml</h2>
          <p>Type in either field - converts instantly in both directions</p>
        </div>
        <div class="pair-inputs">
          <div class="pair-field">
            <label for="lp-a">Ounces (oz)</label>
            <input id="lp-a" type="text" inputmode="decimal" placeholder="e.g. 8" />
          </div>
          <div class="pair-eq">=</div>
          <div class="pair-field">
            <label for="lp-b">Milliliters (ml)</label>
            <input id="lp-b" type="text" inputmode="decimal" placeholder="e.g. 236.6" />
          </div>
        </div>
        <div class="pair-formula-note">1 oz = 29.5735 ml &nbsp;·&nbsp; 1 ml = 0.033814 oz &nbsp;·&nbsp; US fluid ounces</div>
      </div>
    </section>
    <script src="/js/oz-to-ml.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>To convert fluid ounces (oz) to milliliters, multiply by <strong>29.5735</strong>. So 1 oz = 29.57 ml, 8 oz = 236.6 ml, and 16 oz = 473.2 ml. "Oz" in liquid recipes means fluid ounce - 1 US fl oz = 29.5735 ml exactly.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>Formula: ml = oz × 29.5735. Quick mental anchor: 1 oz is about 30 ml.</li>
          <li>8 oz = 236.6 ml = 1 cup. 12 oz = 355 ml (standard can). 16 oz = 473 ml = 1 pint.</li>
          <li>In liquids, "oz" means fluid ounce. Dry ounce (weight) is a different unit entirely.</li>
          <li>US fl oz (29.57 ml) vs UK fl oz (28.41 ml) - this converter uses US.</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use our oz to ml converter</h2>
      <p>Type any oz value in the oz field and the ml result appears instantly. You can also type in the ml field to convert back to oz - both directions work without pressing a button.</p>
      <h2 id="formula">How do you convert oz to ml?</h2>
      <p>Multiply the number of fluid ounces by 29.5735. This is the exact US customary definition: 1 US fl oz = 29.5735 ml. When you see "oz" in a beverage or liquid recipe, it always means fluid ounce, not the weight unit.</p>
      <Formula expr={f.fwd} />
      <p>Worked examples: 1 oz = 29.57 ml. 2 oz = 59.15 ml. 4 oz = 118.3 ml. 8 oz = 236.6 ml. 12 oz = 354.9 ml. 16 oz = 473.2 ml. 32 oz = 946.4 ml.</p>
      <h2 id="reverse">How do you convert ml to oz?</h2>
      <p class="also-see">Multiply milliliters by 0.033814. See the dedicated <a href="/conversion/volume-converter/ml-to-oz">ml to oz converter</a> for a ml-first reference table.</p>
      <Formula expr={f.rev} />
      <p>Worked examples: 100 ml = 3.38 oz. 250 ml = 8.45 oz. 500 ml = 16.91 oz. 1,000 ml = 33.81 oz.</p>
      <h2 id="reference-table">Ounces to milliliters reference table</h2>
      <p>Standard oz values converted to ml, covering common beverage sizes and recipe measurements:</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Ounces (oz)</th><th>Milliliters (ml)</th><th>Context</th></tr>
          </thead>
          <tbody>
            <tr><td>1 oz</td><td>29.57 ml</td><td>Shot glass</td></tr>
            <tr><td>2 oz</td><td>59.15 ml</td><td>Double shot / small measure</td></tr>
            <tr><td>4 oz</td><td>118.3 ml</td><td>Half cup / small glass</td></tr>
            <tr><td>6 oz</td><td>177.4 ml</td><td>Small coffee / juice</td></tr>
            <tr><td>8 oz</td><td>236.6 ml</td><td>1 cup</td></tr>
            <tr><td>10 oz</td><td>295.7 ml</td><td>Large glass</td></tr>
            <tr><td>12 oz</td><td>354.9 ml</td><td>Standard can (soda, beer)</td></tr>
            <tr><td>16 oz</td><td>473.2 ml</td><td>1 pint</td></tr>
            <tr><td>20 oz</td><td>591.5 ml</td><td>Large fountain drink</td></tr>
            <tr><td>32 oz</td><td>946.4 ml</td><td>Large Nalgene / quart</td></tr>
            <tr><td>64 oz</td><td>1,892.7 ml</td><td>Half gallon</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="faq">FAQs about converting oz to ml</h2>
      <h3>How many ml is 1 oz?</h3>
      <p>1 US fluid ounce equals 29.5735 ml. Quick reference: 1 oz is about 30 ml. For the TSA travel limit: 3.4 oz = 100 ml.</p>
      <h3>How many ml is 8 oz?</h3>
      <p>8 oz equals 236.6 ml. 8 × 29.5735 = 236.6 ml. This is 1 US cup - the standard measuring cup size used in American recipes.</p>
      <h3>How many ml is 16 oz?</h3>
      <p>16 oz equals 473.2 ml. 16 × 29.5735 = 473.2 ml. This is 1 US pint - a common beer glass size and standard large bottle.</p>
      <h3>How many oz is 500 ml?</h3>
      <p>500 ml equals 16.91 oz. 500 × 0.033814 = 16.91 oz. A standard 500 ml water bottle is about 16.9 fl oz.</p>
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/ml-to-oz">Milliliters to Ounces</a>
            <p>Reverse conversion - enter ml and get oz instantly.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/fl-oz-to-ml">Fluid Ounces to ml (fl oz label)</a>
            <p>Same conversion with fl oz labeling - for recipes that use "fl oz" notation.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/oz-to-ml">Ounces to Cups</a>
            <p>Convert oz to cups for US baking recipes.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter">Volume Converter (all units)</a>
            <p>Convert between all volume units - ml, L, fl oz, cups, gallons, and more.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</CalculatorLayout>
<style is:global>
  .pair-inputs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: end; margin-bottom: 1rem; }
  .pair-field label { display: block; font-size: 0.8rem; color: rgba(255,255,255,0.7); margin-bottom: 0.35rem; }
  .pair-field input { width: 100%; padding: 0.6rem 0.75rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: white; font-size: 1rem; box-sizing: border-box; }
  .pair-eq { font-size: 1.5rem; color: rgba(255,255,255,0.5); padding-bottom: 0.35rem; }
  .pair-formula-note { text-align: center; font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 0.5rem; }
  @media (max-width: 480px) { .pair-inputs { grid-template-columns: 1fr; } .pair-eq { text-align: center; padding-bottom: 0; } }
</style>