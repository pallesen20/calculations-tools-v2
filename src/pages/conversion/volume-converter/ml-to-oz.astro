---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';

const f = {
  fwd: "$$\\text{oz} = \\text{ml} \\times 0.033814$$",
  rev: "$$\\text{ml} = \\text{oz} \\times 29.5735$$",
};

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'formula',         label: 'How to convert ml to oz' },
  { id: 'reverse',         label: 'How to convert oz to ml' },
  { id: 'reference-table', label: 'ml to oz reference table' },
  { id: 'faq',             label: 'FAQs' },
  { id: 'related-tools',   label: 'Related tools' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Milliliters to Ounces Converter",
    "url": "https://calculations.tools/conversion/volume-converter/ml-to-oz",
    "description": "Convert milliliters to fluid ounces (oz) instantly. Formula: oz = ml × 0.033814. 100 ml = 3.38 oz, 250 ml = 8.45 oz, 500 ml = 16.91 oz.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to convert milliliters to ounces",
    "description": "Multiply ml by 0.033814 to get US fluid ounces.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter ml value", "text": "Type your milliliter value in the ml field. The oz result updates instantly." },
      { "@type": "HowToStep", "position": 2, "name": "Read the result", "text": "The converted oz value appears immediately. For 500 ml, the result is 16.91 oz." },
      { "@type": "HowToStep", "position": 3, "name": "Convert in reverse", "text": "Type in the oz field to convert back to ml." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many oz is 100 ml?", "acceptedAnswer": { "@type": "Answer", "text": "100 ml equals 3.38 oz. Multiply 100 by 0.033814: 100 × 0.033814 = 3.38 oz. This is just under the TSA limit of 3.4 oz." } },
      { "@type": "Question", "name": "How many oz is 250 ml?", "acceptedAnswer": { "@type": "Answer", "text": "250 ml equals 8.45 oz. Multiply 250 by 0.033814: 250 × 0.033814 = 8.454 oz." } },
      { "@type": "Question", "name": "How many oz is 500 ml?", "acceptedAnswer": { "@type": "Answer", "text": "500 ml equals 16.91 oz. Multiply 500 by 0.033814: 500 × 0.033814 = 16.91 oz. A 500 ml water bottle is about 16.9 fl oz." } },
      { "@type": "Question", "name": "How many oz is 1 liter?", "acceptedAnswer": { "@type": "Answer", "text": "1 liter (1,000 ml) equals 33.81 oz. Multiply 1,000 by 0.033814: 1,000 × 0.033814 = 33.81 oz." } }
    ]
  }
];
---
<CalculatorLayout
  title="Milliliters to Ounces Converter"
  metaTitle="Milliliters to Ounces Converter | Instantly convert ml to oz"
  description="Convert milliliters to fluid ounces (oz) instantly. 100 ml = 3.38 oz, 250 ml = 8.45 oz, 500 ml = 16.91 oz, 1000 ml = 33.81 oz. Enter ml or oz."
  canonical="https://calculations.tools/conversion/volume-converter/ml-to-oz"
  tocItems={tocItems}
  embedSlug="ml-to-oz"
  schema={schema}
  ogFormula="oz = ml × 0.033814"
  ogExample="500 ml = 16.91 oz"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container">
        <div class="calculator-header">
          <h2>Instantly convert ml to oz</h2>
          <p>Type in either field - converts instantly in both directions</p>
        </div>
        <div class="pair-inputs">
          <div class="pair-field">
            <label for="lp-a">Milliliters (ml)</label>
            <input id="lp-a" type="text" inputmode="decimal" placeholder="e.g. 500" />
          </div>
          <div class="pair-eq">=</div>
          <div class="pair-field">
            <label for="lp-b">Ounces (oz)</label>
            <input id="lp-b" type="text" inputmode="decimal" placeholder="e.g. 16.91" />
          </div>
        </div>
        <div class="pair-formula-note">1 oz = 29.5735 ml &nbsp;·&nbsp; 1 ml = 0.033814 oz &nbsp;·&nbsp; US fluid ounces</div>
      </div>
    </section>
    <script src="/js/ml-to-oz.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>To convert milliliters to ounces, multiply by <strong>0.033814</strong>. So 100 ml = 3.38 oz, 250 ml = 8.45 oz, and 500 ml = 16.91 oz. "Oz" here means fluid ounce (<a href="/conversion/volume-converter">volume</a>), not weight. 1 US fluid oz = 29.5735 ml.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>Formula: oz = ml × 0.033814. Quick mental anchor: 30 ml is about 1 oz.</li>
          <li>100 ml = 3.38 oz (just under the 3.4 oz TSA travel limit).</li>
          <li>250 ml = 8.45 oz. 500 ml = 16.91 oz. 1,000 ml = 33.81 oz.</li>
          <li>Reverse: ml = oz × 29.5735.</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use our ml to oz converter</h2>
      <p>Type any ml value in the ml field and the oz result appears instantly. You can also type in the oz field to convert back to ml - both directions work without pressing a button.</p>
      <h2 id="formula">How do you convert ml to oz?</h2>
      <p>Multiply the number of milliliters by 0.033814. This factor is 1 divided by 29.5735 (the ml equivalent of 1 US fl oz). It converts metric volume directly to US customary volume.</p>
      <Formula expr={f.fwd} />
      <p>Worked examples: 30 ml = 1.01 oz. 100 ml = 3.38 oz. 150 ml = 5.07 oz. 250 ml = 8.45 oz. 355 ml = 12.0 oz. 500 ml = 16.91 oz. 750 ml = 25.36 oz. 1,000 ml = 33.81 oz.</p>
      <h2 id="reverse">How do you convert oz to ml?</h2>
      <p class="also-see">Multiply oz by 29.5735. See the dedicated <a href="/conversion/volume-converter/oz-to-ml">oz to ml converter</a> for an oz-first reference table.</p>
      <Formula expr={f.rev} />
      <p>Worked examples: 1 oz = 29.57 ml. 8 oz = 236.6 ml. 12 oz = 354.9 ml. 16 oz = 473.2 ml.</p>
      <h2 id="reference-table">Milliliters to ounces reference table</h2>
      <p>Common ml values converted to oz, with everyday reference points:</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Milliliters (ml)</th><th>Ounces (oz)</th><th>Context</th></tr>
          </thead>
          <tbody>
            <tr><td>30 ml</td><td>1.01 oz</td><td>Shot glass</td></tr>
            <tr><td>50 ml</td><td>1.69 oz</td><td>Miniature bottle</td></tr>
            <tr><td>100 ml</td><td>3.38 oz</td><td>TSA travel limit</td></tr>
            <tr><td>150 ml</td><td>5.07 oz</td><td>Small juice glass</td></tr>
            <tr><td>200 ml</td><td>6.76 oz</td><td>Small can / glass</td></tr>
            <tr><td>250 ml</td><td>8.45 oz</td><td>Standard glass</td></tr>
            <tr><td>330 ml</td><td>11.15 oz</td><td>European can</td></tr>
            <tr><td>355 ml</td><td>12.00 oz</td><td>US standard can</td></tr>
            <tr><td>500 ml</td><td>16.91 oz</td><td>Standard water bottle</td></tr>
            <tr><td>750 ml</td><td>25.36 oz</td><td>Wine bottle</td></tr>
            <tr><td>1,000 ml</td><td>33.81 oz</td><td>1 liter bottle</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="faq">Frequently asked questions about ml to oz</h2>
      <h3>How many oz is 100 ml?</h3>
      <p>100 ml equals 3.38 oz. This is just under the TSA's 3.4 oz carry-on limit for liquids. 100 ml containers technically comply with the rule.</p>
      <h3>How many oz is 250 ml?</h3>
      <p>250 ml equals 8.45 oz. A standard drinking glass holds about 250 ml or roughly 8.5 fl oz.</p>
      <h3>How many oz is 500 ml?</h3>
      <p>500 ml equals 16.91 oz. A standard 500 ml water bottle is labeled as 16.9 fl oz on US packaging.</p>
      <h3>How many oz is 1 liter?</h3>
      <p>1 liter (1,000 ml) equals 33.81 oz. 1,000 × 0.033814 = 33.81 oz. A 1 L bottle contains about 33.8 fl oz.</p>
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/oz-to-ml">Ounces to Milliliters</a>
            <p>Reverse conversion - enter oz and get ml instantly.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/ml-to-fl-oz">Milliliters to Fluid Ounces (fl oz label)</a>
            <p>Same conversion with fl oz labeling - for recipes using "fl oz" notation.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/ml-to-l">Milliliters to Liters</a>
            <p>Convert ml to liters for larger volume comparisons.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter">Volume Converter (all units)</a>
            <p>Convert between all volume units - ml, L, fl oz, cups, gallons, and more.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</CalculatorLayout>
<style is:global>
  .pair-inputs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: end; margin-bottom: 1rem; }
  .pair-field label { display: block; font-size: 0.8rem; color: rgba(255,255,255,0.7); margin-bottom: 0.35rem; }
  .pair-field input { width: 100%; padding: 0.6rem 0.75rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: white; font-size: 1rem; box-sizing: border-box; }
  .pair-eq { font-size: 1.5rem; color: rgba(255,255,255,0.5); padding-bottom: 0.35rem; }
  .pair-formula-note { text-align: center; font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 0.5rem; }
  @media (max-width: 480px) { .pair-inputs { grid-template-columns: 1fr; } .pair-eq { text-align: center; padding-bottom: 0; } }
</style>