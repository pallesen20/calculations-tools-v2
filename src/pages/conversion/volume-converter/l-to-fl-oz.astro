---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';

const f = {
  fwd: "$$\\text{fl oz} = \\text{L} \\times 33.814$$",
  rev: "$$\\text{L} = \\text{fl oz} \\div 33.814$$",
};

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'formula',         label: 'How to convert liters to fl oz' },
  { id: 'reverse',         label: 'How to convert fl oz to liters' },
  { id: 'reference-table', label: 'Liters to fl oz reference table' },
  { id: 'faq',             label: 'FAQs' },
  { id: 'related-tools',   label: 'Related tools' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Liters to Fluid Ounces Converter",
    "url": "https://calculations.tools/conversion/volume-converter/l-to-fl-oz",
    "description": "Convert liters to US fluid ounces instantly. Formula: fl oz = L × 33.814. 1 L = 33.81 fl oz, 0.5 L = 16.91 fl oz, 2 L = 67.63 fl oz.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to convert liters to fluid ounces",
    "description": "Multiply liters by 33.814 to get US fluid ounces.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter liter value", "text": "Type your liter value in the L field. The fl oz result updates instantly." },
      { "@type": "HowToStep", "position": 2, "name": "Read the result", "text": "The converted fl oz value appears immediately. For 1 L, the result is 33.81 fl oz." },
      { "@type": "HowToStep", "position": 3, "name": "Convert in reverse", "text": "Type in the fl oz field to convert back to liters." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many fl oz is 1 liter?", "acceptedAnswer": { "@type": "Answer", "text": "1 liter equals 33.814 US fluid ounces. Multiply 1 by 33.814: 1 × 33.814 = 33.81 fl oz." } },
      { "@type": "Question", "name": "How many fl oz is 2 liters?", "acceptedAnswer": { "@type": "Answer", "text": "2 liters equals 67.628 US fluid ounces. Multiply 2 by 33.814: 2 × 33.814 = 67.63 fl oz." } },
      { "@type": "Question", "name": "How many fl oz is 0.5 liters?", "acceptedAnswer": { "@type": "Answer", "text": "0.5 liters equals 16.907 US fluid ounces. Multiply 0.5 by 33.814: 0.5 × 33.814 = 16.91 fl oz." } },
      { "@type": "Question", "name": "How many liters is 32 fl oz?", "acceptedAnswer": { "@type": "Answer", "text": "32 US fluid ounces equals 0.946 liters. Divide 32 by 33.814: 32 ÷ 33.814 = 0.946 L." } }
    ]
  }
];
---
<CalculatorLayout
  title="Liters to Fluid Ounces Converter"
  metaTitle="Liters to Fluid Ounces Converter | Convert L to fl oz"
  description="Convert liters to US fluid ounces instantly. 1 L = 33.81 fl oz, 0.5 L = 16.91 fl oz, 2 L = 67.63 fl oz. Enter liters or fl oz - converts both directions."
  canonical="https://calculations.tools/conversion/volume-converter/l-to-fl-oz"
  tocItems={tocItems}
  embedSlug="l-to-fl-oz"
  schema={schema}
  ogFormula="fl oz = L × 33.814"
  ogExample="1 L = 33.81 fl oz"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container">
        <div class="calculator-header">
          <h2>Instantly Convert L to fl oz</h2>
          <p>Type in either field - converts instantly in both directions</p>
        </div>
        <div class="pair-inputs">
          <div class="pair-field">
            <label for="lp-a">Liters (L)</label>
            <input id="lp-a" type="text" inputmode="decimal" placeholder="e.g. 1" />
          </div>
          <div class="pair-eq">=</div>
          <div class="pair-field">
            <label for="lp-b">Fluid Ounces (fl oz)</label>
            <input id="lp-b" type="text" inputmode="decimal" placeholder="e.g. 33.81" />
          </div>
        </div>
        <div class="pair-formula-note">1 L = 33.814 fl oz &nbsp;·&nbsp; US fluid ounces</div>
      </div>
    </section>
    <script src="/js/l-to-fl-oz.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>To convert liters to US fluid ounces, multiply by <strong>33.814</strong>. So 1 L = 33.81 fl oz, 0.5 L = 16.91 fl oz, and 2 L = 67.63 fl oz. Quick mental check: 1 liter is a bit under 34 fl oz.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>Formula: fl oz = L × 33.814. Quick estimate: 1 liter ≈ 34 fl oz.</li>
          <li>0.5 L = 16.91 fl oz. 1 L = 33.81 fl oz. 2 L = 67.63 fl oz.</li>
          <li>Standard US can (12 fl oz) = 0.355 L. 32 fl oz = about 0.946 L (nearly 1 L).</li>
          <li>Reverse: L = fl oz ÷ 33.814.</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use our L to fl oz converter</h2>
      <p>Type any liter value in the L field and the fl oz result appears instantly. You can also type in the fl oz field to convert back to liters - both directions work without pressing a button.</p>
      <h2 id="formula">How do you convert liters to fluid ounces?</h2>
      <p>Multiply the number of liters by 33.814. This factor comes from the exact definition: 1 L = 1,000 ml and 1 US fl oz = 29.5735 ml, so 1 L = 1,000 / 29.5735 = 33.814 fl oz.</p>
      <Formula expr={f.fwd} />
      <p>Worked examples: 0.25 L = 8.45 fl oz. 0.33 L = 11.16 fl oz. 0.5 L = 16.91 fl oz. 0.75 L = 25.36 fl oz. 1 L = 33.81 fl oz. 1.5 L = 50.72 fl oz. 2 L = 67.63 fl oz.</p>
      <h2 id="reverse">How do you convert fl oz to liters?</h2>
      <p class="also-see">Divide fl oz by 33.814 (or multiply by 0.0295735). See the dedicated <a href="/conversion/volume-converter/fl-oz-to-l">fl oz to liters converter</a> for an fl oz-first reference table.</p>
      <Formula expr={f.rev} />
      <p>Worked examples: 8 fl oz = 0.237 L. 16 fl oz = 0.473 L. 32 fl oz = 0.946 L. 64 fl oz = 1.893 L.</p>
      <h2 id="reference-table">Liters to fluid ounces reference table</h2>
      <p>Common bottle and container sizes converted from liters to US fluid ounces:</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Liters (L)</th><th>Fluid Ounces (fl oz)</th><th>Context</th></tr>
          </thead>
          <tbody>
            <tr><td>0.1 L</td><td>3.38 fl oz</td><td>Travel bottle (100 ml)</td></tr>
            <tr><td>0.25 L</td><td>8.45 fl oz</td><td>Cup / 250 ml bottle</td></tr>
            <tr><td>0.33 L</td><td>11.16 fl oz</td><td>European 330 ml can</td></tr>
            <tr><td>0.355 L</td><td>12.00 fl oz</td><td>US standard can</td></tr>
            <tr><td>0.5 L</td><td>16.91 fl oz</td><td>500 ml water bottle</td></tr>
            <tr><td>0.75 L</td><td>25.36 fl oz</td><td>Wine bottle</td></tr>
            <tr><td>1 L</td><td>33.81 fl oz</td><td>1-liter bottle</td></tr>
            <tr><td>1.5 L</td><td>50.72 fl oz</td><td>Large water bottle</td></tr>
            <tr><td>2 L</td><td>67.63 fl oz</td><td>Large soda bottle</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="faq">FAQs about converting liters to fl oz</h2>
      <h3>How many fl oz is 1 liter?</h3>
      <p>1 liter equals 33.814 US fluid ounces. Quick estimate: a 1-liter bottle is a little under 34 fl oz, or just over 4 cups (at 8 fl oz per cup).</p>
      <h3>How many fl oz is 2 liters?</h3>
      <p>2 liters equals 67.628 US fluid ounces. 2 × 33.814 = 67.63 fl oz. A 2-liter soda bottle holds about 67.6 fl oz or just over 8 cups.</p>
      <h3>How many fl oz is 0.5 liters?</h3>
      <p>0.5 liters equals 16.907 US fluid ounces. 0.5 × 33.814 = 16.91 fl oz. A standard 500 ml water bottle is about 16.9 fl oz.</p>
      <h3>How many liters is 32 fl oz?</h3>
      <p>32 US fl oz equals about 0.946 liters - just under 1 liter. 32 ÷ 33.814 = 0.946 L.</p>
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/fl-oz-to-l">Fluid Ounces to Liters</a>
            <p>Reverse conversion - enter fl oz and get liters instantly.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/l-to-ml">Liters to Milliliters</a>
            <p>Convert liters to ml - 1 L = 1,000 ml.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/l-to-gal">Liters to Gallons</a>
            <p>Convert liters to US gallons - 1 gallon = 3.785 L.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter">Volume Converter (all units)</a>
            <p>Convert between all volume units - ml, L, fl oz, cups, gallons, and more.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</CalculatorLayout>
<style is:global>
  .pair-inputs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: end; margin-bottom: 1rem; }
  .pair-field label { display: block; font-size: 0.8rem; color: rgba(255,255,255,0.7); margin-bottom: 0.35rem; }
  .pair-field input { width: 100%; padding: 0.6rem 0.75rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: white; font-size: 1rem; box-sizing: border-box; }
  .pair-eq { font-size: 1.5rem; color: rgba(255,255,255,0.5); padding-bottom: 0.35rem; }
  .pair-formula-note { text-align: center; font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 0.5rem; }
  @media (max-width: 480px) { .pair-inputs { grid-template-columns: 1fr; } .pair-eq { text-align: center; padding-bottom: 0; } }
</style>