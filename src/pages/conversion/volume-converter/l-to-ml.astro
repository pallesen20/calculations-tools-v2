---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';

const f = {
  fwd: "$$\\text{ml} = \\text{L} \\times 1{,}000$$",
  rev: "$$\\text{L} = \\text{ml} \\div 1{,}000$$",
};

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'formula',         label: 'How to convert liters to ml' },
  { id: 'reverse',         label: 'How to convert ml to liters' },
  { id: 'reference-table', label: 'Liters to ml reference table' },
  { id: 'when-to-use',     label: 'When you need this conversion' },
  { id: 'faq',             label: 'FAQs' },
  { id: 'related-tools',   label: 'Related tools' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Liters to Milliliters Converter",
    "url": "https://calculations.tools/conversion/volume-converter/l-to-ml",
    "description": "Convert liters to milliliters instantly. Formula: ml = L × 1,000. Includes reverse ml to liters conversion and a reference table.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to convert liters to milliliters",
    "description": "Multiply liters by 1,000 to get milliliters.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter liter value", "text": "Type your liter value in the L field. The ml result updates instantly." },
      { "@type": "HowToStep", "position": 2, "name": "Read the result", "text": "The converted ml value appears immediately. For 1.5 L, the result is 1,500 ml." },
      { "@type": "HowToStep", "position": 3, "name": "Convert in reverse", "text": "Type in the ml field to convert back to liters." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many ml is 1 liter?", "acceptedAnswer": { "@type": "Answer", "text": "1 liter equals exactly 1,000 milliliters. Multiply 1 by 1,000: 1 × 1,000 = 1,000 ml." } },
      { "@type": "Question", "name": "How do you convert liters to ml?", "acceptedAnswer": { "@type": "Answer", "text": "Multiply the number of liters by 1,000. Example: 1.5 L × 1,000 = 1,500 ml." } },
      { "@type": "Question", "name": "How many ml is 2 liters?", "acceptedAnswer": { "@type": "Answer", "text": "2 liters equals 2,000 ml. Multiply 2 by 1,000: 2 × 1,000 = 2,000 ml." } },
      { "@type": "Question", "name": "How many ml is 0.75 liters?", "acceptedAnswer": { "@type": "Answer", "text": "0.75 liters equals 750 ml. Multiply 0.75 by 1,000: 0.75 × 1,000 = 750 ml. This is the volume of a standard wine bottle." } }
    ]
  }
];
---
<CalculatorLayout
  title="Liters to Milliliters Converter"
  metaTitle="Liters to Milliliters Converter | Instantly convert L to mL"
  description="Convert liters to milliliters instantly. Formula: ml = L × 1,000. Common bottle and recipe sizes included - 0.5 L, 0.75 L, 1 L, 1.5 L, 2 L in ml."
  canonical="https://calculations.tools/conversion/volume-converter/l-to-ml"
  tocItems={tocItems}
  embedSlug="l-to-ml"
  schema={schema}
  ogFormula="ml = L × 1,000"
  ogExample="1.5 L = 1,500 ml"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container">
        <div class="calculator-header">
          <h2>Instantly Convert L to mL</h2>
          <p>Type in either field - converts instantly in both directions</p>
        </div>
        <div class="pair-inputs">
          <div class="pair-field">
            <label for="lp-a">Liters (L)</label>
            <input id="lp-a" type="text" inputmode="decimal" placeholder="e.g. 1.5" />
          </div>
          <div class="pair-eq">=</div>
          <div class="pair-field">
            <label for="lp-b">Milliliters (ml)</label>
            <input id="lp-b" type="text" inputmode="decimal" placeholder="e.g. 1500" />
          </div>
        </div>
        <div class="pair-formula-note">1 L = 1,000 ml &nbsp;·&nbsp; 1 ml = 0.001 L</div>
      </div>
    </section>
    <script src="/js/l-to-ml.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>To convert liters to milliliters, multiply by <strong>1,000</strong>. So 1 L = 1,000 ml, 1.5 L = 1,500 ml, and 2 L = 2,000 ml. The relationship is exact because "milli" means one-thousandth, so 1,000 ml = 1 L by definition.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>Exact formula: ml = L × 1,000. No rounding needed.</li>
          <li>Common reference: 1 L = 1,000 ml (standard water bottle). 0.75 L = 750 ml (wine bottle).</li>
          <li>Quick mental conversion: move the decimal point three places to the right. 1.5 L becomes 1,500 ml.</li>
          <li>To reverse: divide ml by 1,000 to get liters.</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use our L to mL converter</h2>
      <p>Type any liter value in the L field and the ml result appears instantly. You can also type in the ml field to convert back to liters - it works in both directions without pressing a button.</p>
      <h2 id="formula">How do you convert liters to milliliters?</h2>
      <p>Multiply the number of liters by 1,000. This is exact - both units are SI metric units and the relationship is a power of 10. Move the decimal point three places to the right.</p>
      <Formula expr={f.fwd} />
      <p>Worked examples: 0.1 L = 100 ml. 0.25 L = 250 ml. 0.5 L = 500 ml. 0.75 L = 750 ml. 1 L = 1,000 ml. 1.5 L = 1,500 ml. 2 L = 2,000 ml.</p>
      <h2 id="reverse">How do you convert milliliters to liters?</h2>
      <p class="also-see">Divide milliliters by 1,000. See the dedicated <a href="/conversion/volume-converter/ml-to-l">ml to liters converter</a> for a milliliters-first reference table.</p>
      <Formula expr={f.rev} />
      <p>Worked examples: 250 ml = 0.25 L. 500 ml = 0.5 L. 1,000 ml = 1 L. 1,500 ml = 1.5 L.</p>
      <h2 id="reference-table">Liters to milliliters reference table</h2>
      <p>Common liter values converted to milliliters, covering standard bottle and container sizes:</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Liters (L)</th><th>Milliliters (ml)</th><th>Context</th></tr>
          </thead>
          <tbody>
            <tr><td>0.1 L</td><td>100 ml</td><td>Small bottle / travel size</td></tr>
            <tr><td>0.25 L</td><td>250 ml</td><td>Cup of coffee</td></tr>
            <tr><td>0.33 L</td><td>330 ml</td><td>Standard can (soda, beer)</td></tr>
            <tr><td>0.5 L</td><td>500 ml</td><td>Standard water bottle</td></tr>
            <tr><td>0.75 L</td><td>750 ml</td><td>Wine bottle</td></tr>
            <tr><td>1 L</td><td>1,000 ml</td><td>Standard liter bottle</td></tr>
            <tr><td>1.5 L</td><td>1,500 ml</td><td>Large water bottle</td></tr>
            <tr><td>2 L</td><td>2,000 ml</td><td>Large soda bottle</td></tr>
            <tr><td>5 L</td><td>5,000 ml</td><td>Large water jug</td></tr>
            <tr><td>10 L</td><td>10,000 ml</td><td>Large container</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="when-to-use">When do you need to convert liters to ml?</h2>
      <p>This conversion appears frequently in cooking, medicine, and science when switching between container-level and serving-level volumes. Common scenarios:</p>
      <ul>
        <li><strong>Cooking</strong> - a recipe may specify 0.25 L of stock while your measuring cup is marked in ml.</li>
        <li><strong>Medicine</strong> - infusion rates and fluid prescriptions in hospitals often use L/hour while individual doses are in ml.</li>
        <li><strong>Beverages</strong> - product labels often show liters while serving size information shows ml.</li>
        <li><strong>Chemistry</strong> - solvent volumes are sometimes specified in liters while measuring cylinders read in ml.</li>
      </ul>
      <h2 id="faq">Frequently asked questions</h2>
      <h3>How many ml is 1 liter?</h3>
      <p>1 liter equals exactly 1,000 ml. Multiply 1 × 1,000 = 1,000 ml. 1 liter of water also weighs almost exactly 1 kilogram (at 4°C, to be precise).</p>
      <h3>How do you convert liters to ml?</h3>
      <p>Multiply the liter value by 1,000. Mental shortcut: move the decimal point three places to the right. 1.5 L becomes 1,500 ml. 0.33 L becomes 330 ml.</p>
      <h3>How many ml is 2 liters?</h3>
      <p>2 liters equals 2,000 ml. 2 × 1,000 = 2,000 ml. A 2-liter soda bottle holds exactly 2,000 ml.</p>
      <h3>How many ml is 0.75 liters?</h3>
      <p>0.75 liters equals 750 ml. 0.75 × 1,000 = 750 ml. This is a standard wine bottle volume.</p>
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/ml-to-l">Milliliters to Liters Converter</a>
            <p>Reverse conversion - enter ml and get liters instantly.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/l-to-fl-oz">Liters to Fluid Ounces Converter</a>
            <p>Convert liters to US fl oz - useful for comparing US and metric products.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/l-to-gal">Liters to Gallons Converter</a>
            <p>Convert liters to US gallons for fuel and large volume comparisons.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter">Volume Converter (all units)</a>
            <p>Convert between all volume units - ml, L, fl oz, cups, gallons, and more.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</CalculatorLayout>
<style is:global>
  .pair-inputs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: end; margin-bottom: 1rem; }
  .pair-field label { display: block; font-size: 0.8rem; color: rgba(255,255,255,0.7); margin-bottom: 0.35rem; }
  .pair-field input { width: 100%; padding: 0.6rem 0.75rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: white; font-size: 1rem; box-sizing: border-box; }
  .pair-eq { font-size: 1.5rem; color: rgba(255,255,255,0.5); padding-bottom: 0.35rem; }
  .pair-formula-note { text-align: center; font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 0.5rem; }
  @media (max-width: 480px) { .pair-inputs { grid-template-columns: 1fr; } .pair-eq { text-align: center; padding-bottom: 0; } }
</style>