---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';

const f = {
  fwd: "$$\\text{L} = \\text{fl oz} \\times 0.0295735$$",
  rev: "$$\\text{fl oz} = \\text{L} \\times 33.814$$",
};

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'formula',         label: 'How to convert fl oz to liters' },
  { id: 'reverse',         label: 'How to convert liters to fl oz' },
  { id: 'reference-table', label: 'fl oz to liters reference table' },
  { id: 'faq',             label: 'FAQs' },
  { id: 'related-tools',   label: 'Related tools' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Fluid Ounces to Liters Converter",
    "url": "https://calculations.tools/conversion/volume-converter/fl-oz-to-l",
    "description": "Convert US fluid ounces to liters instantly. Formula: L = fl oz × 0.0295735. 8 fl oz = 0.237 L, 16 fl oz = 0.473 L, 32 fl oz = 0.946 L.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to convert fluid ounces to liters",
    "description": "Multiply US fluid ounces by 0.0295735 to get liters.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter fl oz value", "text": "Type your fl oz value in the fl oz field. The liter result updates instantly." },
      { "@type": "HowToStep", "position": 2, "name": "Read the result", "text": "The converted liter value appears immediately. For 16 fl oz, the result is 0.473 L." },
      { "@type": "HowToStep", "position": 3, "name": "Convert in reverse", "text": "Type in the liter field to convert back to fl oz." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many liters is 16 fl oz?", "acceptedAnswer": { "@type": "Answer", "text": "16 US fluid ounces equals 0.473 liters. Multiply 16 by 0.0295735: 16 × 0.0295735 = 0.473 L. This is 1 US pint." } },
      { "@type": "Question", "name": "How many liters is 8 fl oz?", "acceptedAnswer": { "@type": "Answer", "text": "8 US fluid ounces equals 0.237 liters. Multiply 8 by 0.0295735: 8 × 0.0295735 = 0.237 L. This is 1 cup." } },
      { "@type": "Question", "name": "How many liters is 32 fl oz?", "acceptedAnswer": { "@type": "Answer", "text": "32 US fluid ounces equals 0.946 liters. Multiply 32 by 0.0295735: 32 × 0.0295735 = 0.946 L. This is just under 1 liter." } },
      { "@type": "Question", "name": "How many fl oz is 1 liter?", "acceptedAnswer": { "@type": "Answer", "text": "1 liter equals 33.814 US fluid ounces. A 1-liter bottle contains about 33.8 fl oz or just over 4 cups." } }
    ]
  }
];
---
<CalculatorLayout
  title="Fluid Ounces to Liters Converter"
  metaTitle="Fluid Ounces to Liters Converter | Convert fl oz to L"
  description="Convert US fluid ounces to liters instantly. 8 fl oz = 0.237 L, 16 fl oz = 0.473 L, 32 fl oz = 0.946 L, 64 fl oz = 1.893 L. Enter fl oz or liters."
  canonical="https://calculations.tools/conversion/volume-converter/fl-oz-to-l"
  tocItems={tocItems}
  embedSlug="fl-oz-to-l"
  schema={schema}
  ogFormula="L = fl oz × 0.0295735"
  ogExample="16 fl oz = 0.473 L (1 pint)"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container">
        <div class="calculator-header">
          <h2>Instantly Convert fl oz to L</h2>
          <p>Type in either field - converts instantly in both directions</p>
        </div>
        <div class="pair-inputs">
          <div class="pair-field">
            <label for="lp-a">Fluid Ounces (fl oz)</label>
            <input id="lp-a" type="text" inputmode="decimal" placeholder="e.g. 16" />
          </div>
          <div class="pair-eq">=</div>
          <div class="pair-field">
            <label for="lp-b">Liters (L)</label>
            <input id="lp-b" type="text" inputmode="decimal" placeholder="e.g. 0.473" />
          </div>
        </div>
        <div class="pair-formula-note">1 fl oz = 0.0295735 L &nbsp;·&nbsp; 1 L = 33.814 fl oz &nbsp;·&nbsp; US fl oz</div>
      </div>
    </section>
    <script src="/js/fl-oz-to-l.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>To convert US fluid ounces to liters, multiply by <strong>0.0295735</strong>. So 8 fl oz = 0.237 L (1 cup), 16 fl oz = 0.473 L (1 pint), and 32 fl oz = 0.946 L (just under 1 liter). Reverse: 1 L = 33.81 fl oz.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>Formula: L = fl oz × 0.0295735. Reverse: fl oz = L × 33.814.</li>
          <li>8 fl oz = 0.237 L (1 cup). 16 fl oz = 0.473 L (1 pint). 32 fl oz = 0.946 L.</li>
          <li>Quick estimate: 34 fl oz is about 1 liter. 64 fl oz is about 1.9 liters.</li>
          <li>All values use US fluid ounces (1 fl oz = 29.5735 ml).</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use our fl oz to L converter</h2>
      <p>Type any fl oz value in the fl oz field and the liter result appears instantly. You can also type in the liter field to convert back to fl oz - both directions work without pressing a button.</p>
      <h2 id="formula">How do you convert fl oz to liters?</h2>
      <p>Multiply the number of US fluid ounces by 0.0295735. This is 1 fl oz expressed as a fraction of a liter: 1 fl oz = 29.5735 ml = 0.0295735 L exactly.</p>
      <Formula expr={f.fwd} />
      <p>Worked examples: 8 fl oz = 0.237 L. 12 fl oz = 0.355 L. 16 fl oz = 0.473 L. 24 fl oz = 0.710 L. 32 fl oz = 0.946 L. 64 fl oz = 1.893 L. 128 fl oz = 3.785 L (1 gallon).</p>
      <h2 id="reverse">How do you convert liters to fl oz?</h2>
      <p class="also-see">Multiply liters by 33.814. See the dedicated <a href="/conversion/volume-converter/l-to-fl-oz">liters to fl oz converter</a> for a liters-first reference table.</p>
      <Formula expr={f.rev} />
      <p>Worked examples: 0.5 L = 16.91 fl oz. 1 L = 33.81 fl oz. 1.5 L = 50.72 fl oz. 2 L = 67.63 fl oz.</p>
      <h2 id="reference-table">Fluid ounces to liters reference table</h2>
      <p>Standard fl oz values converted to liters - from shot glass to gallon:</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Fluid Ounces (fl oz)</th><th>Liters (L)</th><th>Context</th></tr>
          </thead>
          <tbody>
            <tr><td>1 fl oz</td><td>0.030 L</td><td>Shot glass</td></tr>
            <tr><td>4 fl oz</td><td>0.118 L</td><td>Half cup</td></tr>
            <tr><td>8 fl oz</td><td>0.237 L</td><td>1 cup</td></tr>
            <tr><td>12 fl oz</td><td>0.355 L</td><td>Standard US can</td></tr>
            <tr><td>16 fl oz</td><td>0.473 L</td><td>1 pint</td></tr>
            <tr><td>24 fl oz</td><td>0.710 L</td><td>Large water bottle</td></tr>
            <tr><td>32 fl oz</td><td>0.946 L</td><td>Quart (nearly 1 liter)</td></tr>
            <tr><td>64 fl oz</td><td>1.893 L</td><td>Half gallon</td></tr>
            <tr><td>128 fl oz</td><td>3.785 L</td><td>1 gallon</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="faq">FAQs about fl oz to liters conversion</h2>
      <h3>How many liters is 16 fl oz?</h3>
      <p>16 US fl oz equals 0.473 liters. 16 × 0.0295735 = 0.473 L. This is 1 US pint and a common large cup size in cafes.</p>
      <h3>How many liters is 8 fl oz?</h3>
      <p>8 US fl oz equals 0.237 liters. 8 × 0.0295735 = 0.237 L. This is 1 US cup - the standard measuring cup size.</p>
      <h3>How many liters is 32 fl oz?</h3>
      <p>32 US fl oz equals 0.946 liters - just under 1 liter. Many "32 oz" water bottles are roughly equivalent to a 1-liter bottle (which is 33.81 fl oz).</p>
      <h3>How many fl oz is 1 liter?</h3>
      <p>1 liter equals 33.814 US fl oz. A 1-liter bottle holds about 33.8 fl oz, or just over 4 standard cups.</p>
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/l-to-fl-oz">Liters to Fluid Ounces</a>
            <p>Reverse conversion - enter liters and get fl oz instantly.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/fl-oz-to-ml">Fluid Ounces to Milliliters</a>
            <p>Convert fl oz to ml - 1 fl oz = 29.57 ml.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/ml-to-l">Milliliters to Liters</a>
            <p>Convert ml to L - 1,000 ml = 1 L.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter">Volume Converter (all units)</a>
            <p>Convert between all volume units - ml, L, fl oz, cups, gallons, and more.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</CalculatorLayout>
<style is:global>
  .pair-inputs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: end; margin-bottom: 1rem; }
  .pair-field label { display: block; font-size: 0.8rem; color: rgba(255,255,255,0.7); margin-bottom: 0.35rem; }
  .pair-field input { width: 100%; padding: 0.6rem 0.75rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: white; font-size: 1rem; box-sizing: border-box; }
  .pair-eq { font-size: 1.5rem; color: rgba(255,255,255,0.5); padding-bottom: 0.35rem; }
  .pair-formula-note { text-align: center; font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 0.5rem; }
  @media (max-width: 480px) { .pair-inputs { grid-template-columns: 1fr; } .pair-eq { text-align: center; padding-bottom: 0; } }
</style>