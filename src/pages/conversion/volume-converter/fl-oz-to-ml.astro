---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';

const f = {
  fwd: "$$\\text{ml} = \\text{fl oz} \\times 29.5735$$",
  rev: "$$\\text{fl oz} = \\text{ml} \\times 0.033814$$",
};

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'formula',         label: 'How to convert fl oz to ml' },
  { id: 'reverse',         label: 'How to convert ml to fl oz' },
  { id: 'reference-table', label: 'fl oz to ml reference table' },
  { id: 'us-vs-uk',        label: 'US vs UK fluid ounces' },
  { id: 'faq',             label: 'FAQs' },
  { id: 'related-tools',   label: 'Related tools' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Fluid Ounces to Milliliters Converter",
    "url": "https://calculations.tools/conversion/volume-converter/fl-oz-to-ml",
    "description": "Convert US fluid ounces to milliliters instantly. Formula: ml = fl oz × 29.5735. 1 fl oz = 29.57 ml, 8 fl oz = 236.6 ml, 16 fl oz = 473.2 ml.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to convert fluid ounces to milliliters",
    "description": "Multiply US fluid ounces by 29.5735 to get milliliters.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter fl oz value", "text": "Type your fluid ounce value in the fl oz field. The ml result updates instantly." },
      { "@type": "HowToStep", "position": 2, "name": "Read the result", "text": "The converted ml value appears immediately. For 8 fl oz, the result is 236.6 ml." },
      { "@type": "HowToStep", "position": 3, "name": "Convert in reverse", "text": "Type in the ml field to convert back to fl oz." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many ml is 1 fl oz?", "acceptedAnswer": { "@type": "Answer", "text": "1 US fluid ounce equals 29.5735 ml. Multiply 1 by 29.5735: 1 × 29.5735 = 29.57 ml. The UK fluid ounce is slightly larger at 28.4131 ml." } },
      { "@type": "Question", "name": "How many ml is 8 fl oz?", "acceptedAnswer": { "@type": "Answer", "text": "8 US fluid ounces equals 236.6 ml. Multiply 8 by 29.5735: 8 × 29.5735 = 236.6 ml. This equals 1 US cup." } },
      { "@type": "Question", "name": "How many ml is 16 fl oz?", "acceptedAnswer": { "@type": "Answer", "text": "16 US fluid ounces equals 473.2 ml. Multiply 16 by 29.5735: 16 × 29.5735 = 473.2 ml. This equals 1 US pint." } },
      { "@type": "Question", "name": "How many ml is 12 fl oz?", "acceptedAnswer": { "@type": "Answer", "text": "12 US fluid ounces equals 355 ml. Multiply 12 by 29.5735: 12 × 29.5735 = 354.9 ml. This is a standard US can of soda or beer." } }
    ]
  }
];
---
<CalculatorLayout
  title="Fluid Ounces to Milliliters Converter"
  metaTitle="Fluid Ounces to Milliliters Converter | US fl oz to ml"
  description="Convert US fluid ounces to milliliters instantly. 1 fl oz = 29.57 ml, 8 fl oz = 236.6 ml, 12 fl oz = 355 ml, 16 fl oz = 473.2 ml. Includes US vs UK fl oz comparison."
  canonical="https://calculations.tools/conversion/volume-converter/fl-oz-to-ml"
  tocItems={tocItems}
  embedSlug="fl-oz-to-ml"
  schema={schema}
  ogFormula="ml = fl oz × 29.5735"
  ogExample="8 fl oz = 236.6 ml (1 cup)"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container">
        <div class="calculator-header">
          <h2>Instantly Convert US fl oz to ml</h2>
          <p>Type in either field - converts instantly in both directions</p>
        </div>
        <div class="pair-inputs">
          <div class="pair-field">
            <label for="lp-a">Fluid Ounces (fl oz)</label>
            <input id="lp-a" type="text" inputmode="decimal" placeholder="e.g. 8" />
          </div>
          <div class="pair-eq">=</div>
          <div class="pair-field">
            <label for="lp-b">Milliliters (ml)</label>
            <input id="lp-b" type="text" inputmode="decimal" placeholder="e.g. 236.6" />
          </div>
        </div>
        <div class="pair-formula-note">1 fl oz = 29.5735 ml &nbsp;·&nbsp; US fl oz</div>
      </div>
    </section>
    <script src="/js/fl-oz-to-ml.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>To convert fluid ounces to milliliters, multiply by <strong>29.5735</strong>. So 1 fl oz = 29.57 ml, 8 fl oz = 236.6 ml (1 cup), and 16 fl oz = 473.2 ml (1 pint). This converter uses US fluid ounces throughout.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>Formula: ml = fl oz × 29.5735. Quick mental anchor: 1 fl oz is about 30 ml.</li>
          <li>8 fl oz = 236.6 ml (1 US cup). 12 fl oz = 355 ml (standard US can). 16 fl oz = 473 ml (1 US pint).</li>
          <li>US fl oz (29.5735 ml) differs from UK fl oz (28.4131 ml) - a ~4% difference.</li>
          <li>Reverse: fl oz = ml × 0.033814.</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use our fl oz to ml converter</h2>
      <p>Type any fl oz value in the fl oz field and the ml result appears instantly. You can also type in the ml field to convert back to fl oz - both directions work without pressing a button.</p>
      <h2 id="formula">How do you convert fluid ounces to milliliters?</h2>
      <p>Multiply the number of US fluid ounces by 29.5735. This is the exact conversion factor defined by the US customary system: 1 US fl oz = 29.5735295625 ml (rounded to 29.5735 for practical use).</p>
      <Formula expr={f.fwd} />
      <p>Worked examples: 1 fl oz = 29.57 ml. 2 fl oz = 59.15 ml. 4 fl oz = 118.3 ml. 8 fl oz = 236.6 ml. 12 fl oz = 354.9 ml. 16 fl oz = 473.2 ml. 32 fl oz = 946.4 ml.</p>
      <h2 id="reverse">How do you convert ml to fl oz?</h2>
      <p class="also-see">Multiply milliliters by 0.033814. See the dedicated <a href="/conversion/volume-converter/ml-to-fl-oz">ml to fl oz converter</a> for a ml-first reference table.</p>
      <Formula expr={f.rev} />
      <p>Worked examples: 100 ml = 3.38 fl oz. 250 ml = 8.45 fl oz. 500 ml = 16.91 fl oz. 1,000 ml = 33.81 fl oz.</p>
      <h2 id="reference-table">Fluid ounces to milliliters reference table</h2>
      <p>Standard US fl oz values converted to ml, with beverage and cooking context:</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Fluid Ounces (fl oz)</th><th>Milliliters (ml)</th><th>Context</th></tr>
          </thead>
          <tbody>
            <tr><td>1 fl oz</td><td>29.57 ml</td><td>Shot glass (US)</td></tr>
            <tr><td>2 fl oz</td><td>59.15 ml</td><td>Double shot</td></tr>
            <tr><td>4 fl oz</td><td>118.3 ml</td><td>Half cup</td></tr>
            <tr><td>6 fl oz</td><td>177.4 ml</td><td>Small glass / 3/4 cup</td></tr>
            <tr><td>8 fl oz</td><td>236.6 ml</td><td>1 cup</td></tr>
            <tr><td>12 fl oz</td><td>354.9 ml</td><td>Standard US can</td></tr>
            <tr><td>16 fl oz</td><td>473.2 ml</td><td>1 pint / large cup</td></tr>
            <tr><td>20 fl oz</td><td>591.5 ml</td><td>Large fountain drink</td></tr>
            <tr><td>24 fl oz</td><td>710.6 ml</td><td>Large water bottle</td></tr>
            <tr><td>32 fl oz</td><td>946.4 ml</td><td>Quart / large Nalgene</td></tr>
            <tr><td>64 fl oz</td><td>1,892.7 ml</td><td>Half gallon</td></tr>
            <tr><td>128 fl oz</td><td>3,785.4 ml</td><td>1 gallon</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="us-vs-uk">US vs UK fluid ounces - which one is used here?</h2>
      <p>This converter uses US fluid ounces. The two systems differ by about 4% - small but meaningful in precise recipes.</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>System</th><th>1 fl oz in ml</th><th>8 fl oz in ml</th><th>When you see it</th></tr>
          </thead>
          <tbody>
            <tr><td>US fluid ounce</td><td>29.5735 ml</td><td>236.6 ml</td><td>US recipes, US product labels</td></tr>
            <tr><td>UK fluid ounce</td><td>28.4131 ml</td><td>227.3 ml</td><td>UK recipes, British product labels</td></tr>
          </tbody>
        </table>
      </div>
      <p>If you're working with UK measurements, the difference adds up in a full recipe. 8 UK fl oz = 227.3 ml vs 8 US fl oz = 236.6 ml - nearly 10 ml difference per cup.</p>
      <h2 id="faq">FAQs about US fluid ounce, UK fluid ounce, and milliliter</h2>
      <h3>How many ml is 1 fl oz?</h3>
      <p>1 US fluid ounce equals 29.5735 ml. The UK fl oz is slightly larger at 28.4131 ml. Unless you're using a UK recipe or UK product, 1 fl oz = 29.57 ml is the right conversion to use.</p>
      <h3>How many ml is 8 fl oz?</h3>
      <p>8 US fluid ounces equals 236.6 ml. 8 × 29.5735 = 236.6 ml. This is 1 US cup - a standard measuring cup holds 8 fl oz or 236.6 ml.</p>
      <h3>How many ml is 16 fl oz?</h3>
      <p>16 US fluid ounces equals 473.2 ml. 16 × 29.5735 = 473.2 ml. This is 1 US pint and a common large beverage cup size.</p>
      <h3>How many ml is 12 fl oz?</h3>
      <p>12 US fluid ounces equals 354.9 ml. 12 × 29.5735 = 354.9 ml. Standard US cans of soda and beer are 12 fl oz (355 ml, rounded).</p>
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/ml-to-fl-oz">Milliliters to Fluid Ounces</a>
            <p>Reverse conversion - enter ml and get fl oz instantly.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/fl-oz-to-pint">Fluid Ounces to Pints</a>
            <p>Convert fl oz to US pints - 16 fl oz = 1 pint.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/cup-to-ml">Cups to Milliliters</a>
            <p>Convert US cups to ml for metric recipes - 1 cup = 236.6 ml.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter">Volume Converter (all units)</a>
            <p>Convert between all volume units - ml, L, fl oz, cups, gallons, and more.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</CalculatorLayout>
<style is:global>
  .pair-inputs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: end; margin-bottom: 1rem; }
  .pair-field label { display: block; font-size: 0.8rem; color: rgba(255,255,255,0.7); margin-bottom: 0.35rem; }
  .pair-field input { width: 100%; padding: 0.6rem 0.75rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: white; font-size: 1rem; box-sizing: border-box; }
  .pair-eq { font-size: 1.5rem; color: rgba(255,255,255,0.5); padding-bottom: 0.35rem; }
  .pair-formula-note { text-align: center; font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 0.5rem; }
  @media (max-width: 480px) { .pair-inputs { grid-template-columns: 1fr; } .pair-eq { text-align: center; padding-bottom: 0; } }
</style>