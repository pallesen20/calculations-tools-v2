---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';

const f = {
  fwd: "$$\\text{ml} = \\text{tbsp} \\times 14.7868$$",
  rev: "$$\\text{tbsp} = \\text{ml} \\div 14.7868$$",
};

const tocItems = [
  { id: 'how-to-use',      label: 'How to use this converter' },
  { id: 'formula',         label: 'How to convert tablespoons to ml' },
  { id: 'reverse',         label: 'How to convert ml to tablespoons' },
  { id: 'reference-table', label: 'Tablespoons to ml reference table' },
  { id: 'faq',             label: 'FAQs' },
  { id: 'related-tools',   label: 'Related tools' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Tablespoons to Milliliters Converter",
    "url": "https://calculations.tools/conversion/volume-converter/tbsp-to-ml",
    "description": "Convert tablespoons to milliliters for cooking. 1 tablespoon = 14.79 ml. 2 tbsp = 29.57 ml. 4 tbsp = 59.15 ml (1/4 cup).",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to convert tablespoons to milliliters",
    "description": "Multiply tablespoons by 14.7868 to get milliliters.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter tablespoon value", "text": "Type your tablespoon value in the tbsp field. The ml result updates instantly." },
      { "@type": "HowToStep", "position": 2, "name": "Read the result", "text": "The converted ml value appears. For 2 tbsp, the result is 29.57 ml." },
      { "@type": "HowToStep", "position": 3, "name": "Convert in reverse", "text": "Type in the ml field to convert back to tablespoons." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many ml is 1 tablespoon?", "acceptedAnswer": { "@type": "Answer", "text": "1 US tablespoon equals 14.787 ml. Many sources round to 15 ml, which is accurate to within 1.4%." } },
      { "@type": "Question", "name": "How many ml is 2 tablespoons?", "acceptedAnswer": { "@type": "Answer", "text": "2 tablespoons equals 29.57 ml. Multiply 2 by 14.7868: 2 × 14.7868 = 29.57 ml. This equals 1 fluid ounce." } },
      { "@type": "Question", "name": "How many tablespoons is 15 ml?", "acceptedAnswer": { "@type": "Answer", "text": "15 ml equals 1.014 tablespoons - essentially 1 tablespoon. The exact value is 14.787 ml, so rounding 1 tbsp to 15 ml is a minor but accepted simplification." } },
      { "@type": "Question", "name": "How many tablespoons is 30 ml?", "acceptedAnswer": { "@type": "Answer", "text": "30 ml equals 2.029 tablespoons - just over 2 tablespoons. 30 ml is also approximately 1 fluid ounce (1 fl oz = 29.57 ml)." } }
    ]
  }
];
---
<CalculatorLayout
  title="Tablespoons to Milliliters Converter"
  metaTitle="Tablespoons to Milliliters | Instantly convert tbsp to ml"
  description="Convert tablespoons to ml for cooking. 1 tbsp = 14.79 ml, 2 tbsp = 29.57 ml, 4 tbsp = 59.1 ml. Enter tablespoons or ml - converts both directions."
  canonical="https://calculations.tools/conversion/volume-converter/tbsp-to-ml"
  tocItems={tocItems}
  embedSlug="tbsp-to-ml"
  schema={schema}
  ogFormula="ml = tbsp × 14.7868"
  ogExample="1 tbsp = 14.79 ml"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container">
        <div class="calculator-header">
          <h2>Instantly Convert tbsp to ml</h2>
          <p>Type in either field - converts instantly in both directions</p>
        </div>
        <div class="pair-inputs">
          <div class="pair-field">
            <label for="lp-a">Tablespoons (tbsp)</label>
            <input id="lp-a" type="text" inputmode="decimal" placeholder="e.g. 1" />
          </div>
          <div class="pair-eq">=</div>
          <div class="pair-field">
            <label for="lp-b">Milliliters (ml)</label>
            <input id="lp-b" type="text" inputmode="decimal" placeholder="e.g. 14.79" />
          </div>
        </div>
        <div class="pair-formula-note">1 tbsp = 14.7868 ml &nbsp;·&nbsp; US tablespoon</div>
      </div>
    </section>
    <script src="/js/tbsp-to-ml.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>To convert tablespoons to milliliters, multiply by <strong>14.7868</strong>. So 1 tbsp = 14.79 ml, 2 tbsp = 29.57 ml (1 fl oz), and 4 tbsp = 59.1 ml (1/4 cup). Many recipes round 1 tbsp to 15 ml - accurate to within 1.4%.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>Formula: ml = tbsp × 14.7868. Practical rounding: 1 tbsp ≈ 15 ml.</li>
          <li>2 tbsp = 29.57 ml = 1 fl oz. 4 tbsp = 59.1 ml = 1/4 cup.</li>
          <li>1 tablespoon = 3 teaspoons. 16 tablespoons = 1 cup.</li>
          <li>Reverse: tbsp = ml ÷ 14.7868.</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use our tbsp to ml converter</h2>
      <p>Type any tablespoon value in the tbsp field and the ml result appears instantly. Use decimals for partial tablespoons. Both directions work without pressing a button.</p>
      <h2 id="formula">How do you convert tablespoons to ml?</h2>
      <p>Multiply the number of tablespoons by 14.7868. The US tablespoon is defined as exactly 1/2 US fluid ounce = 29.5735/2 = 14.7868 ml. For practical cooking, rounding to 15 ml per tablespoon is widely accepted and introduces less than 2% error.</p>
      <Formula expr={f.fwd} />
      <p>Worked examples: 1 tbsp = 14.79 ml. 2 tbsp = 29.57 ml. 3 tbsp = 44.36 ml. 4 tbsp = 59.15 ml. 8 tbsp = 118.3 ml (1/2 cup). 16 tbsp = 236.6 ml (1 cup).</p>
      <h2 id="reverse">How do you convert ml to tablespoons?</h2>
      <p class="also-see">Divide milliliters by 14.7868. See the dedicated <a href="/conversion/volume-converter/ml-to-tbsp">ml to tablespoons converter</a> for a ml-first reference table.</p>
      <Formula expr={f.rev} />
      <p>Worked examples: 15 ml = 1.01 tbsp. 30 ml = 2.03 tbsp. 45 ml = 3.04 tbsp. 60 ml = 4.06 tbsp.</p>
      <h2 id="reference-table">Tablespoons to ml reference table</h2>
      <p>Tablespoon values converted to ml, with cup fraction equivalents for recipe scaling:</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Tablespoons (tbsp)</th><th>Milliliters (ml)</th><th>Equivalent</th></tr>
          </thead>
          <tbody>
            <tr><td>1 tbsp</td><td>14.79 ml</td><td>3 teaspoons</td></tr>
            <tr><td>2 tbsp</td><td>29.57 ml</td><td>1 fl oz / 1/8 cup</td></tr>
            <tr><td>3 tbsp</td><td>44.36 ml</td><td>-</td></tr>
            <tr><td>4 tbsp</td><td>59.15 ml</td><td>1/4 cup</td></tr>
            <tr><td>5 tbsp</td><td>73.93 ml</td><td>-</td></tr>
            <tr><td>6 tbsp</td><td>88.72 ml</td><td>3/8 cup</td></tr>
            <tr><td>8 tbsp</td><td>118.3 ml</td><td>1/2 cup</td></tr>
            <tr><td>10 tbsp</td><td>147.9 ml</td><td>5/8 cup</td></tr>
            <tr><td>12 tbsp</td><td>177.4 ml</td><td>3/4 cup</td></tr>
            <tr><td>16 tbsp</td><td>236.6 ml</td><td>1 cup</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="faq">FAQs about converting tbsp to ml</h2>
      <h3>How many ml is 1 tablespoon?</h3>
      <p>1 US tablespoon equals 14.787 ml. Most cookbooks round this to 15 ml for simplicity. For baking and medicine, use the exact value. For everyday cooking, 15 ml works fine.</p>
      <h3>How many ml is 2 tablespoons?</h3>
      <p>2 tablespoons equals 29.57 ml - essentially 30 ml in practice. 2 tablespoons also equals 1 US fluid ounce exactly.</p>
      <h3>How many tablespoons is 15 ml?</h3>
      <p>15 ml equals 1.014 tablespoons - close enough to call it 1 tablespoon. The slight rounding difference (15 ml vs 14.79 ml) is under 2% and doesn't affect most recipes.</p>
      <h3>How many tablespoons is 30 ml?</h3>
      <p>30 ml equals 2.03 tablespoons - just over 2 tablespoons. 30 ml is also approximately 1 fluid ounce (1 fl oz = 29.57 ml).</p>
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/ml-to-tbsp">Milliliters to Tablespoons</a>
            <p>Reverse conversion - enter ml and get tablespoons instantly.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/tsp-to-ml">Teaspoons to Milliliters</a>
            <p>Convert teaspoons to ml - 1 tsp = 4.93 ml.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter/cup-to-ml">Cups to Milliliters</a>
            <p>Convert cups to ml - 1 cup = 236.6 ml = 16 tablespoons.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">💧</span>
          <div>
            <a href="/conversion/volume-converter">Volume Converter (all units)</a>
            <p>Convert between all volume units - ml, L, fl oz, cups, gallons, and more.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</CalculatorLayout>
<style is:global>
  .pair-inputs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: end; margin-bottom: 1rem; }
  .pair-field label { display: block; font-size: 0.8rem; color: rgba(255,255,255,0.7); margin-bottom: 0.35rem; }
  .pair-field input { width: 100%; padding: 0.6rem 0.75rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: white; font-size: 1rem; box-sizing: border-box; }
  .pair-eq { font-size: 1.5rem; color: rgba(255,255,255,0.5); padding-bottom: 0.35rem; }
  .pair-formula-note { text-align: center; font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 0.5rem; }
  @media (max-width: 480px) { .pair-inputs { grid-template-columns: 1fr; } .pair-eq { text-align: center; padding-bottom: 0; } }
</style>