---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Formula from '../../components/Formula.astro';
import type { Source } from '../../components/Sources.astro';
import HealthDisclaimer from '../../components/HealthDisclaimer.astro';
import QuizBlock from '../../components/QuizBlock.astro';

const f = {
  accuracy: "$$\\text{Accuracy \\%} = \\frac{\\text{Correct responses}}{\\text{Total opportunities}} \\times 100$$",
};

const tocItems = [
  { id: 'how-to-use',            label: 'How to use this calculator' },
  { id: 'iep-goal-mastery',      label: 'How is IEP goal mastery calculated?' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'mastery-criterion',     label: 'What is a mastery criterion?' },
  { id: 'progress-monitoring',   label: 'How often to monitor IEP progress' },
  { id: 'prompted-responses',    label: 'Should prompted responses count?' },
  { id: 'not-making-progress',   label: 'What to do if progress stalls' },
  { id: 'common-mistakes',       label: 'Common data recording mistakes' },
  { id: 'faq',                   label: 'FAQs' },
  { id: 'quiz',                  label: 'Quiz: test your knowledge' },
  { id: 'related-tools',         label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'A student answers 7 out of 10 questions correctly and needs 80% accuracy over 3 consecutive sessions to meet mastery. Does this session count toward the streak?',
    options: ['Yes - 7/10 is close enough', 'No - 70% is below the 80% criterion', 'Yes - any session with data counts', 'Only if the previous session also had data'] as [string, string, string, string],
    correct: 1 as const,
    explanation: '70% is below the 80% mastery criterion, so this session does not count toward the consecutive streak. Mastery requires meeting the specific percentage on every session in the required run - near-misses reset the count.',
  },
  {
    q: 'A student has sessions at 85%, 82%, 78%, 90% with an 80%/3-consecutive criterion. Is mastery met?',
    options: ['Yes - the average is above 80%', 'Yes - 3 of 4 sessions are above 80%', 'No - session 3 at 78% breaks the consecutive streak', 'No - 4 sessions are needed before mastery can be evaluated'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'Sessions 1 and 2 meet 80%, but session 3 at 78% breaks the streak. Session 4 restarts the count at 1. The consecutive requirement is strict: all sessions in the run must meet the criterion. Averaging across sessions is not how mastery is determined.',
  },
  {
    q: 'Under IDEA, how often must IEP teams report progress to parents?',
    options: ['Monthly', 'At least as often as report cards are issued for non-disabled students', 'Once per year at the annual IEP meeting', 'Only when the student meets a goal'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'IDEA (34 CFR § 300.320(a)(3)) requires IEP teams to report progress at least as often as report cards are issued to non-disabled students in the same school. For most districts that is quarterly, but the specific schedule matches the school\'s general reporting cycle.',
  },
  {
    q: 'Should prompted responses count toward the accuracy percentage when evaluating IEP goal mastery?',
    options: ['Yes - any correct response shows learning', 'No - only independent correct responses count toward mastery', 'Yes, but only after the prompt fading phase', 'It depends on whether the goal specifies independence'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Most IEP goals specify that the student will perform the skill independently. Counting prompted responses inflates the accuracy percentage and can produce a false mastery result. Unless the goal explicitly includes prompted responding as acceptable, only independent correct responses should count.',
  },
  {
    q: 'What is the purpose of a "consecutive sessions" requirement in an IEP mastery criterion?',
    options: [
      'To collect more total data points before making a decision',
      'To prevent a lucky single session from triggering an early mastery call',
      'To ensure the student has had enough practice trials overall',
      'It is a legal requirement under IDEA for all goals',
    ] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'A single high-accuracy session can be a statistical outlier. Requiring 3 or more consecutive sessions to all meet the criterion ensures the skill is stable and reliable across different days and conditions, not just one good day.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const sources: Source[] = [
  {
    author: 'U.S. Department of Education',
    title: 'Individuals with Disabilities Education Act (IDEA)',
    journal: 'IDEA.ed.gov',
    year: 2004,
    url: 'https://sites.ed.gov/idea/',
  },
  {
    author: 'IRIS Center, Vanderbilt University',
    title: 'Progress Monitoring: Mathematics',
    journal: 'IRIS Center',
    year: 2022,
    url: 'https://iris.peabody.vanderbilt.edu/module/pmm/',
  },
  {
    author: 'National Center on Intensive Intervention',
    title: 'What is Data-Based Individualization?',
    journal: 'NCII at AIR',
    year: 2021,
    url: 'https://intensiveintervention.org/data-based-individualization',
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "IEP Goal Progress Calculator",
    "url": "https://calculations.tools/health/iep-goal-calculator",
    "description": "Calculate IEP goal accuracy percentage across sessions, track mastery criterion streaks, and project goal completion dates for special education progress monitoring.",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to use the IEP Goal Progress Calculator",
    "description": "Enter session data, set the mastery criterion, and see mastery status and projected goal completion.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter session data", "text": "For each data collection session, enter the number of correct independent responses and the total number of opportunities. Add sessions with the + Session button up to 10 total." },
      { "@type": "HowToStep", "position": 2, "name": "Set the mastery criterion", "text": "Enter the accuracy percentage required for mastery (default 80%) and the number of consecutive sessions required (default 3). These values should match the IEP goal as written." },
      { "@type": "HowToStep", "position": 3, "name": "Enter goal dates (optional)", "text": "Enter the IEP goal start date and target end date. The calculator will show what percentage of the goal period has elapsed and project a mastery date based on the current rate of progress." },
      { "@type": "HowToStep", "position": 4, "name": "Read the mastery status", "text": "The calculator shows average accuracy, the current consecutive mastery streak, and whether the goal criterion has been met. The session table shows each session's accuracy and whether it counted toward the streak." },
      { "@type": "HowToStep", "position": 5, "name": "Review the session-by-session breakdown", "text": "The table at the bottom shows accuracy percentage and mastery status for each session. Use this to identify specific sessions where performance dropped and investigate why." },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a mastery criterion in an IEP goal?",
        "acceptedAnswer": { "@type": "Answer", "text": "A mastery criterion is the specific performance standard that defines when an IEP goal has been achieved. It typically includes an accuracy percentage (e.g., 80%) and a consistency requirement (e.g., across 3 consecutive sessions). Without a mastery criterion, teams cannot objectively determine whether the student has actually met the goal." }
      },
      {
        "@type": "Question",
        "name": "How do you calculate percent correct for an IEP goal?",
        "acceptedAnswer": { "@type": "Answer", "text": "Percent correct equals correct independent responses divided by total opportunities, multiplied by 100. Only independent responses count toward most IEP goals - prompted responses inflate the percentage and should not be included unless the goal explicitly allows them. The calculator handles this automatically when you enter correct and total values." }
      },
      {
        "@type": "Question",
        "name": "How often should IEP goal progress be monitored?",
        "acceptedAnswer": { "@type": "Answer", "text": "IDEA requires progress reports at least as often as general education report cards are issued, typically quarterly. For students receiving intensive intervention, weekly or biweekly data collection is recommended. The National Center on Intensive Intervention recommends at least 8 data points before making programming decisions." }
      },
      {
        "@type": "Question",
        "name": "What happens if a student is not making progress on an IEP goal?",
        "acceptedAnswer": { "@type": "Answer", "text": "The IEP team must reconvene to review and revise the goal, the instructional method, or both. IDEA does not require that students always achieve goals, but it does require that goals be reasonably ambitious and that the team respond to lack of progress. Persistent flat or declining data is typically the trigger for a program review." }
      },
      {
        "@type": "Question",
        "name": "Should prompted responses count toward IEP goal mastery?",
        "acceptedAnswer": { "@type": "Answer", "text": "Usually no. Most IEP goals require independent performance, so only unprompted correct responses should count toward the mastery percentage. Including prompted responses inflates accuracy and can produce false mastery. The exception is goals that explicitly include prompted responding as an acceptable response form." }
      }
    ]
  }
];
---
<CalculatorLayout
  title="IEP Goal Progress Calculator"
  metaTitle="Free IEP Goal Progress Calculator | BCBA Approved Tool"
  description="Calculate IEP goal accuracy per session, track consecutive mastery streaks, and project goal completion dates. Free tool for special education teachers, BCBAs, and IEP teams."
  canonical="https://calculations.tools/health/iep-goal-calculator"
  tocItems={tocItems}
  embedSlug="iep-goal-calculator"
  schema={schema}
  reviewerKey="nikki"
  sources={sources}
  ogFormula="Accuracy % = Correct responses / Total opportunities × 100"
  ogExample="8 correct / 10 total = 80% over 3 consecutive sessions → mastery criterion met"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container">
        <div class="calculator-header">
          <h2>IEP Goal Mastery Tool</h2>
          <p>Accuracy, mastery streak, and projected completion</p>
        </div>
        <div class="bmi-field">
          <label class="bmi-label">Mastery criterion</label>
          <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.25rem;">
            <div class="bmi-input-wrap" style="flex:1;">
              <input type="text" inputmode="decimal" id="igp-mastery" class="bmi-input" value="80" placeholder="80" />
              <span class="bmi-unit-tag">%</span>
            </div>
            <span style="color:rgba(255,255,255,0.4);font-size:0.8rem;white-space:nowrap;">over</span>
            <div class="bmi-input-wrap" style="flex:1;">
              <input type="text" inputmode="decimal" id="igp-consecutive" class="bmi-input" value="3" placeholder="3" />
              <span class="bmi-unit-tag">sessions</span>
            </div>
          </div>
        </div>
        <div class="dtt-session-header" style="margin-top:0.75rem;">
          <span class="dtt-session-label" style="font-size:0.7rem;color:rgba(255,255,255,0.4);">Session</span>
          <span class="dtt-col-label">Correct</span>
          <span class="dtt-col-label">Total</span>
          <span style="width:32px"></span>
        </div>
        <div id="igp-sessions-container"></div>
        <button id="igp-add-session" class="bmi-unit-btn" style="margin-top:0.5rem;width:100%;padding:0.45rem;">+ Add session</button>
        <div class="bmi-field" style="margin-top:0.75rem;">
          <label class="bmi-label">Goal dates (optional)</label>
          <div style="display:flex;gap:0.5rem;margin-top:0.25rem;">
            <div class="bmi-input-wrap" style="flex:1;">
              <input type="date" id="igp-goal-start" class="bmi-input" />
            </div>
            <span style="color:rgba(255,255,255,0.4);font-size:0.8rem;align-self:center;">to</span>
            <div class="bmi-input-wrap" style="flex:1;">
              <input type="date" id="igp-goal-end" class="bmi-input" />
            </div>
          </div>
        </div>
        <div id="igp-result"></div>
        <HealthDisclaimer />
      </div>
    </section>
    <script src="/js/iep-goal-calculator.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>This calculator takes session-by-session data for an <a href="/glossary/iep">IEP</a> goal - correct responses and total opportunities - and shows accuracy percentage, consecutive mastery streak, and whether the student has met the goal criterion. It also projects a mastery date if you enter IEP start and end dates.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>IEP goal accuracy = correct independent responses / total opportunities × 100 (IDEA, 2004).</li>
          <li>Most IEP goals require a mastery criterion of 80% accuracy across 3 consecutive sessions - a single high session is not enough.</li>
          <li>Prompted responses should not be counted toward mastery unless the goal explicitly allows them.</li>
          <li>IDEA requires progress to be reported to parents at least as often as general education report cards, typically quarterly.</li>
          <li>At least 8 data points are recommended before making programming decisions based on trend data (NCII, 2021).</li>
        </ul>
      </div>
      <h2 id="iep-goal-mastery">How is IEP goal mastery calculated?</h2>
      <p>IEP goal mastery is calculated by dividing correct independent responses by total opportunities and multiplying by 100 to get an accuracy percentage. The student must reach a preset threshold - most commonly 80% - across a defined number of consecutive sessions, typically 3.</p>
      <p><a href="https://sites.ed.gov/idea/" target="_blank" rel="noopener noreferrer">IDEA</a> requires that all IEP goals be measurable, which means every goal must specify exactly how mastery will be determined.</p>
      <p>The consecutive sessions requirement is the part teams most often overlook. A student who hits 90% in one session but drops to 60% the next has not demonstrated stable skill acquisition. The consecutive criterion forces a consistent performance window rather than a lucky one-off result.</p>
      <Formula expr={f.accuracy} />
      <h3 id="explained-to-beginner">IEP goal mastery explained to a beginner</h3>
      <p>Think of a school spelling test. If the goal is "spell 10 words correctly, 8 out of 10 (80%), on 3 tests in a row," the student hasn't passed after one good day. They need to get 8 or more correct on three separate tests without a bad test breaking the streak.</p>
      <p>That's exactly what this calculator tracks: the accuracy on each test and how many in a row have crossed the line.</p>
      <h2 id="how-to-use">How to use this IEP goal calculator</h2>
      <p>Enter each data collection session by typing the number of correct independent responses and the total number of opportunities. Add sessions with the button below the table. Set the mastery criterion to match the IEP goal as written - commonly 80% over 3 consecutive sessions. The calculator updates in real time and shows the current streak and mastery status.</p>
      <p>Entering the goal start and end dates is optional but adds two useful outputs: the percentage of the goal period that has already elapsed, and a projected mastery date based on the current rate of progress. If you're 70% through the goal period but only 50% of the way to mastery, that's an early warning that the program needs review.</p>
      <h2 id="mastery-criterion">What is a mastery criterion in an IEP goal?</h2>
      <p>A <a href="/glossary/mastery-criterion">mastery criterion</a> is the specific, measurable standard that defines when a student has achieved an IEP goal. Under IDEA, all IEP goals must be measurable, which means every goal needs a mastery criterion that answers: "How well, how often, and over how many trials?" (IDEA, 2004). Without this, teams cannot objectively determine whether a goal has been met.</p>
      <p>Mastery criteria typically include three components: an accuracy percentage (e.g., 80%), a consistency requirement (e.g., 3 consecutive sessions), and sometimes a condition (e.g., with verbal prompt fading completed).</p>
      <p>The percentage is the most commonly included element, but the consecutive sessions requirement is what prevents single-session flukes from triggering false mastery calls.</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr>
              <th>Criterion format</th>
              <th>Example</th>
              <th>What it checks</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Accuracy only</td><td>80% accuracy</td><td>Single session performance</td></tr>
            <tr><td>Accuracy + consecutive</td><td>80% over 3 consecutive sessions</td><td>Stability of skill across sessions</td></tr>
            <tr><td>Accuracy + trials</td><td>8 out of 10 trials</td><td>Per-session accuracy with explicit denominator</td></tr>
            <tr><td>Accuracy + conditions</td><td>80% independently, no prompt</td><td>Independence from prompts specifically</td></tr>
            <tr><td>Rate-based</td><td>20 words per minute</td><td>Fluency rather than accuracy</td></tr>
          </tbody>
        </table>
      </div>
      <p>When I review IEP progress data in <a href="/health/child-developmental-age-calculator">early intervention</a> and school-based programs, the most common gap I see is goals that specify accuracy but omit the consecutive requirement.</p>
      <p>A student with highly variable performance can hit 80% one session and 40% the next. Without the consecutive criterion, teams may call mastery prematurely and move on before the skill is truly stable.</p>
      <h2 id="progress-monitoring">How often should IEP goal progress be monitored?</h2>
      <p>IDEA requires progress reports to parents at least as often as general education report cards are issued, typically quarterly. But the reporting requirement and the data collection frequency are different things.</p>
      <p>For students receiving intensive intervention, weekly or biweekly probes are standard practice. The National Center on Intensive Intervention recommends collecting at least 8 data points before drawing any trend conclusions (<a href="https://intensiveintervention.org/data-based-individualization" target="_blank" rel="noopener noreferrer">NCII, 2021</a>).</p>
      <p>The practical minimum for a meaningful progress decision is 4 to 6 sessions of data. With fewer than 4 sessions, the consecutive criterion can be met in one run before enough variability is captured.</p>
      <p>This is why the calculator's projected mastery date becomes more reliable as you add more sessions - a 2-session trend line is volatile; a 7-session trend is meaningful.</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr>
              <th>Service intensity</th>
              <th>Recommended monitoring frequency</th>
              <th>Minimum data before decisions</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>General special education</td><td>Monthly probes</td><td>6-8 data points</td></tr>
            <tr><td>Intensive intervention (Tier 3)</td><td>Weekly probes</td><td>8-10 data points</td></tr>
            <tr><td>ABA programs</td><td>Every session</td><td>3-5 sessions per phase</td></tr>
            <tr><td>Speech / OT / PT services</td><td>Per session or weekly</td><td>4-6 data points</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="prompted-responses">Should prompted responses count toward IEP goal mastery?</h2>
      <p>No, in almost all cases. Most IEP goals require that the student perform the skill independently, so only unprompted correct responses should count toward the mastery percentage.</p>
      <p>Counting prompted responses inflates accuracy and can produce false mastery - a student who performs at 80% with prompts may still be at 40% without them. This same principle applies in <a href="/health/dtt-data-calculator">DTT data collection</a>, where prompted and independent trials are always tracked separately.</p>
      <p>The exception is a goal that explicitly names prompted responding as acceptable, which sometimes appears in goals targeting students with significant support needs.</p>
      <p>If the goal says "with verbal prompt, the student will..." then prompted responses are part of the target behavior and should be counted. When in doubt, the IEP goal text governs - not general practice.</p>
      <h2 id="not-making-progress">What should you do if a student isn't making progress?</h2>
      <p>Flat or declining data over 4 to 6 consecutive data points is the standard trigger for reconvening the IEP team. IDEA does not require students to meet every goal, but it does require goals to be reasonably ambitious and for teams to respond when progress is not occurring.</p>
      <p>The <a href="https://iris.peabody.vanderbilt.edu/module/pmm/" target="_blank" rel="noopener noreferrer">IRIS Center</a> recommends documenting the lack of progress, reviewing the instructional approach, and considering a formal evaluation update if the student's needs have changed significantly.</p>
      <p>Stalled progress usually points to one of three things: the goal was set too high without a sufficient instructional bridge, the teaching method isn't working, or the data being collected doesn't reflect what's actually being taught.</p>
      <p>Before changing the goal criterion, review whether sessions are being conducted with fidelity and whether the probe conditions match the instruction conditions.</p>
      <h2 id="common-mistakes">Common data recording mistakes in IEP progress monitoring</h2>
      <p>The most common mistake is recording prompted and independent responses together without distinguishing them. When a team records "8 correct out of 10" without noting that 4 of those 8 were prompted, the resulting accuracy <a href="/math/percentage-calculator">percentage</a> is meaningless for mastery purposes.</p>
      <p>The second most common issue is using averages instead of consecutive sessions to evaluate the criterion, which can mask performance variability.</p>
      <p>A third mistake is inconsistency in probe conditions. If a student is tested sometimes with 10 opportunities and sometimes with 20, the <a href="/glossary/denominator">denominators</a> are different and the percentages aren't directly comparable.</p>
      <p>For clean progress data, keep the probe format consistent: same number of opportunities, same materials, same time of day where possible.</p>
      <h2 id="faq">FAQs about IEP goal progress</h2>
      <h3>What is a mastery criterion in an IEP goal?</h3>
      <p>A mastery criterion defines exactly what performance level a student must reach for a goal to be considered met. It includes an accuracy percentage (such as 80%), a consistency requirement (such as 3 consecutive sessions), and sometimes a condition (such as independently, without prompts). Goals without a mastery criterion cannot be objectively evaluated under IDEA's measurability requirement.</p>
      <h3>How do you calculate percent correct for an IEP goal?</h3>
      <p>Divide the number of correct independent responses by the total number of opportunities, then <a href="/math/percentage-calculator">multiply by 100</a>. Only independent responses count unless the goal specifies otherwise. If a student gets 7 correct out of 10 total - with 2 of those prompted - independent accuracy is 5/10 = 50%, not 70%. Recording method matters for getting this right.</p>
      <h3>How often should IEP goal progress be monitored?</h3>
      <p>At minimum, teams must report progress to parents as often as general education report cards are issued, typically quarterly. For students in intensive intervention programs, weekly or biweekly data collection is standard. The National Center on Intensive Intervention recommends at least 8 data points before drawing conclusions from a trend line or making programming changes.</p>
      <h3>What happens if a student is not making progress on an IEP goal?</h3>
      <p>The IEP team must reconvene to review the goal and the instruction. IDEA does not require mastery of every goal but does require the team to respond when progress is not occurring. Standard responses include adjusting the instructional strategy, lowering an overambitious intermediate target, or requesting a re-evaluation to update the student's eligibility data.</p>
      <h3>Should prompted responses count toward IEP goal mastery?</h3>
      <p>Usually no. Most IEP goals require independent performance, and counting prompted responses inflates accuracy, potentially triggering a false mastery call. The exception is goals that explicitly target prompted performance, such as "with a verbal cue." If the IEP goal text does not specify prompted responding as acceptable, only independent correct responses should count.</p>
      <QuizBlock
        topic="IEP goal progress"
        questions={quizQuestions}
        pageUrl="https://calculations.tools/health/iep-goal-calculator"
      />
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">🧩</span>
          <div>
            <a href="/health/dtt-data-calculator">DTT Data Calculator</a>
            <p>Calculate percent correct, prompted rate, and mastery status for Discrete Trial Training sessions - the trial-level tool that feeds into IEP goal progress decisions.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">📊</span>
          <div>
            <a href="/health/aba-behavior-rate-calculator">ABA Behavior Rate Calculator</a>
            <p>Calculate frequency rates, duration percentages, and latency for behavior goals - often tracked alongside academic skill goals on the same IEP.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">🧠</span>
          <div>
            <a href="/health/adhd-break-calculator">ADHD Break Calculator</a>
            <p>Generate focus blocks and break intervals for students with ADHD - useful for structuring the instructional sessions where IEP goal data is collected.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">🌱</span>
          <div>
            <a href="/health/child-developmental-age-calculator">Child Developmental Age Calculator</a>
            <p>Estimate developmental age across 5 domains from milestone checklists - helps identify which present levels to document and which domains need IEP goals.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</CalculatorLayout>