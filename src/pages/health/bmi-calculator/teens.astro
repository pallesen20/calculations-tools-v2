const f = {
  metric:   "$$\\text{BMI} = \\frac{\\text{weight (kg)}}{\\text{height (m)}^2}$$",
  imperial: "$$\\text{BMI} = \\frac{703 \\times \\text{weight (lb)}}{\\text{height (in)}^2}$$",
};

const tocItems = [
  { id: 'how-to-use',          label: 'How to use' },
  { id: 'what-is-bmi-for-age', label: 'What is BMI-for-age in teens?' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'categories',          label: 'BMI categories for teens' },
  { id: 'bmi-chart-by-age',    label: 'BMI chart: ages 13–19' },
  { id: 'puberty',             label: 'Puberty and BMI' },
  { id: 'body-image',          label: 'Body image and mental health' },
  { id: 'athletic-teens',      label: 'Athletic teens and BMI' },
  { id: 'transition-adult',    label: 'Transition to adult BMI at 20' },
  { id: 'faq',                 label: 'FAQs' },
  { id: 'quiz',                label: 'Quiz: test your knowledge' },
  { id: 'related-tools',       label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'What measurement system does this calculator use to categorize a teenager\'s weight?',
    options: ['The same fixed adult thresholds (18.5, 25, 30) adapted for age', 'Age- and gender-specific percentiles using CDC 2000 growth charts', 'A modified Z-score system developed by the WHO for adolescents', 'Body mass index expressed as a ratio against ideal weight for height'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Teen BMI uses percentiles, not fixed numbers. The same BMI value means something different for a 13-year-old and a 17-year-old, so results are plotted against CDC 2000 growth charts and reported as a percentile relative to same-age, same-gender peers.',
  },
  {
    q: 'According to the BMI reference chart on this page, what is the 85th percentile BMI threshold for a 15-year-old girl - the point at which she is classified as Overweight?',
    options: ['23.6', '28.1', '20.2', '24.4'] as [string, string, string, string],
    correct: 3 as const,
    explanation: 'The table on this page shows that for a 15-year-old girl, BMI 24.4 is the 85th percentile - the overweight threshold. BMI 23.6 is the 85th percentile for a 15-year-old boy, and 20.2 is the 50th percentile (median) for both sexes at age 15.',
  },
  {
    q: 'The page explains that a 16-year-old boy and a 16-year-old girl at the same BMI percentile have "fundamentally different body compositions." What is the main reason?',
    options: ['Estrogen drives healthy fat deposition in girls while testosterone drives muscle and bone growth in boys - so the same BMI rise has opposite biological causes', 'Girls are typically shorter at 16, so the same BMI represents more total body fat', 'The CDC growth charts assign higher absolute BMI cutoffs to girls than boys at the same percentile', 'Boys in this age range grow in height faster than weight, which temporarily suppresses BMI regardless of fat mass'] as [string, string, string, string],
    correct: 0 as const,
    explanation: 'The puberty section explains that estrogen drives fat gain in girls and testosterone drives muscle and bone gain in boys. Both raise BMI, but for completely different reasons - meaning the same percentile tells a different health story depending on sex.',
  },
  {
    q: 'A 17-year-old boy has a BMI of 21.3. Based on the reference chart on this page, which percentile does that correspond to?',
    options: ['5th percentile (underweight threshold)', '85th percentile (overweight threshold)', '50th percentile (median)', '95th percentile (obese threshold)'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'The boys\' table on this page shows that at age 17, the 50th percentile BMI is exactly 21.3. That puts a 17-year-old boy with a BMI of 21.3 right at the middle of the healthy range for his age and sex.',
  },
  {
    q: 'The page explains that BMI is most likely to misclassify which type of teenager, and why?',
    options: ['Teenage girls during peak puberty, because normal estrogen-driven fat gain temporarily inflates BMI above the healthy range', 'Teenage boys in strength and power sports, because BMI cannot distinguish muscle from fat - a well-trained athlete may appear overweight with low body fat', 'Teenagers growing rapidly in height, because height changes faster than weight and temporarily lowers BMI', 'Any teenager in the Healthy weight category whose percentile is rising year to year'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'The athletic teens section specifically identifies teenage boys in strength and power sports (rugby, football, weightlifting) as the group most likely to be misclassified. A muscular teenage boy may have a BMI above the 85th percentile because his muscle mass is above average for his age - not because he carries excess fat.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

