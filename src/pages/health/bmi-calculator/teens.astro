    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "description": "Free BMI calculator for teenagers aged 13–19. Uses CDC 2000 growth chart LMS parameters to calculate BMI-for-age percentile and weight category, with context for puberty's effect on BMI.",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
