---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
import type { Source } from '../../../components/Sources.astro';
import HealthDisclaimer from '../../../components/HealthDisclaimer.astro';
import RelatedGlossaryTerms from '../../../components/RelatedGlossaryTerms.astro';
import QuizBlock from '../../../components/QuizBlock.astro';

const f = {
  metric:    "$$\\text{BMI} = \\frac{\\text{weight (kg)}}{\\text{height (m)}^2}$$",
  imperial:  "$$\\text{BMI} = \\frac{703 \\times \\text{weight (lb)}}{\\text{height (in)}^2}$$",
  bfGeneral: "$$\\text{BF\\%} = 1.20 \\times \\text{BMI} + 0.23 \\times \\text{Age} - 10.8 \\times S - 5.4$$",
};

const tocItems = [
  { id: 'how-to-use',          label: 'How to use' },
  { id: 'why-different',       label: 'Why BMI is different at 65+' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'senior-range',        label: 'The 23–27.5 senior optimal range' },
  { id: 'sarcopenia',          label: 'Sarcopenia: muscle loss with age' },
  { id: 'frailty',             label: 'Frailty risk and BMI' },
  { id: 'underweight-risk',    label: 'Underweight risk in older adults' },
  { id: 'obesity-seniors',     label: 'Obesity in older adults' },
  { id: 'body-fat-estimate',   label: 'Estimated body fat %' },
  { id: 'when-to-see-doctor',  label: 'When to see your doctor' },
  { id: 'faq',                 label: 'FAQs' },
  { id: 'quiz',                label: 'Quiz: test your knowledge' },
  { id: 'related-tools',       label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'What is the senior optimal BMI range for adults 65 and over, according to geriatric guidelines including ESPEN?',
    options: ['18.5-24.9 (same as the standard adult range)', '20-25', '22-28', '23-27.5'] as [string, string, string, string],
    correct: 3 as const,
    explanation: 'Geriatric guidelines including ESPEN recommend 23-27.5 as the optimal BMI range for adults 65 and over. This is higher than the standard adult range of 18.5-24.9 because low body weight carries far greater health risk at this age, and BMI 25-30 does not increase mortality in older adults the way it does in younger people.',
  },
  {
    q: 'According to EWGSOP2, what grip strength reading in a woman signals sarcopenia risk?',
    options: ['Below 22 kg', 'Below 16 kg', 'Below 20 kg', 'Below 12 kg'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'The EWGSOP2 consensus sets the grip strength threshold at below 16 kg for women and below 27 kg for men. Grip strength is a simple, validated proxy for sarcopenia risk and can be measured with an inexpensive hand dynamometer in under a minute.',
  },
  {
    q: 'What does the "obesity paradox" mean for adults aged 65 and over?',
    options: ['Adults 65+ with BMI 25-30 often show equal or lower all-cause mortality than those in the standard normal BMI range', 'Obese older adults exercise more than those at normal weight, which explains their better outcomes', 'The standard overweight category (BMI 25-30) is redefined as normal weight for all adults by WHO', 'Obesity in older adults causes less cardiovascular disease because metabolic rate slows with age'] as [string, string, string, string],
    correct: 0 as const,
    explanation: 'Large meta-analyses have found that older adults with BMI 25-30 often have equal or lower all-cause mortality compared to those in the standard normal range. The leading explanation is that higher weight provides an energy and protein reserve during acute illness or hospitalization.',
  },
  {
    q: 'According to the BMI table on this page, how is a BMI below 22 classified for adults over 65?',
    options: ['Falls risk from excess weight, the same mechanism as in younger adults', 'Below the senior optimal range but not yet a clinical concern', 'Within the senior optimal range for very elderly adults (80+)', 'A malnutrition risk factor (ESPEN/GLIM criterion)'] as [string, string, string, string],
    correct: 3 as const,
    explanation: 'The page\'s BMI interpretation table classifies a BMI below 22 as a malnutrition risk factor per the ESPEN and GLIM criteria, with key concerns including immune suppression, muscle wasting, falls, and poor wound healing. This is substantially higher than the standard adult underweight cutoff of 18.5.',
  },
  {
    q: 'The page lists three reasons BMI becomes less accurate in older adults. Which of the following is one of them?',
    options: ['Height decreases with age due to spinal compression, making BMI appear higher than it truly is', 'BMI cannot be reliably calculated in adults who take more than two medications', 'The standard BMI formula was designed for adults under 60 and underestimates body fat at older ages', 'Very high fluid intake in older adults dilutes BMI readings toward the underweight range'] as [string, string, string, string],
    correct: 0 as const,
    explanation: 'The page identifies three accuracy limitations: height decreases with age due to spinal compression (inflating BMI), muscle is replaced by fat without changing weight (masking poor body composition), and fluid retention from conditions like edema inflates weight. Grip strength and waist circumference are better indicators in people over 65.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const sources: Source[] = [
  {
    author: 'World Health Organization',
    title: 'Obesity and overweight',
    journal: 'WHO Fact Sheets',
    year: 2024,
    url: 'https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight',
