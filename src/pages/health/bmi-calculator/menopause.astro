---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
import RelatedGlossaryTerms from '../../../components/RelatedGlossaryTerms.astro';
import type { Source } from '../../../components/Sources.astro';
import HealthDisclaimer from '../../../components/HealthDisclaimer.astro';
import QuizBlock from '../../../components/QuizBlock.astro';

const f = {
  metric:   "$$\\text{BMI} = \\frac{\\text{weight (kg)}}{\\text{height (m)}^2}$$",
  imperial: "$$\\text{BMI} = \\frac{703 \\times \\text{weight (lb)}}{\\text{height (in)}^2}$$",
};

const tocItems = [
  { id: 'how-to-use',             label: 'How to use this calculator' },
  { id: 'bmi-after-menopause',   label: 'Why BMI is not enough after menopause' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'four-factors',          label: 'The four factors this calculator weighs' },
  { id: 'hrt-and-risk',          label: 'Does HRT lower cardiometabolic risk?' },
  { id: 'years-since-menopause', label: 'Why time since menopause matters' },
  { id: 'healthy-targets',       label: 'Healthy targets for postmenopausal women' },
  { id: 'faq',                   label: 'FAQs' },
  { id: 'quiz',                  label: 'Quiz: test your knowledge' },
  { id: 'related-tools',         label: 'Related tools' },
];

const sources: Source[] = [
  {
    author: 'Kaminska MS, Schneider-Matyka D, Rachubinska K, Panczyk M, Grochans E, Cybulska AM',
    title: 'Menopause Predisposes Women to Increased Risk of Cardiovascular Disease',
    journal: 'Journal of Clinical Medicine',
    year: 2023,
    url: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC10672665/',
  },
  {
    author: 'Shidfar F, et al.',
    title: 'Association of waist circumference, body mass index and conicity index with cardiovascular risk factors in postmenopausal women',
    journal: 'Cardiovascular Journal of Africa',
    year: 2012,
    url: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC3721927/',
  },
  {
    author: 'U.S. Office on Women\'s Health',
    title: 'Menopause basics',
    journal: 'U.S. Department of Health & Human Services',
    year: 2021,
    url: 'https://www.womenshealth.gov/menopause/menopause-basics',
  },
  {
    author: 'World Health Organization',
    title: 'Waist circumference and waist-hip ratio: report of a WHO expert consultation',
    journal: 'WHO',
    year: 2011,
    url: 'https://iris.who.int/items/8e0d5a48-7103-4ecd-905d-7476f2a98ed0',
  },
  {
    author: 'National Health Service (NHS)',
    title: 'Hormone replacement therapy (HRT): Side effects',
    journal: 'NHS, UK',
    year: 2023,
    url: 'https://www.nhs.uk/conditions/hormone-replacement-therapy-hrt/side-effects/',
  },
];

const quizQuestions = [
  {
    q: 'According to this page, what is the average age of menopause in the United States?',
    options: ['48', '50', '52', '54'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'The page cites U.S. Office on Women\'s Health data placing the average age of menopause at 52. The typical range is 45 to 58.',
  },
  {
    q: 'What does the waist circumference score of "High risk" apply to in the calculator?',
    options: ['80 cm or above', '85 cm or above', '88 cm or above', '94 cm or above'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'The WHO defines 88 cm (34.6 inches) as the high-risk waist threshold for women. Between 80 and 87 cm is "increased risk." Below 80 cm is low risk.',
  },
  {
    q: 'Why does HRT receive a risk-reducing adjustment in this calculator?',
    options: ['HRT reduces body weight directly', 'Estrogen slows visceral fat accumulation and the shift from gynoid to android fat distribution', 'HRT improves cardiovascular fitness', 'HRT raises muscle mass above baseline'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'The HRT section explains that estrogen directs fat storage toward subcutaneous hip and thigh depots and away from the visceral abdomen. Postmenopause, without estrogen, fat redistributes toward visceral depots. HRT partially slows this shift.',
  },
  {
    q: 'From the "years since menopause" section, what score does 12 years since menopause receive in this tool?',
    options: ['0', '0.5', '1', '1.5'] as [string, string, string, string],
    correct: 2 as const,
    explanation: '10-14 years since menopause scores 1 in this calculator. The score rises with time because visceral fat accumulation is progressive after estrogen withdrawal, peaking at roughly 15+ years.',
  },
  {
    q: 'Which finding from a 2023 Journal of Clinical Medicine study does this page cite?',
    options: ['BMI predicts CVD better than waist circumference in postmenopausal women', 'HRT eliminates cardiovascular risk after menopause', 'Age at menopause and time since menopause are factors that increase CVD risk', 'Visceral fat stabilizes 5 years after menopause'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'The page cites Kaminska et al. (2023) who found that both age at menopause and time since menopause independently increased CVD risk in a sample of 235 postmenopausal women assessed across three validated cardiovascular risk calculators.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Menopause BMI & Cardiometabolic Risk Calculator",
    "url": "https://calculations.tools/health/bmi-calculator/menopause",
    "description": "A BMI calculator for postmenopausal women that combines BMI, waist circumference, HRT status, and years since menopause to output a composite cardiometabolic risk rating.",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to use the Menopause Cardiometabolic Risk Calculator",
    "description": "Calculate composite cardiometabolic risk using BMI, waist circumference, HRT status, and time since menopause.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Select units", "text": "Choose Metric (kg and cm) or Imperial (lbs, feet, inches) using the toggle at the top." },
      { "@type": "HowToStep", "position": 2, "name": "Enter weight and height", "text": "Type your weight and height to calculate BMI. Results update as you type." },
      { "@type": "HowToStep", "position": 3, "name": "Enter waist circumference", "text": "Measure your waist at its narrowest point (typically 2-3 cm above the navel) and enter the reading." },
      { "@type": "HowToStep", "position": 4, "name": "Enter years since last period", "text": "Type how many years have passed since your last menstrual period." },
      { "@type": "HowToStep", "position": 5, "name": "Select HRT status and read result", "text": "Choose whether you are currently on hormone replacement therapy. The calculator immediately shows your BMI, waist risk level, and composite cardiometabolic risk rating." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a healthy BMI for a menopausal woman?",
        "acceptedAnswer": { "@type": "Answer", "text": "The standard healthy BMI range (18.5-24.9) applies to menopausal women. However, BMI alone is increasingly unreliable after menopause because falling estrogen causes fat to shift from hips and thighs to the visceral abdomen, raising metabolic risk even when BMI stays constant. Waist circumference below 80 cm alongside a normal BMI gives a much more complete picture." }
      },
      {
        "@type": "Question",
        "name": "Does HRT affect cardiometabolic risk after menopause?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Estrogen-containing HRT slows the shift of fat from subcutaneous to visceral depots that occurs after menopause. Women on HRT tend to accumulate less visceral fat and have lower waist circumference than non-users at the same body weight. This is why HRT status is a separate input in this calculator - two women with identical BMI and waist measurements may have different trajectories depending on whether they are on HRT." }
      },
      {
        "@type": "Question",
        "name": "What waist circumference is healthy after menopause?",
        "acceptedAnswer": { "@type": "Answer", "text": "The WHO defines below 80 cm (31.5 inches) as low risk for women. Between 80 and 87 cm (31.5-34.2 inches) is increased risk. Above 88 cm (34.6 inches) is high risk for cardiometabolic disease. These thresholds are the same regardless of menopausal status, but they matter more after menopause because visceral fat accumulation accelerates with estrogen withdrawal." }
      },
      {
        "@type": "Question",
        "name": "Why does time since menopause increase health risk?",
        "acceptedAnswer": { "@type": "Answer", "text": "Visceral fat accumulation after menopause is not a one-time event - it is a progressive process driven by ongoing estrogen withdrawal. Research shows risk scores rise meaningfully at 5-9 years, again at 10-14 years, and continue upward beyond 15 years post-menopause. The longer the period without estrogen, the greater the cumulative redistribution of fat toward the metabolically harmful visceral compartment." }
      },
      {
        "@type": "Question",
        "name": "Can a normal BMI mean high cardiometabolic risk after menopause?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. A postmenopausal woman with a normal BMI but a waist above 88 cm, 10+ years since menopause, and no HRT can score in the Elevated or High risk tier. This is the normal weight obesity pattern - where body fat percentage and visceral fat are clinically elevated despite normal BMI. Waist circumference is the key metric for detecting this in postmenopausal women." }
