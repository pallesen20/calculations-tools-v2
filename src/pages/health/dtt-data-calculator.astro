---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Formula from '../../components/Formula.astro';
import type { Source } from '../../components/Sources.astro';
import HealthDisclaimer from '../../components/HealthDisclaimer.astro';
import QuizBlock from '../../components/QuizBlock.astro';
import RelatedGlossaryTerms from '../../components/RelatedGlossaryTerms.astro';

const f = {
  pctIndependent: "$$\\text{\\% Correct} = \\frac{\\text{Independent correct}}{\\text{Total trials}} \\times 100$$",
  pctWithPrompts: "$$\\text{\\% With prompts} = \\frac{\\text{Correct} + \\text{Prompted}}{\\text{Total trials}} \\times 100$$",
};

const tocItems = [
  { id: 'how-to-use',            label: 'How to use this calculator' },
  { id: 'what-is-dtt',           label: 'What is DTT?' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'trial-types',           label: 'Trial response types' },
  { id: 'mastery-criteria',      label: 'Mastery criteria in ABA' },
  { id: 'prompted-vs-independent', label: 'Prompted vs. independent' },
  { id: 'across-sessions',       label: 'Tracking mastery across sessions' },
  { id: 'common-mistakes',       label: 'Common data recording mistakes' },
  { id: 'faq',                   label: 'FAQs' },
  { id: 'quiz',                  label: 'Quiz: test your knowledge' },
  { id: 'related-tools',         label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'A session has 8 correct, 2 prompted, 3 incorrect, 2 NR. What is the % independent correct?',
    options: ['53.3%', '66.7%', '80.0%', '73.3%'] as [string, string, string, string],
    correct: 0 as const,
    explanation: 'Total trials = 8 + 2 + 3 + 2 = 15. % independent = 8 / 15 × 100 = 53.3%. Prompted trials do not count toward independent correct - only trials the learner completed without assistance.',
  },
  {
    q: 'What does it mean for a learner to "meet mastery" in DTT?',
    options: [
      'They answer correctly on every single trial in one session',
      'They reach a preset % correct (e.g. 80%) across a set number of consecutive sessions',
      'They complete the trial within 3 seconds of the SD',
      'They score above 50% with prompts counted',
    ] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Mastery in DTT means reaching a preset percentage of independent correct responses (commonly 80% or 90%) across a defined number of consecutive sessions - not just one session. Consecutive sessions prevent false mastery from a lucky run.',
  },
  {
    q: 'Why are prompted trials recorded separately from independent correct trials?',
    options: [
      'Prompted trials inflate the percent correct and can mask the learner\'s true independent skill level',
      'Prompts are only used in the first three sessions and should be excluded after that',
      'Recording prompts is optional - only some behavior plans require it',
      'Prompted trials count the same as independent trials for mastery purposes',
    ] as [string, string, string, string],
    correct: 0 as const,
    explanation: 'Counting prompted trials as correct inflates the percentage and can lead a team to advance a program before the learner truly has the skill independently. The whole purpose of prompt fading is to reach independent responding, so only independent correct trials should count toward mastery.',
  },
  {
    q: 'What is "prompt dependency" in DTT?',
    options: [
      'When a learner consistently scores below 50% independent correct',
      'When a learner learns to wait for a prompt instead of attempting the response independently',
      'When a BCBA requires more than 3 prompts per session',
      'When no-response trials exceed 20% of the total',
    ] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Prompt dependency occurs when a learner learns to wait for the prompt rather than respond to the SD alone. It happens when prompts are delivered too quickly or not faded systematically. The DTT data calculator reveals it: prompted trials stay high while independent correct stays low across sessions.',
  },
  {
    q: 'A learner scores 85%, 82%, 79%, 88% across four sessions with an 80% / 3-consecutive mastery criterion. Is mastery achieved?',
    options: [
      'Yes - all four sessions are above 79%, which is close enough',
      'Yes - the average is above 80%',
      'No - the third session (79%) breaks the consecutive streak',
      'No - mastery requires at least 5 sessions of data',
    ] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'Sessions 1 and 2 meet the 80% criterion, but session 3 at 79% breaks the streak. Session 4 restarts the count at 1. Mastery requires three consecutive sessions all at or above 80% - averages and near-misses do not count.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const sources: Source[] = [
  {
    author: 'Cooper, J. O., Heron, T. E., & Heward, W. L.',
    title: 'Applied Behavior Analysis (3rd ed.)',
    journal: 'Pearson',
    year: 2020,
    url: 'https://www.pearson.com/en-us/subject-catalog/p/applied-behavior-analysis/P200000000905/9780134752556',
  },
  {
    author: 'Behavior Analyst Certification Board',
    title: 'BCBA Task List (5th ed.)',
    journal: 'BACB',
    year: 2022,
    url: 'https://www.bacb.com/bcba/',
  },
  {
    author: 'Smith, T.',
    title: 'Discrete Trial Training in the Treatment of Autism',
    journal: 'Focus on Autism and Other Developmental Disabilities',
    year: 2001,
    url: 'https://doi.org/10.1177/108835760101600202',
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "DTT Data Calculator",
    "url": "https://calculations.tools/health/dtt-data-calculator",
    "description": "Calculate percent correct, prompted, and mastery status for Discrete Trial Training sessions. Track performance across sessions to determine when a learner meets mastery criteria.",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to use the DTT Data Calculator",
    "description": "Steps to calculate percent correct and mastery status from Discrete Trial Training data.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Select session mode", "text": "Choose Single session to analyze one session's data, or Across sessions to track mastery over multiple sessions." },
      { "@type": "HowToStep", "position": 2, "name": "Enter trial counts", "text": "Input the number of correct (independent), prompted, incorrect, and no-response trials from your data sheet." },
      { "@type": "HowToStep", "position": 3, "name": "Set mastery criterion", "text": "Enter your program's mastery criterion percentage (default 80%). For across-sessions mode, also set the required number of consecutive sessions." },
      { "@type": "HowToStep", "position": 4, "name": "Read the result", "text": "The calculator shows % independent correct, % with prompts, mastery status, and a full session-by-session breakdown table." },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is percent correct in DTT?",
        "acceptedAnswer": { "@type": "Answer", "text": "Percent correct in DTT is the number of independent correct trials divided by the total number of trials, multiplied by 100. Only trials the learner answers without any prompt count as independent correct. Prompted trials are tracked separately and do not count toward mastery." }
      },
      {
        "@type": "Question",
        "name": "What is a mastery criterion in ABA?",
        "acceptedAnswer": { "@type": "Answer", "text": "A mastery criterion is the performance standard a learner must meet before a program is considered complete. The most common standard is 80% independent correct across 3 consecutive sessions. Some programs use 90% across 2 consecutive sessions for skills that require higher reliability." }
      },
      {
        "@type": "Question",
        "name": "Should prompted trials count toward percent correct?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. Prompted trials should be tracked separately and not counted as independent correct. Including prompted responses in the percent correct inflates the score and can lead a team to advance a program before the learner has truly acquired the skill independently." }
      },
      {
        "@type": "Question",
        "name": "How many trials per session does DTT require?",
        "acceptedAnswer": { "@type": "Answer", "text": "Most ABA programs use 10 trials per session as a standard block size, though 5-20 trials are common depending on the skill and learner. Cooper et al. (2020) note there is no universal rule - trial density should match the learner's endurance and the skill's response requirements." }
      },
      {
        "@type": "Question",
        "name": "What is prompt dependency in DTT?",
        "acceptedAnswer": { "@type": "Answer", "text": "Prompt dependency occurs when a learner waits for a prompt instead of responding to the discriminative stimulus alone. It's caused by prompts delivered too quickly or not faded systematically. It shows up in DTT data as consistently high prompted trials alongside low independent correct percentages across sessions." }
      },
    ]
  }
];
---
<CalculatorLayout
  title="DTT Data Calculator"
  metaTitle="DTT Data Calculator | ABA Discrete Trial Training Tracker"
  description="Calculate percent correct, prompted rate, and mastery status for Discrete Trial Training sessions. Track performance across sessions for BCBA program decisions."
  canonical="https://calculations.tools/health/dtt-data-calculator"
  tocItems={tocItems}
  embedSlug="dtt-data-calculator"
  schema={schema}
  sources={sources}
  reviewerKey="nikki"
  ogFormula="% Correct = independent correct / total trials × 100"
  ogExample="8 correct, 2 prompted, 5 errors in 15 trials = 53.3% independent"
>
  <div slot="calculator">
    <div class="bmi-unit-toggle">
      <button class="dtt-mode-btn bmi-unit-btn active" data-mode="single">Single session</button>
      <button class="dtt-mode-btn bmi-unit-btn" data-mode="multi">Across sessions</button>
    </div>
    <div id="dtt-single-section">
      <div class="bmi-field">
        <label class="bmi-label" for="dtt-correct">Correct (independent)</label>
        <div class="bmi-input-wrap">
          <input type="text" inputmode="decimal" id="dtt-correct" class="bmi-input" placeholder="e.g. 8" />
          <span class="bmi-unit-tag">trials</span>
        </div>
      </div>
      <div class="bmi-field">
        <label class="bmi-label" for="dtt-prompted">Prompted</label>
        <div class="bmi-input-wrap">
          <input type="text" inputmode="decimal" id="dtt-prompted" class="bmi-input" placeholder="e.g. 2" />
          <span class="bmi-unit-tag">trials</span>
        </div>
      </div>
      <div class="bmi-field">
        <label class="bmi-label" for="dtt-incorrect">Incorrect</label>
        <div class="bmi-input-wrap">
          <input type="text" inputmode="decimal" id="dtt-incorrect" class="bmi-input" placeholder="e.g. 3" />
          <span class="bmi-unit-tag">trials</span>
        </div>
      </div>
      <div class="bmi-field">
        <label class="bmi-label" for="dtt-no-response">No response</label>
        <div class="bmi-input-wrap">
          <input type="text" inputmode="decimal" id="dtt-no-response" class="bmi-input" placeholder="e.g. 2" />
          <span class="bmi-unit-tag">trials</span>
        </div>
      </div>
    </div>
    <div id="dtt-multi-section" style="display:none;">
      <div class="dtt-session-header">
        <span class="dtt-session-label">Session</span>
        <span class="dtt-col-label">C</span>
        <span class="dtt-col-label">P</span>
        <span class="dtt-col-label">I</span>
        <span class="dtt-col-label">NR</span>
        <span style="width:32px"></span>
      </div>
      <div id="dtt-sessions-container"></div>
      <button id="dtt-add-session" class="abr-add-btn">+ Add session</button>
      <div class="bmi-field" style="margin-top:0.5rem;">
        <label class="bmi-label" for="dtt-consecutive">Consecutive sessions needed</label>
        <div class="bmi-input-wrap">
          <input type="text" inputmode="decimal" id="dtt-consecutive" class="bmi-input" placeholder="3" value="3" />
          <span class="bmi-unit-tag">sessions</span>
        </div>
      </div>
    </div>
    <div class="bmi-field" style="margin-top:0.75rem;">
      <label class="bmi-label" for="dtt-mastery">Mastery criterion: <span id="dtt-mastery-display">80%</span></label>
      <input type="range" id="dtt-mastery" min="50" max="100" value="80" step="5" class="dtt-mastery-slider" />
    </div>
    <div id="dtt-result"></div>
    <HealthDisclaimer />
    <script src="/js/dtt-data-calculator.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>Enter the number of correct (independent), prompted, incorrect, and no-response trials from a DTT session. The calculator returns percent independent correct, percent with prompts, and whether the session meets your mastery criterion. Switch to "Across sessions" to track consecutive mastery across multiple sessions.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>% Independent correct = independent correct trials / total trials x 100. Prompted trials never count toward mastery.</li>
          <li>The most common mastery criterion in ABA is 80% independent correct across 3 consecutive sessions (Cooper et al., 2020).</li>
          <li>Prompt dependency - when high prompted % persists alongside low independent % - is the most common sign a program needs prompt-fading adjustments.</li>
          <li>Discrete-trial teaching is a mandated BCBA competency in the <a href="https://www.bacb.com/bcba/" target="_blank" rel="noopener">BACB 5th Edition Task List</a> (2022), reflecting its foundational role across early intensive ABA programs.</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use this DTT data calculator</h2>
      <p>Select <strong>Single session</strong> and enter your trial counts - correct, prompted, incorrect, and no response - from your data sheet. The mastery slider defaults to 80%; adjust it to match your program's criterion. The result shows percent independent correct and mastery status instantly.</p>
      <p>For tracking progress over time, switch to <strong>Across sessions</strong>. Enter C/P/I/NR counts for each session and set the consecutive sessions required. The calculator shows a session-by-session table and tells you exactly when - or if - mastery has been achieved.</p>
      <h2 id="what-is-dtt">What is Discrete Trial Training and why does data matter?</h2>
      <p>Discrete Trial Training (DTT) is a structured teaching method used in <a href="/glossary/applied-behavior-analysis">Applied Behavior Analysis (ABA)</a>: each trial presents a clear antecedent (the discriminative stimulus, or SD), waits for a response, and delivers a consequence.</p>
      <p>A 2001 review in <em>Focus on Autism and Other Developmental Disabilities</em> (Smith) confirmed DTT as one of the most evidence-based techniques for teaching skills to children with autism spectrum disorder.</p>
      <p>Data recording transforms DTT from a teaching activity into a clinical science. Without accurate trial-by-trial data, a team cannot tell whether a learner is acquiring the skill independently or only responding because a prompt is present.</p>
      <p>The percent correct calculation is the first analysis every <a href="/glossary/bcba">BCBA</a> performs after reviewing a session's data sheet.</p>
      <h3 id="explained-to-beginner">DTT explained to a curious beginner</h3>
      <p>Think of DTT like a spelling test where the teacher gives one word at a time and records whether the student spells it correctly, needs a hint (prompted), gets it wrong, or doesn't answer.</p>
      <p>After 10 words, you count how many the student spelled correctly without any hints. If a student scores 8/10 without hints, that's 80% independent - most ABA programs require this across 3 tests in a row before moving on to harder words.</p>
      <h2 id="trial-types">What do the four trial response types mean?</h2>
      <p>Four response types are standard in DTT data recording across ABA programs, as defined in <a href="https://www.pearson.com/en-us/subject-catalog/p/applied-behavior-analysis/P200000000905/9780134752556" target="_blank" rel="noopener">Cooper et al. (2020)</a>. Recording all four gives a complete picture of acquisition - most DTT apps and paper data sheets use these exact categories.</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Code</th><th>Response type</th><th>Definition</th><th>Counts toward mastery?</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>C</strong></td><td>Correct (independent)</td><td>Learner responds to the SD without any prompt, within the response interval</td><td>Yes</td></tr>
            <tr><td><strong>P</strong></td><td>Prompted</td><td>Learner responds correctly only after a prompt was delivered</td><td>No</td></tr>
            <tr><td><strong>I</strong></td><td>Incorrect</td><td>Learner emits a wrong response to the SD</td><td>No</td></tr>
            <tr><td><strong>NR</strong></td><td>No response</td><td>Learner does not respond within the defined response interval</td><td>No</td></tr>
          </tbody>
        </table>
      </div>
      <p>Some programs also record "self-correction" (SC) when a learner initially responds incorrectly then corrects without prompting. Whether SC counts as correct varies by program - check your behavior plan before entering data.</p>
      <h2 id="mastery-criteria">What mastery criteria do BCBAs use in DTT programs?</h2>
      <p>The most common mastery criterion in published ABA programs is 80% independent correct across 3 consecutive sessions, as cited throughout <a href="https://www.pearson.com/en-us/subject-catalog/p/applied-behavior-analysis/P200000000905/9780134752556" target="_blank" rel="noopener">Cooper et al. (2020)</a> and in the <a href="https://www.bacb.com/bcba/" target="_blank" rel="noopener">BACB 5th Edition Task List (2022)</a>. Some programs use stricter criteria - especially for safety skills or foundational language. The same 80%/3-session standard applies to <a href="/health/iep-goal-calculator">IEP goal progress</a> in school-based special education programs.</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Criterion</th><th>% correct</th><th>Consecutive sessions</th><th>Typical use case</th></tr>
          </thead>
          <tbody>
            <tr><td>Standard</td><td>80%</td><td>3</td><td>Most academic, play, and adaptive skills</td></tr>
            <tr><td>Stringent</td><td>90%</td><td>2</td><td>Communication, safety skills, generalization targets</td></tr>
            <tr><td>High reliability</td><td>100%</td><td>2-3</td><td>Safety behaviors (e.g., stop at the curb)</td></tr>
            <tr><td>Flexible</td><td>80%</td><td>2</td><td>Quickly progressing learners on massed practice programs</td></tr>
          </tbody>
        </table>
      </div>
      <p>In every behavior plan I write, I set the mastery criterion before data collection begins - never after reviewing the data. Setting criteria post-hoc introduces bias into program decisions and undermines the analytic integrity of the program.</p>
      <h2 id="prompted-vs-independent">Why should prompted trials never count toward mastery?</h2>
      <p>Including prompted responses in the percent correct figure is one of the most consequential data recording errors in ABA practice.</p>
      <blockquote class="blockquote-observation">
      <p>Cooper et al. (2020) are explicit: the goal of DTT is independent responding to the SD, not prompted responding.</p>
      </blockquote>
      <p>A learner who answers 10/10 trials correctly but needs a prompt on 7 of them has not acquired the skill - they have learned to wait for assistance.</p>
      <p>This matters clinically because advancing a program prematurely based on inflated data wastes instructional time and can teach prompt dependency.</p>
      <p>This calculator shows both figures - % independent and % with prompts counted - so you can see the gap and decide whether prompt fading needs to be adjusted.</p>
      <Formula expr={f.pctIndependent} />
      <Formula expr={f.pctWithPrompts} />
      <h3>Worked example</h3>
      <p>8 correct, 2 prompted, 3 incorrect, 2 NR = 15 total. % independent = 8/15 = <strong>53.3%</strong>. % with prompts = 10/15 = <strong>66.7%</strong>. The 13-point gap signals that prompt fading may need adjustment before this learner can reach the 80% mastery criterion independently.</p>
      <p>When I supervise behavior technicians and I see a consistent gap of more than 20 percentage points between % with prompts and % independent across sessions, I treat that as a prompt dependency flag.</p>
      <p>It tells me prompts are being delivered too quickly or the prompt hierarchy isn't being faded. I'll typically request a video of one session before the next supervision meeting so I can observe the timing directly.</p>
      <h2 id="across-sessions">How do you track mastery across DTT sessions?</h2>
      <p>Consecutive session mastery is the standard method for determining skill acquisition in ABA programs. A single high-scoring session can reflect chance, fatigue effects, or a particularly attentive learner that day. Three consecutive sessions at or above the criterion provides enough evidence that the skill is stable.</p>
      <p>The <a href="/health/aba-behavior-rate-calculator">ABA behavior rate calculator</a> handles the within-session measurement; this calculator handles the across-session mastery decision. For skills that are tracked inside an <a href="/health/iep-goal-calculator">IEP goal mastery tracking</a> framework, the IEP calculator adds goal-period elapsed time and projected mastery date.</p>
      <p>Enter each session's C/P/I/NR counts in the "Across sessions" mode. The table shows each session's % correct and whether the criterion was met. The result card updates instantly and identifies the session at which mastery was first achieved - or shows how close the learner is to the consecutive streak required.</p>
      <blockquote class="blockquote-observation">
      <p>I use this calculator daily to track mastery across sessions and ensure that learners are truly acquiring skills independently. I love it!</p>
      </blockquote>
      <h2 id="common-mistakes">What are the most common DTT data recording mistakes?</h2>
      <p>Data quality determines program quality. The errors below appear in the ABA supervision literature (Cooper et al., 2020) and show up regularly in RBT data review. Each error produces numbers that look valid but lead to wrong clinical decisions.</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Mistake</th><th>What goes wrong</th><th>Fix</th></tr>
          </thead>
          <tbody>
            <tr><td>Recording prompted as correct</td><td>Inflates % correct; learner advances prematurely</td><td>Always record prompted (P) separately from correct (C)</td></tr>
            <tr><td>Averaging sessions instead of requiring consecutive</td><td>A bad session hidden by averaging; mastery declared too early</td><td>Require N consecutive sessions - no averaging</td></tr>
            <tr><td>Inconsistent response interval</td><td>Some technicians wait 5 seconds, others 3 - NR rate varies by staff</td><td>Define response interval in the behavior plan and train all staff</td></tr>
            <tr><td>Recording after the session from memory</td><td>Recency bias; miscount of trials</td><td>Record each trial immediately on the data sheet during the session</td></tr>
            <tr><td>Changing criteria mid-program</td><td>Mastery becomes a moving target; data comparability lost</td><td>Set mastery criterion before data collection begins</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="faq">Frequently asked questions about DTT data</h2>
      <h3>What is percent correct in DTT?</h3>
      <p>Percent correct in DTT is the number of independent correct trials divided by the total number of trials, multiplied by 100. Only trials the learner completes without any prompt count as independent. Prompted trials are tracked separately and do not count toward mastery.</p>
      <h3>What is a mastery criterion in ABA?</h3>
      <p>A mastery criterion is the performance standard a learner must meet before a program is considered complete. The most common standard is 80% independent correct across 3 consecutive sessions. Some programs use 90% across 2 consecutive sessions for skills requiring higher reliability, like communication or safety behaviors.</p>
      <h3>Should prompted trials count toward percent correct?</h3>
      <p>No. Prompted trials should be tracked separately and not counted as independent correct. Including prompted responses inflates the score and can lead to advancing a program before the learner truly has the skill. The whole purpose of prompt fading is to reach independent responding.</p>
      <h3>How many trials per session does DTT require?</h3>
      <p>Most ABA programs use 10 trials per session as a standard block. Five to 20 trials are common depending on the skill and the learner's endurance. Cooper et al. (2020) note there's no universal rule - trial density should match the learner's response requirements and the skill's complexity.</p>
      <h3>What is prompt dependency in DTT?</h3>
      <p>Prompt dependency occurs when a learner waits for a prompt instead of responding to the SD alone. It's caused by prompts delivered too quickly or not faded systematically. It shows up in data as consistently high prompted trials alongside low independent correct percentages - exactly what this calculator's two-line output is designed to reveal.</p>
      <QuizBlock
        topic="DTT data"
        questions={quizQuestions}
        pageUrl="https://calculations.tools/health/dtt-data-calculator"
      />
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">📊</span>
          <div>
            <a href="/health/aba-behavior-rate-calculator">ABA Behavior Rate Calculator</a>
            <p>Calculate frequency rate, duration percentage, and latency for behavioral data - the within-session complement to this tool's across-session mastery tracking.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">📋</span>
          <div>
            <a href="/health/iep-goal-calculator">IEP Goal Progress Calculator</a>
            <p>Track IEP goal accuracy and mastery streaks across sessions - the natural next step once DTT data confirms a skill is ready to be written as an IEP goal.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">🧠</span>
          <div>
            <a href="/health/adhd-break-calculator">ADHD Break Calculator</a>
            <p>Generate focus blocks and break intervals for ADHD - useful for structuring the session schedule around DTT instruction blocks.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">🌱</span>
          <div>
            <a href="/health/child-developmental-age-calculator">Child Developmental Age Calculator</a>
            <p>Estimate developmental age across 5 domains from milestone checklists - shows which skill areas a child is ready for DTT instruction vs. which need foundational work first.</p>
          </div>
        </li>
      </ul>
      <RelatedGlossaryTerms toolPath="/health/dtt-data-calculator" />
    </div>
  </div>
</CalculatorLayout>