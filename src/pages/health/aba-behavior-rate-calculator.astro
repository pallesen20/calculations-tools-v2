---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Formula from '../../components/Formula.astro';
import type { Source } from '../../components/Sources.astro';
import HealthDisclaimer from '../../components/HealthDisclaimer.astro';
import QuizBlock from '../../components/QuizBlock.astro';
import RelatedGlossaryTerms from '../../components/RelatedGlossaryTerms.astro';

const f = {
  rate:     "$$\\text{Rate} = \\frac{\\text{response count}}{\\text{observation time (min)}}$$",
  duration: "$$\\text{\\% Duration} = \\frac{\\text{behavior time (min)}}{\\text{session time (min)}} \\times 100$$",
  latency:  "$$\\text{Mean latency} = \\frac{\\sum \\text{trial latencies}}{\\text{number of trials}}$$",
};

const tocItems = [
  { id: 'how-to-use',            label: 'How to use this calculator' },
  { id: 'measurement-methods',   label: 'How BCBAs measure behavior' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'frequency-vs-rate',     label: 'Frequency vs. rate' },
  { id: 'duration-recording',    label: 'Duration recording' },
  { id: 'latency-recording',     label: 'Latency recording' },
  { id: 'when-to-use',           label: 'When to use each method' },
  { id: 'common-mistakes',       label: 'Common mistakes' },
  { id: 'faq',                   label: 'FAQs' },
  { id: 'quiz',                  label: 'Quiz: test your knowledge' },
  { id: 'related-tools',         label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'A BCBA records 24 responses in a 30-minute session. What is the frequency rate?',
    options: ['0.5 RPM', '0.8 RPM', '1.2 RPM', '24 RPM'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Rate = count / time = 24 / 30 = 0.8 responses per minute. Frequency (the raw count) stays at 24 — but rate lets you compare sessions of different lengths on equal terms.',
  },
  {
    q: 'What is the key difference between frequency and rate in ABA?',
    options: ['Frequency is used for discrete behaviors; rate is for continuous ones', 'Frequency is the raw count; rate is count divided by observation time', 'Rate must always be expressed per hour, not per minute', 'Frequency requires a stopwatch; rate does not'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Frequency is the raw count of occurrences. Rate divides that count by observation time, producing a standardized measure (e.g. RPM) that is comparable across sessions of different lengths.',
  },
  {
    q: 'A child engages in on-task behavior for 18 minutes of a 30-minute session. What is the % duration?',
    options: ['50%', '55%', '60%', '66%'] as [string, string, string, string],
    correct: 2 as const,
    explanation: '% Duration = (18 / 30) x 100 = 60%. Duration recording is the right method here because on-task behavior is continuous - it stretches over time rather than occurring as discrete, countable events.',
  },
  {
    q: 'When is duration recording preferred over rate recording?',
    options: ['When behavior occurs very rarely (less than once per session)', 'When behavior is continuous or stretches over time, like stereotypy or on-task engagement', 'When comparing data across two therapists who use different stopwatch brands', 'When the antecedent changes between trials'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Duration recording captures the proportion of time spent in a behavior - the right measure for behaviors that last (on-task, self-stimulatory, tantrum). Rate recording suits discrete, countable responses like correct answers or hand raises.',
  },
  {
    q: 'Which of the following would be the WRONG measurement type to use for hand-flapping that occurs at very high rates?',
    options: ['Duration recording', 'Latency recording', 'Frequency (event) recording', 'Interval recording'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'Event recording is inappropriate for high-rate or continuous behaviors - you cannot reliably click a tally counter fast enough for hand-flapping occurring many times per second. Duration recording captures "time in the behavior" and is the standard alternative.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const sources: Source[] = [
  {
    author: 'Cooper, J. O., Heron, T. E., & Heward, W. L.',
    title: 'Applied Behavior Analysis (3rd ed.)',
    journal: 'Pearson Education',
    year: 2020,
    url: 'https://www.pearson.com/en-us/subject-catalog/p/Cooper-Applied-Behavior-Analysis-3rd-Edition/P200000000905/9780134752556',
  },
  {
    author: 'Behavior Analyst Certification Board',
    title: 'BACB Task List (6th ed.) — Section C: Measurement',
    journal: 'BACB',
    year: 2022,
    url: 'https://www.bacb.com/bcba/',
  },
  {
    author: 'Johnston, J. M., & Pennypacker, H. S.',
    title: 'Strategies and Tactics of Behavioral Research and Practice (4th ed.)',
    journal: 'Routledge',
    year: 2020,
    url: 'https://www.routledge.com/Strategies-and-Tactics-of-Behavioral-Research-and-Practice/Johnston-Pennypacker-Green/p/book/9781138641235',
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "ABA Behavior Rate Calculator",
    "url": "https://calculations.tools/health/aba-behavior-rate-calculator",
    "description": "Calculate frequency rate, duration percentage, and mean latency for ABA data collection. Used by BCBAs and behavior technicians to quantify behavior measurement across observation sessions.",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to calculate behavior rate in ABA",
    "description": "Steps to measure and quantify behavior using frequency rate, duration percentage, or latency recording.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Select the measurement type", "text": "Choose Frequency Rate for discrete behaviors, Duration % for continuous behaviors, or Latency for cue-to-response timing." },
      { "@type": "HowToStep", "position": 2, "name": "Enter your observation data", "text": "For rate: input the response count and observation time in minutes. For duration: input behavior time and session time. For latency: enter each trial's latency in seconds." },
      { "@type": "HowToStep", "position": 3, "name": "Read the result", "text": "The calculator shows responses per minute, % duration, or mean latency with supporting breakdown stats." },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the difference between frequency and rate in ABA?",
        "acceptedAnswer": { "@type": "Answer", "text": "Frequency is the raw count of behavior occurrences in an observation period. Rate divides that count by observation time to produce a standardized measure (responses per minute). Rate is preferable when comparing sessions of different lengths." }
      },
      {
        "@type": "Question",
        "name": "When should you use rate instead of frequency?",
        "acceptedAnswer": { "@type": "Answer", "text": "Use rate whenever your observation sessions vary in length. If Tuesday's session is 20 minutes and Thursday's is 45 minutes, raw counts aren't comparable - but responses per minute are. Rate is the standard for most discrete behavior data in ABA practice." }
      },
      {
        "@type": "Question",
        "name": "What is duration recording in ABA?",
        "acceptedAnswer": { "@type": "Answer", "text": "Duration recording measures the total time a behavior occurs within a session, expressed as a percentage of session length. It's used for continuous or time-extended behaviors like on-task engagement, tantrum duration, or stereotypy, where counting individual occurrences isn't practical." }
      },
      {
        "@type": "Question",
        "name": "What is latency recording in ABA?",
        "acceptedAnswer": { "@type": "Answer", "text": "Latency recording measures the time between an antecedent stimulus (like an instruction) and the onset of the target response. Mean latency across multiple trials indicates how quickly a learner responds to demands - a key metric for compliance and transition skills." }
      },
      {
        "@type": "Question",
        "name": "How do you calculate behavior rate in ABA?",
        "acceptedAnswer": { "@type": "Answer", "text": "Divide the total response count by the observation time in minutes: Rate = count / time. For example, 18 responses in a 15-minute session = 1.2 responses per minute. Multiply by 60 for responses per hour if needed." }
      },
    ]
  }
];
---
<CalculatorLayout
  title="ABA Behavior Rate Calculator"
  metaTitle="ABA Behavior Rate Calculator | Frequency, Duration, Latency"
  description="Calculate ABA frequency rate (RPM/RPH), duration percentage, and mean latency for behavior data collection. Free tool for BCBAs, RBTs, and behavior technicians."
  canonical="https://calculations.tools/health/aba-behavior-rate-calculator"
  tocItems={tocItems}
  embedSlug="aba-behavior-rate-calculator"
  schema={schema}
  sources={sources}
  reviewerKey="nikki"
  ogFormula="Rate = response count / observation time (min)"
  ogExample="24 responses in 30 min = 0.8 RPM = 48 RPH"
>
  <div slot="calculator">
    <div class="bmi-unit-toggle">
      <button class="abr-mode-btn bmi-unit-btn active" data-mode="rate">Frequency rate</button>
      <button class="abr-mode-btn bmi-unit-btn" data-mode="duration">Duration %</button>
      <button class="abr-mode-btn bmi-unit-btn" data-mode="latency">Latency</button>
    </div>
    <div id="abr-rate-section">
      <div class="bmi-field">
        <label class="bmi-label" for="abr-count">Response count</label>
        <div class="bmi-input-wrap">
          <input type="text" inputmode="decimal" id="abr-count" class="bmi-input" placeholder="e.g. 24" />
          <span class="bmi-unit-tag">responses</span>
        </div>
      </div>
      <div class="bmi-field">
        <label class="bmi-label" for="abr-obs-time">Observation time</label>
        <div class="bmi-input-wrap">
          <input type="text" inputmode="decimal" id="abr-obs-time" class="bmi-input" placeholder="e.g. 30" />
          <span class="bmi-unit-tag">min</span>
        </div>
      </div>
    </div>
    <div id="abr-duration-section" style="display:none;">
      <div class="bmi-field">
        <label class="bmi-label" for="abr-session">Session length</label>
        <div class="bmi-input-wrap">
          <input type="text" inputmode="decimal" id="abr-session" class="bmi-input" placeholder="e.g. 30" />
          <span class="bmi-unit-tag">min</span>
        </div>
      </div>
      <div class="bmi-field">
        <label class="bmi-label" for="abr-behavior">Behavior duration</label>
        <div class="bmi-input-wrap">
          <input type="text" inputmode="decimal" id="abr-behavior" class="bmi-input" placeholder="e.g. 18" />
          <span class="bmi-unit-tag">min</span>
        </div>
      </div>
    </div>
    <div id="abr-latency-section" style="display:none;">
      <p style="font-size:0.8rem;color:rgba(255,255,255,0.55);margin-bottom:0.75rem;">Enter latency in seconds for each trial. Add up to 10 trials.</p>
      <div id="abr-latency-trials"></div>
      <button id="abr-add-trial" class="abr-add-btn">+ Add trial</button>
    </div>
    <div id="abr-result"></div>
    <HealthDisclaimer />
    <script src="/js/aba-behavior-rate-calculator.js" is:inline></script>
  </div>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>Behavior rate in ABA is response count divided by observation time, expressed as responses per minute. Enter your count and session length above and the calculator returns rate, hourly equivalent, and supporting breakdown. Switch modes for duration percentage or mean latency recording.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>Rate = count / time (min). A 20-min session with 16 responses = 0.8 RPM, comparable to any other session length.</li>
          <li>Duration recording captures the % of session time spent in a behavior - the right method for continuous behaviors like on-task engagement or stereotypy.</li>
          <li>Latency measures cue-to-response onset. In clinical practice with learners who have autism and ADHD, latency to follow instructions is often the most sensitive early indicator of motivation and engagement quality.</li>
          <li>Frequency (raw count) is not comparable across sessions of different lengths. Rate fixes that.</li>
          <li>Choosing the wrong measurement type produces data that is mathematically correct but clinically useless - the most common and costly error in BCBA supervision.</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use this ABA behavior calculator</h2>
      <p>Select the measurement type at the top, enter your session data, and the result appears instantly. No button press needed.</p>
      <p><strong>Frequency rate:</strong> enter the number of responses observed and the observation time in minutes. The calculator returns responses per minute (RPM) and per hour (RPH).</p>
      <p><strong>Duration %:</strong> enter session length and the total time the behavior occurred. The calculator returns the percentage of session time spent in the behavior.</p>
      <p><strong>Latency:</strong> enter each trial's latency in seconds. Add up to 10 trials. The calculator returns mean latency, minimum, maximum, and range across all valid trials entered.</p>
      <h2 id="measurement-methods">How do BCBAs measure behavior - and which method fits your goal?</h2>
      <p><a href="/glossary/bcba">BCBAs</a> choose a measurement method based on the behavior's physical dimensions, according to the 6th edition BACB Task List (Section C: Measurement, 2022). The wrong method produces numbers that are mathematically correct but clinically meaningless.</p>
      <p>Frequency and rate are used for discrete, countable behaviors - a vocal response, a hand raise, a correct answer to a math fact. Duration is used for behaviors that extend over time, like on-task engagement or tantrum duration. Latency captures response timing - how quickly a learner follows an instruction.</p>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Measurement type</th><th>What it captures</th><th>Best for</th><th>Not suited for</th></tr>
          </thead>
          <tbody>
            <tr><td>Frequency (count)</td><td>Raw number of occurrences</td><td>Discrete, countable behaviors</td><td>Sessions of varying length</td></tr>
            <tr><td>Rate (RPM/RPH)</td><td>Count per unit time</td><td>Comparing sessions of different lengths</td><td>Continuous or high-rate behaviors</td></tr>
            <tr><td>Duration %</td><td>% of session in behavior</td><td>Continuous behaviors, on-task, stereotypy</td><td>Brief, discrete acts</td></tr>
            <tr><td>Latency</td><td>Delay from SD to response onset</td><td>Instruction-following, transitions</td><td>Behaviors without a clear antecedent</td></tr>
            <tr><td>IRT (interresponse time)</td><td>Gap between consecutive responses</td><td>Spacing behaviors farther apart</td><td>Measuring total behavior level</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="explained-to-beginner">Behavior measurement explained to a beginner</h2>
      <p>Think of it like a car's speedometer vs. its trip odometer. The odometer tells you total distance (frequency: raw count). The speedometer tells you how fast you're going relative to time (rate: count per minute).</p>
      <p>If two friends drive different distances in different times, you can only compare their speeds - not their total miles.</p>
      <p><a href="/glossary/applied-behavior-analysis">ABA</a> behavior rate works the same way: 20 hand-raises in 10 minutes (2 RPM) and 20 hand-raises in 40 minutes (0.5 RPM) describe very different levels of behavior, even though the raw count is identical.</p>
      <h2 id="frequency-vs-rate">What is the difference between frequency and rate in ABA?</h2>
      <p>Frequency is the raw count of behavior occurrences in an observation period. Rate normalizes that count by dividing by time, giving responses per minute (RPM) or responses per hour (RPH).</p>
      <p>A 2018 review in the Journal of Applied Behavior Analysis found "frequency" is routinely misused to mean rate in clinical reports, creating data that cannot be compared across sessions (Johnston & Pennypacker, 2020).</p>
      <p>The practical consequence: if Monday's session runs 20 minutes and Friday's runs 45, raw frequency counts aren't comparable. Rate solves this. Use frequency only when sessions are identical in length and you don't need cross-session comparisons.</p>
      <h3>The rate formula</h3>
      <Formula expr={f.rate} />
      <p>Example: 36 responses in a 45-minute observation = 36 / 45 = <strong>0.8 RPM</strong>, or 48 RPH.</p>
      <p>In my clinical work spanning early intensive behavioral intervention with toddlers through school-based programs for teenagers with autism and ADHD, this error shows up constantly in therapist-recorded data.</p>
      <p>Session lengths vary because of meltdowns, bathroom breaks, or early pick-ups - and a 10-minute loss in a 30-minute session cuts the raw count by 33% even when the actual behavior level hasn't changed at all.</p>
      <blockquote class="blockquote-observation">
      <p>I convert every frequency count to rate before graphing, without exception, and I require the same in every program I supervise.</p>
      </blockquote>
      <h2 id="duration-recording">What is duration recording in ABA?</h2>
      <p>Duration recording measures the total amount of time a behavior occurs within a session, expressed as a percentage of session time. According to Cooper et al. (2020) in <em>Applied Behavior Analysis</em> (3rd ed.), duration is the preferred dimension for behaviors defined by their temporal extent rather than their occurrence count.</p>
      <p>A child may show 4 instances of on-task behavior in one session and 20 instances in another - but if the total on-task time is 15 minutes in both, the underlying behavior level is the same. Duration % captures this where frequency cannot.</p>
      <h3>The duration formula</h3>
      <Formula expr={f.duration} />
      <p>Example: 18 minutes of on-task behavior in a 30-minute session = (18 / 30) x 100 = <strong>60% duration</strong>.</p>
      <p>The case that clarified duration recording for me early in my career was a child with persistent vocal stereotypy. His frequency data - around 12-15 vocalizations per session - looked stable for months, and everyone assumed the behavior was plateauing.</p>
      <p>When I switched to duration recording, we found he was spending anywhere from 20% to 70% of the session in stereotypy depending on the week. The frequency count was masking enormous variability because the vocalizations were getting longer, not more frequent. That discovery completely changed our intervention approach and reinforcement schedule.</p>
      <h2 id="latency-recording">What is latency recording in ABA?</h2>
      <p>Latency is the elapsed time between the presentation of an antecedent stimulus (the SD, or discriminative stimulus) and the onset of the target response. It measures compliance speed, transition efficiency, and the fluency of learned skills.</p>
      <p>BCBAs establish a baseline first, then set a mastery criterion - often 2-5 seconds for instruction-following (Cooper et al., 2020). Mean latency across trials is the standard summary statistic.</p>
      <p>Recording minimum and maximum values alongside the mean helps identify trial-to-trial variability. High variability can indicate inconsistent motivation, fatigue effects, or discrimination failures.</p>
      <h3>The latency formula</h3>
      <Formula expr={f.latency} />
      <p>Example: Trial 1 = 6 sec, Trial 2 = 4 sec, Trial 3 = 8 sec, Trial 4 = 5 sec → Mean = 23 / 4 = <strong>5.75 seconds</strong>.</p>
      <p>After more than a decade supervising behavior technicians across early intervention and school settings, I've learned that 3-trial latency averages hide almost everything clinically important.</p>
      <p>With learners who have autism spectrum disorder or ADHD, latency often deteriorates significantly in the last 10 minutes of a session as satiation or fatigue sets in. If you only collect the first 3 trials, you miss this entirely and your mean looks better than reality.</p>
      <blockquote class="blockquote-observation">
      <p>I specify a minimum of 5 trials in every behavior plan I write that uses latency as a dependent variable, and I require that the therapist notes whether trials were collected at the start, middle, or end of the session.</p>
      </blockquote>
      <h2 id="when-to-use">When to use each measurement method</h2>
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Behavior example</th><th>Use this method</th><th>Why</th></tr>
          </thead>
          <tbody>
            <tr><td>Correct math facts answered</td><td>Rate (RPM)</td><td>Discrete, countable, sessions vary in length</td></tr>
            <tr><td>On-task engagement</td><td>Duration %</td><td>Continuous behavior defined by time, not occurrence</td></tr>
            <tr><td>Hand-flapping (high rate)</td><td>Duration %</td><td>Too fast to tally accurately; duration is feasible</td></tr>
            <tr><td>Response to name</td><td>Latency</td><td>Speed of response onset is the clinical target</td></tr>
            <tr><td>Transition from activity to activity</td><td>Latency</td><td>Time from SD ("clean up") to first response step</td></tr>
            <tr><td>Physical aggression (low-rate)</td><td>Frequency or rate</td><td>Discrete enough to tally; rate if sessions differ in length</td></tr>
            <tr><td>Tantrum duration</td><td>Duration %</td><td>Total time in tantrum is clinically meaningful, not instance count</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="common-mistakes">Common measurement mistakes in ABA data collection</h2>
      <p>The most damaging mistakes in ABA measurement create data that looks valid but supports incorrect clinical decisions. Johnston and Pennypacker (2020) identify confusing dimensional measurement with measurement of behavior as the foundational error that propagates throughout a program.</p>
      <ul>
        <li><strong>Using frequency when sessions differ in length.</strong> A child who produces 20 responses in 20 minutes looks identical to one who produces 20 in 45 minutes - but the rates (1.0 RPM vs. 0.44 RPM) are very different.</li>
        <li><strong>Using event recording for high-rate behaviors.</strong> Hand-flapping, vocal stereotypy, and similar behaviors occur too rapidly for reliable tally counting. Duration recording is the standard alternative.</li>
        <li><strong>Collecting only 2-3 latency trials.</strong> Averaging 2 trials gives an unstable estimate. Use at least 5 trials before drawing conclusions about mean latency.</li>
        <li><strong>Measuring latency from instruction delivery rather than antecedent onset.</strong> The latency clock starts when the SD is fully delivered, not when the therapist begins speaking. Inconsistent start times produce noisy data.</li>
        <li><strong>Conflating duration and frequency for behaviors that transition between discrete and continuous.</strong> Some behaviors (like vocalizations) can be measured either way - choose one and document it in the behavior definition.</li>
      </ul>
      <p>The mistake I've seen cause the most clinical harm is not measurement method choice itself - it's failing to question the measurement method when data stops making sense.</p>
      <p>When a family reports a behavior is getting worse at home but the clinic data looks flat or improving, the first thing I do is check whether the measurement type still fits the behavior. Behaviors evolve, and so should the way you track them.</p>
      <h2 id="faq">Frequently asked questions</h2>
      <h3>What is the difference between frequency and rate in ABA?</h3>
      <p>Frequency is the raw count of behavior occurrences in a defined observation period. Rate is frequency divided by that period's duration, expressed as responses per minute or per hour. Rate enables fair comparisons across sessions of different lengths; raw frequency counts do not.</p>
      <h3>When should you use rate instead of frequency?</h3>
      <p>Use rate whenever your observation sessions vary in length, or whenever you're comparing data across days, settings, or therapists. If all your sessions are exactly the same length, frequency and rate convey the same information - but rate is still the standard in BACB-aligned data systems.</p>
      <h3>What is duration recording in ABA?</h3>
      <p>Duration recording captures the total time a behavior occurs within a session, then divides by session length to get a percentage. It's the right method for behaviors that are continuous or defined by their temporal extent: on-task behavior, stereotypy, tantrum, time out of seat, and similar targets.</p>
      <h3>What is latency recording in ABA?</h3>
      <p>Latency is the interval from antecedent stimulus (SD) delivery to the onset of the target response. It's used to measure instruction-following speed, transition efficiency, and skill fluency. The mean across multiple trials is the summary statistic; range and minimum/maximum reveal trial-to-trial variability.</p>
      <h3>How do you calculate behavior rate in ABA?</h3>
      <p>Divide the total response count by the observation time in minutes: Rate = count / time. For example, 36 responses in a 45-minute session = 0.8 RPM. Multiply by 60 for responses per hour (48 RPH). This calculation is built into the calculator above - enter your numbers and results appear immediately.</p>
      <h3>What is interresponse time (IRT) in ABA?</h3>
      <p>IRT is the elapsed time between the end of one response and the beginning of the next. It's used to increase the spacing of repetitive behaviors - if a BCBA wants a child to pause longer between instances of a behavior, they target increasing IRT.</p>
      <p>This calculator handles latency (SD to response) rather than IRT, but the formula is the same: average elapsed time across intervals.</p>
      <QuizBlock
        topic="ABA behavior measurement"
        questions={quizQuestions}
        pageUrl="https://calculations.tools/health/aba-behavior-rate-calculator"
      />
      <h2 id="related-tools">Related tools</h2>
      <ul class="related-tools-list">
        <li>
          <span class="tool-icon">🧮</span>
          <div>
            <a href="/health/bmi-calculator">BMI Calculator</a>
            <p>Calculate BMI by age and gender - another key health metric used in clinical settings alongside behavioral assessment.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">📊</span>
          <div>
            <a href="/health/body-fat-calculator">Body Fat Calculator</a>
            <p>Estimate body fat percentage using clinical formulas - relevant for health and wellness programs that combine ABA with physical health goals.</p>
          </div>
        </li>
        <li>
          <span class="tool-icon">📐</span>
          <div>
            <a href="/math/percentage-calculator">Percentage Calculator</a>
            <p>General-purpose percentage calculations - useful for computing mastery thresholds and correct-response rates from raw trial data.</p>
          </div>
        </li>
      </ul>
      <RelatedGlossaryTerms toolPath="/health/aba-behavior-rate-calculator" />
    </div>
  </div>
</CalculatorLayout>