---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import HealthDisclaimer from '../../components/HealthDisclaimer.astro';
import QuizBlock from '../../components/QuizBlock.astro';
import type { Source } from '../../components/Sources.astro';
import RelatedGlossaryTerms from '../../components/RelatedGlossaryTerms.astro';

const tocItems = [
  { id: 'how-to-use',          label: 'How to use this calculator' },
  { id: 'how-due-date-works',  label: 'How due date calculation works' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'calculation-methods', label: 'Calculation methods compared' },
  { id: 'gestational-age',     label: 'What is gestational age?' },
  { id: 'fetal-development',   label: 'Fetal development by trimester' },
  { id: 'accuracy',            label: 'How accurate is your due date?' },
  { id: 'faq',                 label: 'FAQs' },
  { id: 'quiz',                label: 'Quiz: test your knowledge' },
  { id: 'related-tools',       label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'How many days does a standard pregnancy last from the last menstrual period (LMP)?',
    options: ['266 days', '280 days', '270 days', '294 days'] as [string, string, string, string],
    correct: 1 as const,
    explanation: '280 days (40 weeks) is the standard pregnancy length counted from the first day of the last menstrual period. This is Naegele\'s rule: LMP + 280 days = EDD. Conception itself occurs about 14 days into that window, so fetal age is about 266 days (38 weeks).',
  },
  {
    q: 'If you transfer a Day-5 blastocyst via IVF, what gestational age does your doctor assign on transfer day?',
    options: ['0 weeks, 0 days', '2 weeks, 0 days', '2 weeks, 5 days', '3 weeks, 2 days'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'On the day of a Day-5 embryo transfer, your gestational age is 2 weeks + 5 days (19 days). This is because gestational age counts from an equivalent LMP, which is set 14 days before fertilization - so the 5 days of embryo culture add to that base.',
  },
  {
    q: 'Which due date method is considered the most accurate?',
    options: ['LMP with a 28-day cycle', 'First-trimester ultrasound (crown-rump length)', 'Conception date', 'IVF transfer date'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'First-trimester ultrasound measuring crown-rump length (CRL) is the most accurate dating method, with a margin of error of only 5-7 days. It accounts for natural variation in ovulation timing that LMP-based calculations cannot. ACOG recommends adjusting the due date if ultrasound differs by more than 7 days from LMP dating.',
  },
  {
    q: 'What percentage of babies are actually born on their estimated due date?',
    options: ['About 30%', 'About 15%', 'About 5%', 'About 50%'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'Only about 5% of babies are born on their exact due date. Most full-term deliveries happen within a 2-week window around the EDD. A baby is considered full term from week 37 and post-term at week 42, when induction is typically offered.',
  },
  {
    q: 'When does the second trimester begin?',
    options: ['Week 12', 'Week 13', 'Week 14', 'Week 16'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'The second trimester begins at week 14 and runs through week 27. Week 13 is the last week of the first trimester. This is a common point of confusion - many people say "end of first trimester = 12 weeks" but the second trimester does not technically start until week 14.',
  },
];

const sources: Source[] = [
  {
    author: 'Cleveland Clinic',
    title: 'Due Date Calculator: How Many Weeks Pregnant Are You?',
    journal: 'Cleveland Clinic Health Library',
    year: 2024,
    url: 'https://my.clevelandclinic.org/health/diagnostics/22052-due-date-calculator',
  },
  {
    author: 'Delpachitra S, Townend K, Tamblyn J, Elwood D',
    title: 'Ultrasound Reference Chart Based on IVF Dates to Estimate Gestational Age at 6-9 Weeks Gestation',
    journal: 'ISRN Obstetrics and Gynecology',
    year: 2012,
    url: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC3409520/',
  },
  {
    author: 'Chen M, Wang J, Sun L, et al.',
    title: 'Reference intervals of gestational sac, yolk sac, embryonic length and heart rate at 6-10 weeks after IVF-embryo transfer',
    journal: 'BMC Pregnancy and Childbirth',
    year: 2020,
    url: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC7488996/',
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Pregnancy Calculator",
    "url": "https://calculations.tools/health/pregnancy-calculator",
    "description": "Free pregnancy calculator that estimates due date and gestational age from last menstrual period, conception date, known due date, ultrasound measurements, or IVF transfer date.",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Your Due Date",
    "description": "Estimate your pregnancy due date and gestational age using your last menstrual period, conception date, ultrasound, or IVF transfer date.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Select calculation method", "text": "Choose from Last Period, Conception Date, Due Date, Ultrasound, or IVF Transfer Date." },
      { "@type": "HowToStep", "position": 2, "name": "Enter your date", "text": "Enter the relevant date for your chosen method. For ultrasound, also enter your gestational age at the scan. For IVF, select embryo age (Day 3, 5, or 6)." },
      { "@type": "HowToStep", "position": 3, "name": "Review your results", "text": "The calculator instantly shows your estimated due date, current gestational age, trimester, days remaining, fetal size, and key upcoming milestones." },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How is the due date calculated from the last period?",
        "acceptedAnswer": { "@type": "Answer", "text": "Using Naegele's rule, the due date is calculated by adding 280 days (40 weeks) to the first day of your last menstrual period (LMP). This assumes a standard 28-day cycle with ovulation on day 14. If your cycle is longer or shorter, the due date is adjusted accordingly." }
      },
      {
        "@type": "Question",
        "name": "What is gestational age?",
        "acceptedAnswer": { "@type": "Answer", "text": "Gestational age is the age of the pregnancy counted from the first day of the last menstrual period, not from the date of conception. A full-term pregnancy is 40 weeks of gestational age. This is why gestational age is always about 2 weeks more than the actual age of the embryo or fetus." }
      },
      {
        "@type": "Question",
        "name": "How accurate is an ultrasound due date?",
        "acceptedAnswer": { "@type": "Answer", "text": "A first-trimester ultrasound measuring crown-rump length is accurate to within 5-7 days. ACOG recommends adjusting the LMP-based due date if ultrasound dating differs by more than 7 days in the first trimester, 10 days in the second trimester, or 14 days in the third trimester." }
      },
      {
        "@type": "Question",
        "name": "How does IVF affect the due date calculation?",
        "acceptedAnswer": { "@type": "Answer", "text": "For IVF pregnancies, the due date is calculated from the embryo transfer date and the embryo's age at transfer. A Day-5 blastocyst transfer means gestational age on transfer day is 2 weeks and 5 days; a Day-3 transfer gives 2 weeks and 3 days. IVF due dates are generally more accurate since fertilization timing is precisely known." }
      },
      {
        "@type": "Question",
        "name": "What percentage of babies are born on their due date?",
        "acceptedAnswer": { "@type": "Answer", "text": "Only about 5% of babies are born on their exact estimated due date. Most full-term deliveries happen within a 2-week window around the EDD. A pregnancy is considered full term from week 37 and post-term at week 42, at which point induction is typically offered." }
      }
    ]
  }
];
---
<CalculatorLayout
  title="Pregnancy Calculator"
  metaTitle="Pregnancy Calculator - Due Date & Gestational Age ᐅ"
  description="Calculate your pregnancy due date and gestational age from last period, conception date, due date, ultrasound, or IVF transfer. See fetal size and key milestones."
  canonical="https://calculations.tools/health/pregnancy-calculator"
  tocItems={tocItems}
  embedSlug="pregnancy-calculator"
  schema={schema}
  sources={sources}
  ogFormula="Due Date = LMP + 280 days (Naegele's Rule)"
  ogExample="LMP March 1 + 280 days = Due Date December 5"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container preg-container">
        <div class="calculator-header">
          <h2>Calculate Due Date and Gestational Age</h2>
          <p>Calculate from last period, conception, due date, ultrasound, or IVF</p>
        </div>
        <div class="preg-tabs" role="tablist">
          <button class="preg-tab active" data-mode="lmp" role="tab" aria-selected="true">Last Period</button>
          <button class="preg-tab" data-mode="conception" role="tab" aria-selected="false">Conception</button>
          <button class="preg-tab" data-mode="due-date" role="tab" aria-selected="false">Due Date</button>
          <button class="preg-tab" data-mode="ultrasound" role="tab" aria-selected="false">Ultrasound</button>
          <button class="preg-tab" data-mode="ivf" role="tab" aria-selected="false">IVF Transfer</button>
        </div>
        <div class="preg-inputs">
          <div class="preg-mode active" id="preg-mode-lmp">
            <div class="bmi-field">
              <label class="bmi-label" for="preg-lmp-date">First day of last menstrual period</label>
              <input type="date" id="preg-lmp-date" class="bmi-input" />
            </div>
            <div class="bmi-field">
              <label class="bmi-label" for="preg-cycle">Average cycle length</label>
              <div class="bmi-input-wrap">
                <input type="text" inputmode="decimal" id="preg-cycle" class="bmi-input" value="28" />
                <span class="bmi-unit-tag">days</span>
              </div>
            </div>
          </div>
          <div class="preg-mode" id="preg-mode-conception">
            <div class="bmi-field">
              <label class="bmi-label" for="preg-conception-date">Conception date</label>
              <input type="date" id="preg-conception-date" class="bmi-input" />
            </div>
          </div>
          <div class="preg-mode" id="preg-mode-due-date">
            <div class="bmi-field">
              <label class="bmi-label" for="preg-known-due">Your known due date</label>
              <input type="date" id="preg-known-due" class="bmi-input" />
            </div>
          </div>
          <div class="preg-mode" id="preg-mode-ultrasound">
            <div class="bmi-field">
              <label class="bmi-label" for="preg-us-date">Ultrasound date</label>
              <input type="date" id="preg-us-date" class="bmi-input" />
            </div>
            <div class="bmi-field">
              <label class="bmi-label">Gestational age shown at scan</label>
              <div class="bmi-ftin">
                <div class="bmi-input-wrap">
                  <input type="text" inputmode="decimal" id="preg-us-weeks" class="bmi-input" placeholder="22" />
                  <span class="bmi-unit-tag">wks</span>
                </div>
                <div class="bmi-input-wrap">
                  <input type="text" inputmode="decimal" id="preg-us-days" class="bmi-input" placeholder="0" />
                  <span class="bmi-unit-tag">days</span>
                </div>
              </div>
            </div>
          </div>
          <div class="preg-mode" id="preg-mode-ivf">
            <div class="bmi-field">
              <label class="bmi-label" for="preg-ivf-date">Embryo transfer date</label>
              <input type="date" id="preg-ivf-date" class="bmi-input" />
            </div>
            <div class="bmi-field">
              <label class="bmi-label">Embryo age at transfer</label>
              <div class="preg-age-btns">
                <button class="preg-age-btn" data-age="3">Day 3</button>
                <button class="preg-age-btn active" data-age="5">Day 5</button>
                <button class="preg-age-btn" data-age="6">Day 6</button>
              </div>
            </div>
          </div>
        </div>
        <div id="preg-result" class="preg-result hidden">
          <div class="preg-result-grid">
            <div class="preg-card preg-card-edd">
              <div class="preg-card-label">Estimated Due Date</div>
              <div class="preg-card-value" id="preg-edd">-</div>
            </div>
            <div class="preg-card">
              <div class="preg-card-label">Gestational Age</div>
              <div class="preg-card-value" id="preg-ga">-</div>
            </div>
            <div class="preg-card">
              <div class="preg-card-label">Trimester</div>
              <div class="preg-card-value" id="preg-trimester">-</div>
              <div class="preg-card-sub" id="preg-trimester-sub"></div>
            </div>
            <div class="preg-card">
              <div class="preg-card-label" id="preg-days-left-label">Days remaining</div>
              <div class="preg-card-value" id="preg-days-left">-</div>
            </div>
            <div class="preg-card">
              <div class="preg-card-label">Halfway Point</div>
              <div class="preg-card-value" id="preg-halfway">-</div>
              <div class="preg-card-sub" id="preg-halfway-sub"></div>
            </div>
          </div>
          <div class="preg-progress-wrap">
            <label class="bmi-label">How far along am I?</label>
            <div class="preg-progress-bar">
              <div class="preg-progress-fill" id="preg-progress-fill"></div>
            </div>
            <div class="preg-progress-label" id="preg-progress-label">0% complete</div>
          </div>
          <div class="preg-size-card hidden" id="preg-size-card">
            <div class="preg-size-emoji" id="preg-size-emoji">🍓</div>
            <div class="preg-size-info">
              <div class="preg-size-top">Baby is the size of <span id="preg-size-article">a</span></div>
              <div class="preg-size-name" id="preg-size-name">raspberry</div>
              <div class="preg-size-week" id="preg-size-week">at week 8</div>
              <div class="preg-size-detail" id="preg-size-detail">~16 mm · ~1 g</div>
            </div>
          </div>
          <div class="preg-section-label">Upcoming milestones</div>
          <div class="preg-timeline" id="preg-timeline"></div>
          <div class="preg-section-label" style="margin-top: 1.25rem;">Key dates</div>
          <div class="preg-dates-grid" id="preg-dates-grid"></div>
          <div class="preg-section-label" style="margin-top: 1.5rem;">How far along on a specific date?</div>
          <div class="bmi-field" style="margin-bottom: 0.6rem;">
            <input type="date" id="preg-lookup-date" class="bmi-input" />
          </div>
          <div id="preg-lookup-result"></div>
        </div>
      </div>
    </section>
    <HealthDisclaimer />
    <script src="/js/pregnancy-calculator.js" is:inline></script>
  </div>
  <style is:global>
    .preg-container {
      max-width: 600px;
    }
    .preg-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-bottom: 1.25rem;
    }
    .preg-tab {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      color: rgba(255,255,255,0.6);
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 500;
      padding: 0.35rem 0.75rem;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
      white-space: nowrap;
    }
    .preg-tab:hover {
      background: rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.85);
    }
    .preg-tab.active {
      background: rgba(167,139,250,0.18);
      border-color: rgba(167,139,250,0.4);
      color: rgba(167,139,250,1);
    }
    .preg-mode {
      display: none;
    }
    .preg-mode.active {
      display: block;
    }
    .preg-result {
      margin-top: 1.25rem;
    }
    .preg-result.hidden {
      display: none;
    }
    .preg-result-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    .preg-card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px;
      padding: 0.9rem 1rem;
    }
    .preg-card-edd {
      grid-column: 1 / -1;
      background: rgba(167,139,250,0.1);
      border-color: rgba(167,139,250,0.25);
    }
    .preg-card-label {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.45);
      margin-bottom: 0.3rem;
    }
    .preg-card-value {
      font-size: 1.25rem;
      font-weight: 700;
      color: #fff;
      line-height: 1.2;
    }
    .preg-card-edd .preg-card-value {
      font-size: 1.5rem;
      color: rgba(167,139,250,1);
    }
    .preg-card-sub {
      font-size: 0.72rem;
      color: rgba(255,255,255,0.45);
      margin-top: 0.2rem;
    }
    .preg-progress-wrap {
      margin-bottom: 1.25rem;
    }
    .preg-progress-bar {
      background: rgba(255,255,255,0.12);
      border-radius: 8px;
      height: 12px;
      overflow: hidden;
      margin-bottom: 0.35rem;
    }
    .preg-progress-fill {
      background: linear-gradient(90deg, rgba(139,92,246,0.9), rgba(167,139,250,1));
      border-radius: 8px;
      height: 100%;
      transition: width 0.4s ease;
      width: 0%;
      box-shadow: 0 0 10px rgba(167,139,250,0.45);
    }
    .preg-progress-label {
      font-size: 0.72rem;
      color: rgba(255,255,255,0.6);
      text-align: right;
    }
    .preg-size-card {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px;
      padding: 1rem 1.1rem;
      margin-bottom: 1.25rem;
    }
    .preg-size-card.hidden {
      display: none;
    }
    .preg-size-emoji {
      font-size: 2.5rem;
      line-height: 1;
      flex-shrink: 0;
    }
    .preg-size-top {
      font-size: 0.72rem;
      color: rgba(255,255,255,0.45);
    }
    .preg-size-name {
      font-size: 1.15rem;
      font-weight: 700;
      color: #fff;
      text-transform: capitalize;
    }
    .preg-size-week {
      font-size: 0.72rem;
      color: rgba(255,255,255,0.4);
    }
    .preg-size-detail {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.55);
      margin-top: 0.2rem;
    }
    .preg-section-label {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.6);
      margin-bottom: 0.6rem;
    }
    .preg-timeline {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }
    .preg-milestone {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.6rem 0.8rem;
      border-radius: 8px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      transition: border-color 0.15s;
    }
    .preg-milestone-past {
      opacity: 0.45;
    }
    .preg-milestone-now {
      background: rgba(167,139,250,0.08);
      border-color: rgba(167,139,250,0.25);
    }
    .preg-milestone-week {
      font-size: 0.7rem;
      font-weight: 700;
      color: rgba(167,139,250,0.8);
      min-width: 36px;
      padding-top: 0.1rem;
      white-space: nowrap;
    }
    .preg-milestone-label {
      font-size: 0.8rem;
      color: rgba(255,255,255,0.8);
      font-weight: 500;
    }
    .preg-milestone-date {
      font-size: 0.7rem;
      color: rgba(255,255,255,0.4);
      margin-top: 0.15rem;
    }
    .preg-dates-grid {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }
    .preg-date-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.45rem 0.7rem;
      border-radius: 8px;
      background: rgba(255,255,255,0.03);
      font-size: 0.78rem;
    }
    .preg-date-row:last-child {
      background: rgba(167,139,250,0.08);
      border: 1px solid rgba(167,139,250,0.2);
    }
    .preg-date-past {
      opacity: 0.45;
    }
    .preg-date-label {
      color: rgba(255,255,255,0.6);
    }
    .preg-date-val {
      color: rgba(255,255,255,0.85);
      font-weight: 500;
      text-align: right;
    }
    .preg-container input[type="date"].bmi-input {
      border: 1px solid rgba(255,255,255,0.18);
    }
    input[type="date"]::-webkit-calendar-picker-indicator {
      filter: invert(1);
      opacity: 0.65;
      cursor: pointer;
    }
    .preg-size-imperial {
      color: rgba(255,255,255,0.38);
      font-size: 0.85em;
    }
    .preg-age-btns {
      display: flex;
      gap: 0.4rem;
    }
    .preg-age-btn {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 8px;
      color: rgba(255,255,255,0.6);
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 500;
      padding: 0.35rem 0.7rem;
      transition: background 0.15s, color 0.15s;
    }
    .preg-age-btn:hover {
      background: rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.85);
    }
    .preg-age-btn.active {
      background: rgba(167,139,250,0.18);
      border-color: rgba(167,139,250,0.4);
      color: rgba(167,139,250,1);
    }
    .preg-lookup-answer {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 0.85rem 1rem;
      margin-bottom: 0.5rem;
    }
    .preg-lookup-ga {
      font-size: 1.15rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 0.2rem;
    }
    .preg-lookup-tri {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.6);
      margin-bottom: 0.35rem;
    }
    .preg-lookup-size {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.6);
    }
    .preg-lookup-note {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.4);
      font-style: italic;
    }
    @media (max-width: 420px) {
      .preg-result-grid {
        grid-template-columns: 1fr;
      }
      .preg-card-edd {
        grid-column: 1;
      }
      .preg-date-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.1rem;
      }
    }
  </style>
  <div slot="content">
    <div class="seo-container">
      <div class="answer-box">
        <div class="answer-box-label">Quick answer</div>
        <p>Enter the first day of your last menstrual period and the calculator instantly shows your estimated due date, current gestational age, trimester, and key upcoming milestones. It also works from conception date, a known due date, ultrasound measurements, or an IVF transfer date. Use the date lookup at the bottom to check how far along you'll be on any future date.</p>
      </div>
      <div class="answer-box">
        <div class="answer-box-label">Key takeaways</div>
        <ul>
          <li>A standard pregnancy lasts 280 days (40 weeks) from the first day of the last menstrual period, using Naegele's rule (ACOG, 2017).</li>
          <li>Only about 5% of babies are born on their exact due date - most deliver within a 2-week window around the estimate.</li>
          <li>First-trimester ultrasound (crown-rump length) is the most accurate dating method, with a margin of error of just 5-7 days.</li>
          <li>IVF due dates are the most precise: transfer date, embryo age, and fertilization timing are all exactly known.</li>
          <li>Use the date lookup at the bottom to instantly check how far along you'll be on any future date - useful for planning events, travel, or appointments.</li>
        </ul>
      </div>
      <h2 id="how-to-use">How to use this pregnancy due date calculator</h2>
      <p>Select your calculation method from the five tabs, enter the relevant date, and results appear instantly. The Last Period method is the default and requires only one date. For ultrasound, enter both the scan date and the gestational age shown on your report. For IVF, select whether you transferred a Day 3, Day 5, or Day 6 embryo.</p>
      <p>All five methods produce the same set of outputs: estimated due date, current gestational age in weeks and days, trimester, days remaining, a fetal size comparison, upcoming key milestones, and a complete key-dates timeline.</p>
      <p>Below the key dates grid, there is also a date lookup: enter any date to instantly see your gestational age, trimester, and fetal size on that day. This is useful for planning - for example, checking how far along you'll be at a wedding, a work trip, or a holiday.</p>
      <h2 id="how-due-date-works">How to calculate your due date</h2>
      <p>The standard clinical method is <a href="/glossary/naegeles-rule">Naegele's rule</a>, first published in 1812 and still used worldwide today: add 280 days (40 weeks) to the first day of your last menstrual period.</p>
      <p>If your cycle differs from 28 days, the calculator adjusts automatically - a 30-day cycle pushes the due date 2 days later, for instance. This simple formula underlies every method in this calculator.</p>
      <p>The formula counts pregnancy in <strong>gestational age</strong>, which starts two weeks before conception. That's why a newborn delivered at "40 weeks" has technically only been developing for about 38 weeks.</p>
      <p>Gestational age is the universal clinical standard because most people know when their last period started, while exact conception dates are often unknown.</p>
      <h3 id="explained-to-beginner">Gestational age explained to a beginner</h3>
      <p>Think of gestational age like a school year that starts on September 1st, even though class doesn't actually begin until September 14th. The "year" starts before any real learning happens.</p>
      <p>Pregnancy works the same way: doctors start counting from your last period (September 1st), even though conception (the first day of actual "class") happens about two weeks later.</p>
      <p>So when your doctor says you're 8 weeks pregnant, the baby has only been developing for about 6 weeks - but everyone uses the 8-<a href="/week-number">week number</a> because it's based on your period date, which is easy to track.</p>
      <h2 id="calculation-methods">Which calculation method should you use?</h2>
      <p>The right method depends on what information you have. First-trimester ultrasound is the gold standard, accurate to within 5-7 days (ACOG Committee Opinion 700, 2017).</p>
      <p>LMP-based dating (last period method) is the most widely used when ultrasound isn't available, but it assumes you know your period date and assumes regular ovulation on day 14.</p>
