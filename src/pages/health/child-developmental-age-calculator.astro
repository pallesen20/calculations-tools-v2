---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import type { Source } from '../../components/Sources.astro';
import HealthDisclaimer from '../../components/HealthDisclaimer.astro';
import QuizBlock from '../../components/QuizBlock.astro';
import RelatedGlossaryTerms from '../../components/RelatedGlossaryTerms.astro';

const tocItems = [
  { id: 'how-to-use',            label: 'How to use this calculator' },
  { id: 'three-ages',            label: 'Developmental age vs. chronological vs. corrected' },
  { id: 'developmental-domains', label: 'What do developmental domains measure?' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'milestone-ages',        label: 'Milestone reference table by age' },
  { id: 'delays',                label: 'What counts as a developmental delay?' },
  { id: 'red-flags',             label: 'Red flags that need prompt evaluation' },
  { id: 'corrected-age',         label: 'Should premature babies use corrected age?' },
  { id: 'common-mistakes',       label: 'Common mistakes when checking milestones' },
  { id: 'faq',                   label: 'FAQs' },
  { id: 'quiz',                  label: 'Quiz: test your knowledge' },
  { id: 'related-tools',         label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'Under the 2022 CDC milestone revision, at what age is walking typically expected?',
    options: ['12 months', '15 months', '18 months', '24 months'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'The 2022 CDC revision moved walking from 12 months to 15 months as the expected age. The 12-month age was set at the 50th percentile; the 2022 revision moved all milestones to the 75th percentile to reduce unnecessary alarm while still flagging children who are genuinely behind.',
  },
  {
    q: 'A 24-month-old child\'s developmental age comes out at 20 months across domains. What is the percentage delay?',
    options: ['4%', '17%', '20%', '25%'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Gap = 24 - 20 = 4 months. Percentage delay = 4 / 24 × 100 = 16.7%, rounded to 17%. A 15-33% gap typically warrants a conversation with the child\'s pediatrician, though a single screening tool is not a diagnosis.',
  },
  {
    q: 'What is "object permanence" and at what age do most children develop it?',
    options: ['Knowing their own name - 6 months', 'Understanding an object still exists when out of sight - 9 months', 'Preferring one toy over others - 12 months', 'Remembering where objects are kept - 18 months'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Object permanence is the understanding that objects continue to exist even when you can\'t see them. It develops around 9 months and is a major cognitive milestone. Before this, an infant who drops a toy acts as if it has ceased to exist.',
  },
  {
    q: 'If a premature baby was born 8 weeks early and is now 6 months old by the calendar, what age should you use when checking developmental milestones?',
    options: ['6 months (chronological)', '4 months (corrected age)', '5 months (average of both)', '7 months (to account for catch-up)'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Use corrected age for premature babies until at least 24 months. Corrected age = chronological age minus weeks of prematurity. 6 months minus 8 weeks (2 months) = 4 months. Comparing to 6-month milestones would falsely flag normal development for a premature child.',
  },
  {
    q: 'Which of the following is considered an absolute red flag at ANY age that requires immediate evaluation?',
    options: ['Not walking at 12 months', 'Not speaking in sentences at 24 months', 'Loss of previously acquired skills at any age', 'Not stacking 4 blocks at 18 months'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'Regression - losing skills a child previously had - is an absolute red flag at any age. It may indicate a neurological condition, autism spectrum disorder, or a metabolic disorder. The CDC lists regression as a reason to contact a doctor immediately, regardless of the child\'s current age.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const sources: Source[] = [
  {
    author: 'Centers for Disease Control and Prevention',
    title: 'Child Development - Developmental Milestones',
    journal: 'CDC.gov',
    year: 2022,
    url: 'https://www.cdc.gov/child-development/index.html',
  },
  {
    author: 'Zero to Three',
    title: 'Developmental Milestones Birth to 3 Years',
    journal: 'Zero to Three',
    year: 2024,
    url: 'https://www.zerotothree.org/issue-areas/early-development/milestones/',
  },
  {
    author: 'American Academy of Pediatrics',
    title: 'Ages and Stages',
    journal: 'HealthyChildren.org',
    year: 2023,
    url: 'https://www.healthychildren.org/English/ages-stages/Pages/default.aspx',
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Child Developmental Age Calculator",
    "url": "https://calculations.tools/health/child-developmental-age-calculator",
    "description": "Check developmental milestones across 5 domains - gross motor, fine motor, language, social, and cognitive - and estimate a child's developmental age compared to chronological age.",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to use the Child Developmental Age Calculator",
    "description": "Enter the child's age, check off observed milestones in each domain, and see estimated developmental age.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter chronological age", "text": "Enter the child's current age in years and months. For premature babies, use corrected age (chronological age minus weeks premature divided by 4) rather than calendar age." },
      { "@type": "HowToStep", "position": 2, "name": "Review milestones", "text": "The calculator shows all developmental milestones for the child's age range across five domains: gross motor, fine motor, language, social/emotional, and cognitive." },
      { "@type": "HowToStep", "position": 3, "name": "Check observed milestones", "text": "Check each milestone the child can consistently do. Only check milestones the child does reliably - not skills they have done once or with significant prompting." },
      { "@type": "HowToStep", "position": 4, "name": "Review the domain-by-domain result", "text": "The result shows estimated developmental age for each domain separately and an overall developmental age. A domain-specific delay may be more informative than the overall average." },
      { "@type": "HowToStep", "position": 5, "name": "Use the result as a conversation starter", "text": "This tool is a screening aid, not a diagnosis. Take the result to your pediatrician or early intervention specialist, especially if the gap is more than 20-25% of the child's chronological age in any domain." },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is developmental age in a child?",
        "acceptedAnswer": { "@type": "Answer", "text": "Developmental age is the age level at which a child is functioning based on observed skills and milestones, regardless of chronological age. It is estimated by identifying the most advanced milestone a child consistently achieves in each domain. A 24-month-old functioning at an 18-month level has a developmental age of approximately 18 months." }
      },
      {
        "@type": "Question",
        "name": "What are the 5 developmental domains for children?",
        "acceptedAnswer": { "@type": "Answer", "text": "The five domains are: gross motor (large muscle movements, balance, and coordination), fine motor (small muscle and hand-eye coordination), language (speech, communication, and understanding), social/emotional (relationships, self-regulation, and play), and cognitive (thinking, problem-solving, and memory). Most developmental assessments and IEPs track progress in all five." }
      },
      {
        "@type": "Question",
        "name": "What percentage delay is considered significant in a child?",
        "acceptedAnswer": { "@type": "Answer", "text": "A delay of 25% or more of chronological age in one or more domains is generally considered significant and warrants professional evaluation. For example, a 24-month-old functioning at 18 months or below (25% delay) in language would typically qualify for a speech evaluation. The exact threshold varies by state early intervention criteria." }
      },
      {
        "@type": "Question",
        "name": "Should I use corrected age for a premature baby?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. For children born before 37 weeks, use corrected age (also called adjusted age) for developmental milestone comparisons until at least 24 months corrected age, and sometimes up to 36 months for very premature infants. Corrected age equals chronological age minus the number of weeks premature, converted to months." }
      },
      {
        "@type": "Question",
        "name": "When should I be concerned about my child's development?",
        "acceptedAnswer": { "@type": "Answer", "text": "Contact your pediatrician if your child loses skills they once had at any age, does not make eye contact by 2 months, does not babble by 12 months, says no words by 16 months, or does not use 2-word phrases by 24 months. These are red flags regardless of a child's overall developmental profile." }
