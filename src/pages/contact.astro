---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  metaTitle="Contact Calculations.tools"
  description="Get in touch with calculations.tools. Report an error, suggest a new tool, or ask a question. We read every message."
  canonical="https://calculations.tools/contact"
>
  <div class="au-page">
    <div class="au-container">

      <header class="au-hero" style="text-align:left; padding-bottom:2rem; margin-bottom:2.5rem;">
        <p class="au-eyebrow">Get in touch</p>
        <h1 class="au-headline">Contact us</h1>
        <p class="au-subline" style="margin:0.75rem 0 0; text-align:left;">We read every message. Whether you found an error, want to suggest a tool, or just have a question - reach out.</p>
      </header>

      <div class="contact-grid">

        <div class="contact-main">
          <div class="contact-card">
            <div class="contact-card-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <h2>Email us</h2>
              <p>The fastest way to reach us. We typically respond within 1-2 business days.</p>
              <a href="mailto:info@calculations.tools" class="contact-email-link">info@calculations.tools</a>
            </div>
          </div>

          <div class="contact-reasons">
            <h2>What to write about</h2>
            <div class="contact-reason-grid">
              <div class="contact-reason">
                <div class="contact-reason-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </div>
                <div>
                  <h3>Report an error</h3>
                  <p>Found a wrong formula, incorrect result, or broken tool? Let us know the page URL and the expected vs actual result.</p>
                </div>
              </div>
              <div class="contact-reason">
                <div class="contact-reason-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </div>
                <div>
                  <h3>Suggest a tool</h3>
                  <p>Missing a calculator or converter you need? Tell us what it should do and we'll consider adding it to the roadmap.</p>
                </div>
              </div>
              <div class="contact-reason">
                <div class="contact-reason-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </div>
                <div>
                  <h3>Ask a question</h3>
                  <p>Not sure how to use a tool or interpret a result? Ask away - we're happy to explain.</p>
                </div>
              </div>
              <div class="contact-reason">
                <div class="contact-reason-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                </div>
                <div>
                  <h3>Partnership or embed</h3>
                  <p>Want to embed a tool on your site or explore a content partnership? We'd love to hear from you.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <aside class="contact-sidebar">
          <div class="contact-founder-card">
            <img src="/jesper.webp" width="56" height="56" alt="Jesper Pallesen" />
            <div>
              <span class="contact-founder-name">Jesper Pallesen</span>
              <span class="contact-founder-role">Founder & Developer</span>
              <a href="/about-us/jesper-pallesen" class="contact-profile-link">View founder page →</a>
            </div>
          </div>
          <div class="contact-info-box">
            <h3>Response time</h3>
            <p>1-2 business days</p>
          </div>
          <div class="contact-info-box">
            <h3>Based in</h3>
            <p>Denmark</p>
          </div>
          <div class="contact-info-box">
            <h3>Editorial corrections</h3>
            <p>We publish corrections openly. See our <a href="/editorial-standards">editorial standards</a> for the correction process.</p>
          </div>
        </aside>

      </div>

    </div>
  </div>
</BaseLayout>
<style is:global>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 700px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-sidebar { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .contact-founder-card { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .contact-sidebar { grid-template-columns: 1fr; }
  }
  .contact-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: 12px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    margin-bottom: 1.5rem;
  }
  .contact-card-icon {
    color: #a78bfa;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .contact-card h2 {
    font-size: 1rem;
    font-weight: 700;
    color: white;
    margin-bottom: 0.4rem;
  }
  .contact-card p {
    font-size: 0.875rem;
    color: var(--off-white);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .contact-email-link {
    font-size: 1rem;
    font-weight: 700;
    color: #a78bfa;
    text-decoration: none;
    word-break: break-all;
  }
  .contact-email-link:hover { text-decoration: underline; }
  .contact-reasons h2 {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.35);
    margin-bottom: 1rem;
  }
  .contact-reason-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }
  @media (max-width: 520px) {
    .contact-reason-grid { grid-template-columns: 1fr; }
  }
  .contact-reason {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1.1rem;
    border-radius: 10px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
  }
  .contact-reason-icon {
    color: #a78bfa;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .contact-reason h3 {
    font-size: 0.875rem;
    font-weight: 700;
    color: white;
    margin-bottom: 0.3rem;
  }
  .contact-reason p {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.6;
    margin: 0;
  }
  .contact-founder-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem;
    border-radius: 10px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    margin-bottom: 0.75rem;
  }
  .contact-founder-card img {
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    flex-shrink: 0;
  }
  .contact-founder-card > div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .contact-founder-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: white;
  }
  .contact-founder-role {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
  }
  .contact-profile-link {
    font-size: 0.75rem;
    color: #a78bfa;
    text-decoration: none;
    margin-top: 0.2rem;
  }
  .contact-profile-link:hover { text-decoration: underline; }
  .contact-info-box {
    padding: 1rem 1.15rem;
    border-radius: 10px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    margin-bottom: 0.75rem;
  }
  .contact-info-box h3 {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(255,255,255,0.35);
    margin-bottom: 0.3rem;
  }
  .contact-info-box p {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.6;
    margin: 0;
  }
  .contact-info-box a {
    color: #a78bfa;
    text-decoration: none;
  }
  .contact-info-box a:hover { text-decoration: underline; }

  .au-page {
    min-height: 100vh;
    padding: 3rem 1rem 5rem;
  }
  .au-container {
    max-width: 820px;
    margin: 0 auto;
  }
  .au-eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin-bottom: 1rem;
  }
  .au-headline {
    font-size: clamp(1.9rem, 5vw, 3rem);
    font-weight: 800;
    color: white;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }
  .au-subline {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto 2.5rem;
  }
</style>
