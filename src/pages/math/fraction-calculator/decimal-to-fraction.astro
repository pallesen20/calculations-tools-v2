---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import Formula from '../../../components/Formula.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
import RelatedGlossaryTerms from '../../../components/RelatedGlossaryTerms.astro';
import QuizBlock from '../../../components/QuizBlock.astro';
import type { Source } from '../../../components/Sources.astro';

const f = {
  terminating: "$$0.75 = \\frac{75}{100} = \\frac{3}{4}$$",
  general:     "$$\\text{decimal} \\times 10^n = \\text{integer} \\implies \\frac{\\text{integer}}{10^n} \\xrightarrow{\\div \\gcd} \\text{simplified fraction}$$",
  repeating:   "$$0.\\overline{3} = \\frac{3}{9} = \\frac{1}{3}$$",
  repGeneral:  "$$x = 0.\\overline{d_1 d_2 \\ldots d_n} \\implies 10^n x - x = d_1 d_2 \\ldots d_n \\implies x = \\frac{d_1 d_2 \\ldots d_n}{10^n - 1}$$",
  repMixed:    "$$0.41\\overline{6} = \\frac{416 - 41}{900} = \\frac{375}{900} = \\frac{5}{12}$$",
  neg:         "$$-0.25 = -\\frac{25}{100} = -\\frac{1}{4}$$",
};

const tocItems = [
  { id: 'how-to-use',           label: 'How to use' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'terminating',          label: 'Terminating decimals' },
  { id: 'repeating',          label: 'Repeating decimals' },
  { id: 'mixed-repeating',    label: 'Mixed repeating decimals' },
  { id: 'negative',           label: 'Negative decimals' },
  { id: 'common-decimals',    label: 'Common decimal–fraction table' },
  { id: 'examples',           label: 'Worked examples' },
  { id: 'common-mistakes',    label: 'Common mistakes' },
  { id: 'faq',                label: 'FAQs' },
  { id: 'quiz',               label: 'Quiz: test your knowledge' },
  { id: 'related-tools',      label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'To convert 0.75 to a fraction, what are the correct steps?',
    options: [
      'Count the decimal places (2), write 75/100, then divide both by GCD(75, 100) = 25 to get 3/4',
      'Multiply 0.75 by 10 repeatedly until you reach a whole number, then write that as the numerator over the matching power of 10',
      'Write 0.75 directly as 3/4 by recognising that 75 cents equals three quarters',
      'Count the decimal places, place 100 over 75 to form the denominator, then invert the fraction',
    ] as [string, string, string, string],
    correct: 0 as const,
    explanation: 'The page states: count decimal places (n = 2), write 75/100, then simplify by dividing both parts by GCD(75, 100) = 25. That gives 3/4. The other options skip or misapply the GCD step.',
  },
  {
    q: 'Worked example 4 on the page converts 0.8333... to a fraction. What is the result?',
    options: [
      '83/100 - three decimal places, denominator 1000, simplified',
      '8/9 - single repeating digit 3 over denominator 9',
      '5/6 - numerator = 83 minus 8 = 75, denominator = 90 (one 9 for repeating digit, one 0 for non-repeating), 75/90 simplified',
      '5/7 - using the mixed repeating shortcut with a different denominator formula',
    ] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'The worked example shows the mixed repeating method: numerator = all digits (83) minus the non-repeating part (8) = 75; denominator = 90 (one 9 for the repeating "3", one 0 for the non-repeating "8"). 75/90 = 5/6.',
  },
  {
    q: 'For 0.333..., what algebraic move eliminates the infinite repeating tail?',
    options: [
      'Multiply by 3 to get 0.999..., recognise that as 1, then divide back by 3 to get 1/3',
      'Let x = 0.333..., multiply both sides by 10 to get 10x = 3.333..., then subtract x: 9x = 3, so x = 1/3',
      'Write 3 as the numerator and 99 as the denominator regardless of block length, giving 3/99 = 1/33',
      'Round to 0.33 and treat as the terminating fraction 33/100',
    ] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'The page describes this exact step: let x = 0.333..., multiply by 10^1 = 10 (block length is 1), subtract the original equation to cancel the tail, and solve 9x = 3 for x = 1/3.',
  },
  {
    q: 'According to the common decimal-fraction reference table, what fraction equals 0.625?',
    options: [
      '6/10',
      '3/4',
      '2/3',
      '5/8',
    ] as [string, string, string, string],
    correct: 3 as const,
    explanation: 'The reference table on the page lists 0.625 = 5/8 (62.5%). The page also notes the eighths column - 1/8=0.125, 3/8=0.375, 5/8=0.625, 7/8=0.875 - is worth memorising because it appears frequently in engineering and measurement.',
  },
  {
    q: 'Which of the following cannot be expressed as an exact fraction?',
    options: [
      'Pi (approximately 3.14159...) - it is irrational with an infinite, non-repeating decimal expansion',
      '0.333... - expressing it as a fraction would require an infinitely long numerator',
      '0.272727... - the two-digit repeating block makes it impossible to express as p/q',
      '0.999... - it equals exactly 1, so it cannot be expressed as a proper fraction',
    ] as [string, string, string, string],
    correct: 0 as const,
    explanation: 'The page states that only irrational numbers like pi, sqrt(2), and e cannot be converted - they have infinite non-repeating decimal expansions. The other options are all rational: 0.333... = 1/3, 0.272727... = 3/11, and 0.999... = 1 exactly.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const sources: Source[] = [
  {
    author: 'Weisstein, Eric W.',
    title: 'Repeating Decimal',
    journal: 'Wolfram MathWorld',
    year: 2024,
    url: 'https://mathworld.wolfram.com/RepeatingDecimal.html',
  },
  {
    author: 'Weisstein, Eric W.',
    title: 'Rational Number',
    journal: 'Wolfram MathWorld',
    year: 2024,
    url: 'https://mathworld.wolfram.com/RationalNumber.html',
  },
  {
    author: 'Weisstein, Eric W.',
    title: 'Irrational Number',
    journal: 'Wolfram MathWorld',
    year: 2024,
    url: 'https://mathworld.wolfram.com/IrrationalNumber.html',
  },
  {
    author: 'Weisstein, Eric W.',
    title: 'Greatest Common Divisor',
    journal: 'Wolfram MathWorld',
    year: 2024,
    url: 'https://mathworld.wolfram.com/GreatestCommonDivisor.html',
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Decimal to Fraction Calculator",
    "url": "https://calculations.tools/math/fraction-calculator/decimal-to-fraction",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Any",
    "description": "Convert any decimal to a fraction instantly. Handles terminating and repeating decimals, simplifies to lowest terms, and shows step-by-step workings.",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to convert a decimal to a fraction",
    "description": "Convert a terminating decimal to a fraction in two steps.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Write the decimal over a power of 10", "text": "Count the decimal places (n). Write the decimal digits as the numerator and 10^n as the denominator. For example, 0.75 has 2 decimal places, so write 75/100." },
      { "@type": "HowToStep", "position": 2, "name": "Simplify by the GCD", "text": "Find the Greatest Common Divisor (GCD) of the numerator and denominator, then divide both by it. GCD(75, 100) = 25, so 75/100 = 3/4." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do you convert a decimal to a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "Write the decimal digits as the numerator and the appropriate power of 10 as the denominator (10 for one decimal place, 100 for two, etc.). Then simplify by dividing both numerator and denominator by their GCD. For example, 0.75 = 75/100 = 3/4." }
      },
      {
        "@type": "Question",
        "name": "How do you convert a repeating decimal to a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "Let x equal the decimal. Multiply both sides by 10^n where n is the length of the repeating block. Subtract the original equation from the multiplied equation to eliminate the repeating part. Solve for x. For example, 0.333… = 1/3: let x = 0.333…, then 10x = 3.333…, so 10x − x = 3, meaning 9x = 3 and x = 1/3." }
      },
      {
        "@type": "Question",
        "name": "What is 0.5 as a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "0.5 = 5/10 = 1/2. One decimal place means the denominator is 10. GCD(5, 10) = 5, so 5/10 simplifies to 1/2." }
      },
      {
        "@type": "Question",
        "name": "What is 0.333… as a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "0.333… = 1/3. The repeating block is 3, so use the formula: 10x − x = 3, giving 9x = 3 and x = 3/9 = 1/3." }
      },
      {
        "@type": "Question",
        "name": "Can every decimal be written as a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "Every terminating decimal and every repeating decimal can be expressed exactly as a fraction (rational number). Irrational numbers like π or √2 have infinite non-repeating decimal expansions and cannot be expressed as fractions." }
      }
    ]
