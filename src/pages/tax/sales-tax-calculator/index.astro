---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { US_SALES_TAX } from '../../../data/us-sales-tax';
import QuizBlock from '../../../components/QuizBlock.astro';

const quizQuestions = [
  {
    q: 'How many US states have no statewide sales tax?',
    options: ['3', '7', '4', '5'] as [string, string, string, string],
    correct: 3 as const,
    explanation: 'Alaska, Delaware, Montana, New Hampshire, and Oregon - 5 states - have no statewide sales tax. Alaska still allows local taxes; the other four have no state or local sales tax.',
  },
  {
    q: 'A $200 item is purchased in California at the state rate of 7.25%. What is the tax amount?',
    options: ['$10.00', '$14.50', '$20.00', '$7.25'] as [string, string, string, string],
    correct: 1 as const,
    explanation: '$200 x 0.0725 = $14.50 tax, making the total $214.50. California has the highest state rate in the US at 7.25%.',
  },
  {
    q: 'A receipt shows a total of $108.00 at an 8% tax rate. Which calculation gives the correct pre-tax price?',
    options: ['$108 / 1.08 = $100.00', '$108 - ($108 x 0.08) = $99.36', '$108 x 0.92 = $99.36', '$108 - $8 = $100.00'] as [string, string, string, string],
    correct: 0 as const,
    explanation: 'Dividing by 1.08 is the correct reverse formula. Subtracting 8% of $108 gives $99.36, which is wrong - the tax was calculated on the $100 base price, not on the $108 total.',
  },
  {
    q: 'Which US state or states have the highest combined (state + local) sales tax rate?',
    options: ['California (10.25%)', 'Texas (8.25%)', 'Louisiana and Tennessee (9.55%)', 'New York (8.5%)'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'Louisiana and Tennessee both reach 9.55% combined - the highest in the country. California has the highest state rate at 7.25% but a lower combined rate than these two.',
  },
  {
    q: 'Since the South Dakota v. Wayfair ruling in 2018, which tax rate applies when a retailer ships goods across state lines?',
    options: ['No tax is owed on interstate shipments', "The seller's home state rate", 'The federal average rate of 6.6%', "The buyer's destination address rate"] as [string, string, string, string],
    correct: 3 as const,
    explanation: "The Wayfair ruling established that the destination address determines the tax rate, not the seller's location. Online retailers must now collect tax at the buyer's local rate.",
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Sales Tax Calculator",
    "url": "https://calculations.tools/tax/sales-tax-calculator",
    "description": "Free sales tax calculators for the US (all 50 states). Calculate how much sales tax you owe on any purchase, or find the pre-tax price from a total."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate sales tax on a purchase?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Multiply the pre-tax price by the tax rate expressed as a decimal. For an 8% rate on a $50 item: $50 x 0.08 = $4.00 tax, giving a total of $54.00. The formula is: Tax Amount = Pre-tax Price x (Tax Rate / 100)."
        }
      },
      {
        "@type": "Question",
        "name": "How do I remove sales tax from a total price?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Divide the tax-inclusive total by (1 + Tax Rate / 100). For a $54.00 total at 8%: $54 / 1.08 = $50.00 pre-tax price. The tax was $4.00. Do not subtract the percentage directly from the total - that method overstates the tax amount."
        }
      },
      {
        "@type": "Question",
        "name": "Which US states have no sales tax?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Five states have no statewide sales tax: Alaska, Delaware, Montana, New Hampshire, and Oregon. Delaware, Montana, New Hampshire, and Oregon also have no local sales taxes. Alaska has no state tax but allows local taxes, so rates above 0% apply in many Alaskan cities. The other 45 states plus Washington D.C. all levy a state sales tax."
        }
      },
      {
        "@type": "Question",
        "name": "What is the average sales tax rate in the US?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The average combined state and local sales tax rate in the US is approximately 6.6% in 2026, according to the Tax Foundation. State-only rates range from 0% to 7.25% (California). Louisiana and Tennessee top the combined rate rankings at 9.55%."
        }
      },
      {
        "@type": "Question",
        "name": "Is sales tax the same as VAT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Sales tax is collected only at the final point of sale. VAT is collected at every stage of production, with each business reclaiming the VAT paid on its inputs. VAT is standard across Europe and most of the world; the US uses retail sales tax instead. Prices in VAT countries are usually tax-inclusive; US prices are shown pre-tax and tax is added at checkout."
        }
      }
    ]
  }
];
---
<BaseLayout
  title="Sales Tax Calculator"
  metaTitle="Sales Tax Calculator | Instantly Add or Remove Sales Tax ᐅ"
  description="Calculate sales tax on any purchase or remove tax from a total. Enter the price and tax rate to instantly see the tax amount and total. Add or reverse mode. Auto-detects your currency."
  canonical="https://calculations.tools/tax/sales-tax-calculator"
  schema={schema}
>
  <main class="stax-hub">
    <div class="stax-hub-hero">
      <div class="stax-hub-hero-inner">
        <h1>Global Sales Tax Calculator</h1>
        <p class="stax-hub-lead">Select a country or region below to calculate sales tax. US state calculators cover all 50 states with individual rates, exemptions, and city-level data.</p>
        <div class="updated-live">
        <span class="cc-dot"></span>
        <span>Tax rates updated monthly</span>
        </div>
        <div class="stc-widget">
          <div class="stc-mode-toggle">
            <button id="stc-mode-add" class="stc-mode-btn stc-mode-active">Add tax</button>
            <button id="stc-mode-remove" class="stc-mode-btn">Remove tax</button>
          </div>
          <div class="bmi-field">
            <label class="bmi-label" id="stc-price-label" for="stc-price">Pre-tax price</label>
            <div class="stc-price-row">
              <div class="stc-currency-wrap">
                <select id="stc-currency" class="stc-currency-select" aria-label="Currency"></select>
                <svg class="stc-currency-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2 4 6 8 10 4"/></svg>
              </div>
              <input type="text" inputmode="decimal" id="stc-price" class="bmi-input amount-input" placeholder="e.g. 50.00" />
            </div>
          </div>
          <div class="bmi-field">
            <label class="bmi-label" for="stc-rate">Tax rate (%)</label>
            <div class="bmi-input-wrap">
              <input type="text" inputmode="decimal" id="stc-rate" class="bmi-input" placeholder="e.g. 8.25" />
            </div>
          </div>
          <div id="stc-result" class="lbm-result hidden">
            <div class="stc-results-grid">
              <div class="stc-result-row" id="stc-row-pretax">
                <span class="stc-period-label">Pre-tax price</span>
                <span class="stc-period-val" id="stc-res-pretax">-</span>
              </div>
              <div class="stc-result-row stc-row-tax">
                <span class="stc-period-label">Tax amount</span>
                <span class="stc-period-val" id="stc-res-tax">-</span>
              </div>
              <div class="stc-result-row stc-row-highlight" id="stc-row-total">
                <span class="stc-period-label">Total (with tax)</span>
                <span class="stc-period-val" id="stc-res-total">-</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="stax-hub-body">
      <section class="stax-region-section">
        <div class="stax-region-card stax-region-us">
          <div class="stax-region-header">
            <div class="stax-region-flag">🇺🇸</div>
            <div>
              <h2><a href="/tax/sales-tax-calculator/us">United States</a></h2>
              <p>All 50 states - individual calculators with local rates and exemptions</p>
            </div>
            <a href="/tax/sales-tax-calculator/us" class="stax-region-btn">View map →</a>
          </div>
          <div class="stax-states-grid">
            {US_SALES_TAX.sort((a, b) => a.name.localeCompare(b.name)).map(state => (
              <a href={`/tax/sales-tax-calculator/us/${state.slug}`} class="stax-state-tile">
                <span class="stax-tile-abbr">{state.abbr}</span>
                <span class="stax-tile-name">{state.name}</span>
                <span class={`stax-tile-rate ${state.noTax ? 'stax-tile-notax' : ''}`}>
                  {state.noTax ? 'No tax' : `${state.avgCombined}%`}
                </span>
              </a>
            ))}
          </div>
        </div>
        <div class="stax-region-card stax-region-coming">
          <div class="stax-region-header">
            <div class="stax-region-flag">🌍</div>
            <div>
              <h2>International (coming soon)</h2>
              <p>VAT and GST calculators for countries worldwide - in development</p>
            </div>
          </div>
          <div class="stax-coming-countries">
            {['🇬🇧 UK (20% VAT)', '🇩🇪 Germany (19%)', '🇫🇷 France (20%)', '🇦🇺 Australia (10% GST)', '🇨🇦 Canada (5-15%)', '🇮🇳 India (GST)', '🇧🇷 Brazil', '🇯🇵 Japan (10%)'].map(c => (
              <span class="stax-coming-badge">{c}</span>
            ))}
          </div>
        </div>
      </section>
        <div class="seo-container"> <div class="answer-box"> <div class="answer-box-label">Quick answer</div> <p>Our sales tax calculator takes a pre-tax price and a percentage rate and returns the tax amount plus the final total. Use it when buying online, checking a receipt, or pricing products for sale. Switch to "Remove tax" mode to reverse-calculate the original price from a tax-inclusive total.</p> </div> <div class="answer-box"> <div class="answer-box-label">Key takeaways</div> <ul> <li>45 states and Washington D.C. levy a statewide <a href="/glossary/sales-tax">sales tax</a>; Alaska, Delaware, Montana, New Hampshire, and Oregon do not (<a href="https://taxfoundation.org/data/all/state/sales-tax-rates/" target="_blank" rel="noopener noreferrer">Tax Foundation, 2026</a>).</li> <li>Average combined US rate (state + local) is about 6.6%; Louisiana and Tennessee top the list at 9.55% (<a href="https://taxfoundation.org/data/all/state/sales-tax-rates/" target="_blank" rel="noopener noreferrer">Tax Foundation, 2026</a>).</li> <li>Forward formula: Tax = Price x (Rate / 100). Reverse formula: Pre-tax Price = Total / (1 + Rate / 100).</li> <li>Sales tax is charged only at the final sale - unlike <a href="/glossary/value-added-tax">VAT</a>, which is collected at every production stage.</li> </ul> </div> <h2 id="how-to-use">How to use this sales tax calculator</h2> <p>Enter your price and tax rate, then choose your mode. "Add tax" takes a pre-tax price and shows you the tax amount and total. "Remove tax" takes a tax-inclusive total and works backwards to the original price and the tax charged. The currency selector auto-detects your location and defaults to USD.</p> <p>The calculator updates as you type. To check a rate you're unsure about, enter your state or country rate in the tax field - the US state rates table below lists common rates for reference.</p> <h3 id="explained-to-beginner">Sales tax explained to a beginner</h3> <p>Shopping in the US works differently from most countries: the price on the tag is not what you pay at the register. The store adds sales tax on top at checkout. A $50 jacket in a state with 8% sales tax rings up as $54.00 - the 8% was calculated on the $50 pre-tax price, giving $4.00 tax. This is why US prices feel cheaper than they look if you're used to tax-inclusive pricing from the UK or Europe.</p> <p>This creates a subtle trap when reversing. If your receipt shows $54.00 and you want the pre-tax price, subtracting 8% gives $54.00 - $4.32 = $49.68 - which is wrong. The correct method divides by 1.08: $54 / 1.08 = $50.00. The $4.32 error happens because subtracting 8% of $54 treats the final total as the base - but the tax was always calculated on the $50, not on the total.</p> <h2 id="how-to-calculate">How do you calculate sales tax?</h2> <p>Multiply the pre-tax price by the tax rate divided by 100. For a $50 purchase at an 8% rate, the calculation is $50 x 0.08 = $4.00 in tax, giving a total of $54.00. Sales tax is a <a href="/math/percentage-calculator">percentage calculation</a> - the same formula used for discounts, tips, and markups. The Tax Foundation reports the average combined US rate is approximately 6.6% in 2026, though your local rate may differ significantly.</p> <p>The forward formula has two steps:</p> <p class="formula formula--display"><span><span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mtext>Tax&nbsp;Amount</mtext><mo>=</mo><mtext>Pre-tax&nbsp;Price</mtext><mo>×</mo><mfrac><mtext>Tax&nbsp;Rate</mtext><mn>100</mn></mfrac></mrow><annotation encoding="application/x-tex">\text{Tax Amount} = \text{Pre-tax Price} \times \frac{\text{Tax Rate}}{100}</annotation></semantics></math></span></span></span></span></p> <p class="formula formula--display"><span><span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mtext>Total&nbsp;Price</mtext><mo>=</mo><mtext>Pre-tax&nbsp;Price</mtext><mo>+</mo><mtext>Tax&nbsp;Amount</mtext></mrow><annotation encoding="application/x-tex">\text{Total Price} = \text{Pre-tax Price} + \text{Tax Amount}</annotation></semantics></math></span></span></span></span></p> <p>For example, a $200 item at 7.25% (California state rate): Tax = $200 x 0.0725 = $14.50. Total = $200 + $14.50 = $214.50. Most US states also allow cities and counties to add a local rate on top - so the combined rate you actually pay at checkout is often higher than the state rate alone.</p> <h2 id="reverse-calculation">How do you calculate sales tax in reverse?</h2> <p>Divide the tax-inclusive total by (1 + Tax Rate / 100). This is the reverse calculation, and it's used when a receipt shows only the final total without a breakdown. For a $108.00 total with an 8% rate: $108 / 1.08 = $100.00 pre-tax price; the tax was $8.00.</p> <p>The reverse formula:</p> <p class="formula formula--display"><span><span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mtext>Pre-tax&nbsp;Price</mtext><mo>=</mo><mfrac><mtext>Total&nbsp;Price</mtext><mrow><mn>1</mn><mo>+</mo><mtext>Tax&nbsp;Rate</mtext><mi mathvariant="normal">/</mi><mn>100</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">\text{Pre-tax Price} = \frac{\text{Total Price}}{1 + \text{Tax Rate} / 100}</annotation></semantics></math></span></span></span></span></p> <p>A common mistake is subtracting the rate as a straight percentage: $108.00 x 0.08 = $8.64 - which overstates the tax by $0.64. The division method is always correct. Use the "Remove tax" mode in this calculator to avoid this error.</p> <p>In my experience reviewing small-business expense reports, reverse-calculating sales tax from receipt totals is where errors accumulate most reliably. Bookkeepers often apply the rate to the gross total rather than dividing, and the difference per transaction is small enough to go unnoticed until a quarterly reconciliation shows the tax liability account is consistently off by a fixed margin.</p> <h2 id="no-sales-tax-states">Which US states have no sales tax?</h2> <p>Five states have no statewide sales tax: Alaska, Delaware, Montana, New Hampshire, and Oregon. Among these, Delaware, Montana, New Hampshire, and Oregon have no local sales taxes either, making purchases genuinely tax-free at the point of sale. Alaska is the exception: it has no state tax but allows municipalities to levy local rates, and many Alaskan cities do charge sales tax.</p> <p>Shoppers sometimes cross state lines to avoid sales tax on big-ticket items. Delaware, for example, is a popular destination for car and electronics purchases from neighbouring New Jersey (6.625% state rate) or Pennsylvania (6%). That said, some states require you to pay a "use tax" if you bring a purchased item back home - which is technically owed even if rarely enforced on personal purchases.</p> <h2 id="state-rates">US state sales tax rates (2026)</h2> <p>State rates vary from 2.9% (Colorado, the lowest) to 7.25% (California, the highest). The table below shows the state-level rate only. Combined rates that include county and city taxes are higher - Louisiana and Tennessee both reach 9.55% combined, the highest in the country (Tax Foundation, 2026).</p> <div class="responsive-table"> <table> <thead> <tr><th>State</th><th>State Rate</th><th>Note</th></tr> </thead> <tbody> <tr><td>Alaska</td><td>0%</td><td>No state tax; local taxes apply in many cities</td></tr> <tr><td>Delaware</td><td>0%</td><td>No state or local sales tax</td></tr> <tr><td>Montana</td><td>0%</td><td>No state or local sales tax</td></tr> <tr><td>New Hampshire</td><td>0%</td><td>No state or local sales tax</td></tr> <tr><td>Oregon</td><td>0%</td><td>No state or local sales tax</td></tr> <tr><td>Colorado</td><td>2.9%</td><td>Lowest non-zero state rate</td></tr> <tr><td>New York</td><td>4.0%</td><td>NYC adds 4.5% local on top</td></tr> <tr><td>Georgia</td><td>4.0%</td><td></td></tr> <tr><td>Ohio</td><td>5.75%</td><td></td></tr> <tr><td>Pennsylvania</td><td>6.0%</td><td></td></tr> <tr><td>Florida</td><td>6.0%</td><td>No personal income tax</td></tr> <tr><td>Michigan</td><td>6.0%</td><td></td></tr> <tr><td>Texas</td><td>6.25%</td><td>No personal income tax</td></tr> <tr><td>Illinois</td><td>6.25%</td><td></td></tr> <tr><td>Nevada</td><td>6.85%</td><td>No personal income tax</td></tr> <tr><td>Indiana</td><td>7.0%</td><td></td></tr> <tr><td>Mississippi</td><td>7.0%</td><td></td></tr> <tr><td>Rhode Island</td><td>7.0%</td><td></td></tr> <tr><td>Tennessee</td><td>7.0%</td><td>Combined with local: 9.55%</td></tr> <tr><td>California</td><td>7.25%</td><td>Highest state rate</td></tr> </tbody> </table> </div> <p>Source: <a href="https://taxfoundation.org/data/all/state/sales-tax-rates/" target="_blank" rel="noopener">Tax Foundation, 2026 State Sales Tax Rates</a>. Combined rates (state + average local) are used for comparing total tax burden across states.</p> <h2 id="sales-tax-vs-vat">How is sales tax different from VAT?</h2> <p>Sales tax is collected once, at the final point of sale, and paid entirely by the end consumer. <a href="/tax/vat-calculator">VAT (Value Added Tax)</a> is collected at every stage of the supply chain - manufacturer, wholesaler, retailer - with each business reclaiming the VAT it paid on purchases. The Tax Foundation notes that over 170 countries use VAT, while the US is the only major economy that relies on retail sales tax instead.</p> <p>In practical terms, the math looks the same to a consumer: a 10% rate adds 10% to the sticker price in both systems. The difference is how the tax is remitted to the government. Under VAT, if a product moves through three businesses before reaching you, the government collects a small slice at each step. Under sales tax, nothing is collected until you buy it.</p> <p>One important implication: prices in VAT countries are usually quoted tax-inclusive (the sticker price is what you pay). In the US, prices are typically quoted pre-tax, and the tax is added at checkout. This is why the "Remove tax" mode in this calculator is so useful - European visitors or anyone dealing with tax-inclusive pricing can reverse out the base price in one step.</p> <h2 id="mistakes">Common mistakes when calculating sales tax</h2> <p>The most common error in reverse calculation is subtracting the percentage directly from the total. If a total is $108 and the rate is 8%, subtracting $108 x 0.08 = $8.64 gives a wrong pre-tax price of $99.36 - the correct answer is $100.00. Only the division method works: $108 / 1.08 = $100.00.</p> <ul> <li><strong>Using only the state rate</strong>: Most US cities and counties add a local rate on top. A purchase in Los Angeles costs California's 7.25% state rate plus local rates that push the combined total to 10.25%.</li> <li><strong>Forgetting use tax</strong>: If you buy online from a retailer who doesn't collect your state's sales tax, you may owe a "use tax" to your home state at the same rate.</li> <li><strong>Taxing exempt items</strong>: Groceries, prescription drugs, and some clothing are exempt from sales tax in many states. Always check what's exempt before applying a blanket rate.</li> <li><strong>Wrong rate for the destination</strong>: For shipped goods, the tax rate that applies is the destination address, not the seller's location (since the South Dakota v. Wayfair ruling in 2018).</li> </ul> <p>The use tax obligation is the most systematically overlooked sales tax rule I personally encounter.</p><p>When a business buys equipment from an out-of-state seller who does not collect sales tax - whether online or through a direct vendor relationship - the buyer technically owes use tax to their home state at the same rate they would have paid locally. Most small businesses never file use tax returns, but it remains a real audit exposure, particularly for larger equipment purchases where the tax amount is material.</p> <h2 id="faq">FAQs about sales tax</h2> <h3>How do I calculate sales tax on a purchase?</h3> <p>Multiply the pre-tax price by the tax rate expressed as a decimal. For an 8% rate on a $50 item: $50 x 0.08 = $4.00 tax, giving a total of $54.00. The formula is: Tax Amount = Pre-tax Price x (Tax Rate / 100). Enter the price and rate above and the calculator does this instantly.</p> <h3>How do I remove sales tax from a total price?</h3> <p>Divide the tax-inclusive total by (1 + Tax Rate / 100). For a $54.00 total at 8%: $54 / 1.08 = $50.00 pre-tax. The tax was $4.00. Don't subtract the percentage directly from the total - that method gives the wrong answer and overstates the tax amount. Use "Remove tax" mode in the calculator above.</p> <h3>Which US states have no sales tax?</h3> <p>Five states have no statewide sales tax: Alaska, Delaware, Montana, New Hampshire, and Oregon. Delaware, Montana, New Hampshire, and Oregon also have no local sales taxes. Alaska has no state tax but allows local taxes, so rates above 0% apply in many Alaskan cities. The other 45 states plus Washington D.C. all levy a state sales tax.</p> <h3>What is the average sales tax rate in the US?</h3> <p>The average combined state and local sales tax rate in the US is approximately 6.6% in 2026, according to the Tax Foundation. State-only rates range from 0% to 7.25% (California). Louisiana and Tennessee top the combined rate rankings at 9.55%, which includes both state and average local taxes stacked together.</p> <h3>Is sales tax the same as VAT?</h3> <p>No. Sales tax is collected only at the final point of sale. VAT is collected at every stage of production, with each business reclaiming the VAT paid on its inputs. VAT is standard across Europe and most of the world; the US uses retail sales tax instead. Prices in VAT countries are usually tax-inclusive; US prices are shown pre-tax and the tax is added at checkout.</p> <QuizBlock topic="sales tax" questions={quizQuestions} pageUrl="https://calculations.tools/tax/sales-tax-calculator" /> <h2 id="related-tools">Related tools</h2> <ul class="related-tools-list"> <li> <span class="tool-icon">🌍</span> <div> <a href="/tax/vat-calculator">VAT Calculator</a> <p>Calculate VAT for European and global purchases - covers standard rates for 40+ countries and works the same as this tool for add and remove modes.</p> </div> </li> <li> <span class="tool-icon">🌏</span> <div> <a href="/tax/gst-calculator">GST Calculator</a> <p>Calculate GST for Australia, New Zealand, Singapore, Canada, and India - with presets for all Canadian provinces and India's four GST slabs.</p> </div> </li> <li> <span class="tool-icon">%</span> <div> <a href="/math/percentage-calculator">Percentage Calculator</a> <p>Sales tax is a percentage calculation - use this to calculate any percentage of a number, or find what percentage one value is of another.</p> </div> </li> <li> <span class="tool-icon">📅</span> <div> <a href="/finance/annual-income-calculator">Annual Income Calculator</a> <p>Know your annual earnings before deciding how much of a purchase you can afford after tax is added at checkout.</p> </div> </li> <li> <span class="tool-icon">💵</span> <div> <a href="/finance/salary-to-hourly-calculator">Salary to Hourly Calculator</a> <p>Convert your salary to an hourly rate to understand the real cost of any purchase in hours worked.</p> </div> </li> <li> <span class="tool-icon">🏦</span> <div> <a href="/finance/loan-payment-calculator">Loan Payment Calculator</a> <p>When financing a large purchase, use this to calculate the monthly payment on the tax-inclusive total.</p> </div> </li> </ul> </div>
    </div>
  </main>
  <script src="/js/sales-tax-calculator-global.js" is:inline></script>
</BaseLayout>
<style>
  .stax-hub { min-height: 100vh; }
  .stax-hub-hero {
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding: 2.5rem 1.5rem 2rem;
  }
  .stax-hub-hero-inner { max-width: 900px; margin: 0 auto; }
  .stax-hub-hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: white;
    margin: 0 0 0.75rem;
  }
  .stax-hub-lead {
    font-size: 1rem;
    color: rgba(255,255,255,0.65);
    max-width: 640px;
    line-height: 1.6;
