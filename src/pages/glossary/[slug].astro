---
import GlossaryLayout from '../../layouts/GlossaryLayout.astro';
import Formula from '../../components/Formula.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import QuizBlock from '../../components/QuizBlock.astro';
import { GLOSSARY_TERMS } from '../../data/glossary';
import { GLOSSARY_CONTENT } from '../../data/glossary-content';
import HelpfulVote from '../../components/HelpfulVote.astro';

export function getStaticPaths() {
  return GLOSSARY_TERMS.map(t => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const term = GLOSSARY_TERMS.find(t => t.slug === slug)!;
const content = GLOSSARY_CONTENT[slug];

const idx = GLOSSARY_TERMS.findIndex(t => t.slug === slug);
const prev = idx > 0 ? GLOSSARY_TERMS[idx - 1] : null;
const next = idx < GLOSSARY_TERMS.length - 1 ? GLOSSARY_TERMS[idx + 1] : null;

const relatedTermObjects = (term.relatedTerms ?? [])
  .map(s => GLOSSARY_TERMS.find(t => t.slug === s))
  .filter(Boolean) as typeof GLOSSARY_TERMS;

const ogFormulaText = term.formula
  ? term.formula
      .replace(/\$\$?/g, '')
      .replace(/\\frac\{([^}]+)\}\{([^}]+)\}/g, '$1 / $2')
      .replace(/\\text\{([^}]+)\}/g, '$1')
      .replace(/\\cdot/g, '×')
      .replace(/\\[a-zA-Z]+/g, '')
      .replace(/[{}]/g, '')
      .trim()
  : '';

const ogImage = `https://calculations-image-generator.vercel.app/api/og-glossary?category=${encodeURIComponent(term.siteCategory)}&term=${encodeURIComponent(term.term)}&formula=${encodeURIComponent(ogFormulaText)}&definition=${encodeURIComponent(term.shortDef.slice(0, 300))}`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "name": term.term,
    "description": term.shortDef,
    "url": `https://calculations.tools/glossary/${slug}`,
    "inDefinedTermSet": {
      "@type": "DefinedTermSet",
      "name": "Finance & Math Glossary",
      "url": "https://calculations.tools/glossary",
    },
  },
  ...(content?.faqs?.length ? [{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": content.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a },
    })),
  }] : []),
];
---

<GlossaryLayout
  title={term.term}
  metaTitle={`${term.term} - Definition, Formula & Examples`}
  description={term.shortDef}
  canonical={`https://calculations.tools/glossary/${slug}`}
  schema={schema}
  ogImage={ogImage}
>
  <div class="gl-term-page">

    <div class="gl-term-meta">
      <a href="/glossary" class="gl-back-link">← Glossary</a>
      <span class="glossary-category-badge">{term.siteCategory} · {term.category}</span>
    </div>

    <h1 class="gl-term-h1">{term.term}</h1>

    {(term.relatedTools ?? []).length > 0 && (
      <a href={(term.relatedTools ?? [])[0]} class="glossary-tool-cta">Use the {term.term} Calculator →</a>
    )}

    {content?.quiz && (
      <a href="#quiz" class="glossary-quiz-cta">Try the {term.term} Quiz →</a>
    )}

    <div class="answer-box">
      <span class="answer-box-label">Definition</span>
      <p>{term.shortDef}</p>
    </div>

    {content?.keyTakeaways && content.keyTakeaways.length > 0 && (
      <div class="gl-key-takeaways answer-box">
        <span class="answer-box-label">Key takeaways</span>
        <ul>
          {content.keyTakeaways.map(item => <li>{item}</li>)}
        </ul>
      </div>
    )}

    {term.formula && (
      <div class="gl-formula-box">
        <Formula expr={term.formula} />
      </div>
    )}

    <HelpfulVote canonical={`https://calculations.tools/glossary/${slug}`} variant="blog" />
    <h2 class="gl-what-is">What is {term.term}?</h2>
    {content?.definition.map(para => <p>{para}</p>)}

    {content?.beginnerExplain && (
      <>
        <h3 id="explained-to-beginner">{term.term} explained to a beginner</h3>
        {content?.beginnerExplain.map(para => <p>{para}</p>)}
      </>
    )}

    {content?.whenToUse && (
      <>
        <h2>When to use {term.term}</h2>
        <p>{content.whenToUse}</p>
      </>
    )}

    {content?.examples && (
      <>
        <h2>Worked examples for {term.term}</h2>
        <p>This table quickly gives you the overview you need to understand {term.term} and its most important comparisons.</p>
        <div class="responsive-table">
          <table>
            <thead>
              <tr>{content.examples.headers.map(h => <th>{h}</th>)}</tr>
            </thead>
            <tbody>
              {content.examples.rows.map(row => (
                <tr>{row.map(cell => <td>{cell}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}

    {content?.pitfalls && (
      <>
        <h2>Common pitfalls</h2>
        <p>{content.pitfalls}</p>
      </>
    )}

    {content?.fastFact && (
      <div class="gl-fast-fact">
        <span class="gl-fast-fact-label">Fast fact</span>
        <p>{content.fastFact}</p>
      </div>
    )}

    {content?.faqs?.length > 0 && (
      <>
        <h2>Frequently asked questions about {term.term}</h2>
        {content.faqs.map(faq => (
          <>
            <h3>{faq.q}</h3>
            <p>{faq.a}</p>
          </>
        ))}
      </>
    )}

    {content?.quiz && (
      <QuizBlock
        topic={content.quiz.topic}
        questions={content.quiz.questions}
        pageUrl={`https://calculations.tools/glossary/${slug}`}
      />
    )}

    {relatedTermObjects.length > 0 && (
      <>
        <h2>Related terms</h2>
        <div class="glossary-related-terms">
          {relatedTermObjects.map(rt => (
            <a href={`/glossary/${rt.slug}`} class="glossary-related-term-link">{rt.term}</a>
          ))}
        </div>
      </>
    )}

    {(term.relatedTools ?? []).length > 0 && (
      <>
        <h2>Related calculators</h2>
        <RelatedTools tools={(term.relatedTools ?? []).map(p => ({ path: p }))} />
      </>
    )}

    <nav class="gl-prev-next">
      {prev
        ? <a href={`/glossary/${prev.slug}`} class="glossary-nav-prev">← {prev.term}</a>
        : <span></span>
      }
      {next
        ? <a href={`/glossary/${next.slug}`} class="glossary-nav-next">{next.term} →</a>
        : <span></span>
      }
    </nav>

  </div>
</GlossaryLayout>

<style is:global>
  .gl-term-page {
    max-width: 720px;
  }
  .gl-term-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .gl-back-link {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: color 0.15s;
  }
  .gl-back-link:hover { color: white; }
  .gl-term-h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: white;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }
  .gl-formula-box {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-left: 3px solid rgba(139,92,246,0.7);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
    overflow-x: auto;
  }
  .gl-key-takeaways ul {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .gl-key-takeaways li {
    color: rgba(255,255,255,0.82);
    font-size: 0.925rem;
    line-height: 1.55;
  }
  .gl-fast-fact {
    background: rgba(234,179,8,0.06);
    border: 1px solid rgba(234,179,8,0.2);
    border-left: 3px solid rgba(234,179,8,0.7);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }
  .gl-fast-fact p {
    margin: 0;
    color: rgba(255,255,255,0.85);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .gl-fast-fact-label {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(234,179,8,0.9);
    margin-bottom: 0.5rem;
  }
  .gl-what-is {
    margin-top: 2rem;
  }
  .gl-prev-next {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .glossary-tool-cta { display: block; width: 100%; text-align: center; padding: 0.7rem 1rem; border-radius: 10px; background: linear-gradient(135deg, rgba(99,102,241,0.8), rgba(139,92,246,0.8)); color: white; font-size: 0.875rem; font-weight: 600; text-decoration: none; margin-top: 1.25rem; transition: opacity 0.3s; }
  .glossary-tool-cta:hover { opacity: 0.85; }
  a.glossary-quiz-cta {
    display: block;
    width: 100%;
    text-align: center;
    padding: 0.7rem 1rem;
    border: 2px solid;
    border-color: var(--brand-to);
    border-radius: 10px;
    color: white;
    font-size: 0.875rem;
    font-weight: 600;
    margin: .75rem 0;
    transition: background 0.3s;
}
  a.glossary-quiz-cta:hover {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.8), rgba(139, 92, 246, 0.8));
  }
</style>
