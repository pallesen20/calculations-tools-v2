  {
    q: 'How many years out of every 400-year Gregorian cycle have 53 ISO weeks?',
    options: ['52', '71', '84', '97'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'The page states that exactly 71 out of every 400 years have 53 ISO weeks, with the remaining 329 having 52. This ratio repeats precisely every four centuries.',
  },
  {
    q: 'In SQL Server, which DATEPART argument returns the correct ISO 8601 week number?',
    options: ['DATEPART(wk, ...)', 'DATEPART(week, ...)', 'DATEPART(isowk, ...)', 'DATEPART(isoweek, ...)'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'The page warns that DATEPART(wk, ...) returns US-style weeks anchored to January 1, giving the wrong result in early January and late December. The correct argument for ISO 8601 is isowk.',
