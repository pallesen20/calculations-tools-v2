  {
    q: 'Using the formula on this page, what dates does Week 34 of 2026 cover?',
    options: ['August 10-16', 'August 17-23', 'August 24-30', 'August 3-9'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'The page works through the calculation: January 4, 2026 is a Sunday, so Week 1 starts December 29, 2025. Adding (34-1) x 7 = 231 days gives Monday August 17. Week 34 runs August 17 to Sunday August 23.',
  },
  {
    q: 'Which day of the week determines where Week 1 falls under ISO 8601?',
    options: ['Monday', 'Wednesday', 'Thursday', 'Saturday'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'ISO 8601 uses the first-Thursday rule: Week 1 is the calendar week containing the first Thursday of January. This guarantees Week 1 always has at least 4 days in the new year.',
