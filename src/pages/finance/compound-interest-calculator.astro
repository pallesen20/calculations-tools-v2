---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Formula from '../../components/Formula.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedGlossaryTerms from '../../components/RelatedGlossaryTerms.astro';
import FinanceDisclaimer from '../../components/FinanceDisclaimer.astro';
import type { Source } from '../../components/Sources.astro';

const f = {
  ci:       "$$A = P\\left(1 + \\frac{r}{n}\\right)^{nt}$$",
  simple:   "$$A_{\\text{simple}} = P(1 + rt)$$",
  cont:     "$$A = Pe^{rt}$$",
  doubling: "$$t = \\frac{\\ln 2}{n \\cdot \\ln\\!\\left(1 + \\frac{r}{n}\\right)} \\approx \\frac{72}{r\\%}$$",
};

const sources: Source[] = [
  {
    author: 'U.S. Securities and Exchange Commission',
    title: 'Compound Interest',
    journal: 'Investor.gov',
    year: 2024,
    url: 'https://www.investor.gov/introduction-investing/investing-basics/glossary/compound-interest',
  },
  {
    author: 'U.S. Securities and Exchange Commission',
    title: 'What is Compound Interest?',
    journal: 'Investor.gov',
    year: 2024,
    url: 'https://www.investor.gov/additional-resources/information/youth/teachers-classroom-resources/what-compound-interest',
  },
];

const tocItems = [
  { id: 'how-to-use',    label: 'How to use' },
  { id: 'what-is',              label: 'Compound interest explained' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'formula',              label: 'Compound interest formula' },
  { id: 'vs-simple',     label: 'Compound vs. simple interest' },
  { id: 'frequency',     label: 'Compounding frequency' },
  { id: 'examples',      label: 'Worked examples' },
  { id: 'rule-of-72',    label: 'Rule of 72' },
  { id: 'faq',           label: 'FAQs' },
  { id: 'related-tools', label: 'Related tools' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Compound Interest Calculator",
    "url": "https://calculations.tools/finance/compound-interest-calculator",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Any",
    "description": "Calculate compound interest for any principal, rate, compounding frequency, and time period. Shows future value, total interest earned, and a year-by-year growth table.",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is compound interest?",
        "acceptedAnswer": { "@type": "Answer", "text": "Compound interest is interest calculated on both the initial principal and the accumulated interest from previous periods. Unlike simple interest (which only applies to the original principal), compound interest causes growth to accelerate over time because each period's interest becomes part of the base for the next period. This is the mechanism behind exponential financial growth." }
      },
      {
        "@type": "Question",
        "name": "What is the compound interest formula?",
        "acceptedAnswer": { "@type": "Answer", "text": "A = P(1 + r/n)^(nt), where A is the future value, P is the principal, r is the annual interest rate as a decimal, n is the number of compounding periods per year, and t is the number of years. For example: $10,000 at 8% compounded monthly for 10 years = $10,000 × (1 + 0.08/12)^(12×10) = $22,196." }
      },
      {
        "@type": "Question",
        "name": "How does compounding frequency affect growth?",
        "acceptedAnswer": { "@type": "Answer", "text": "More frequent compounding produces slightly more interest. At 10% annual rate on $10,000 for 1 year: annually = $11,000 (10% gain); monthly = $11,047 (10.47%); daily = $11,052 (10.52%). The difference between monthly and daily compounding is minimal, but the difference between annual and continuous compounding is significant at higher rates and longer timeframes." }
      },
      {
        "@type": "Question",
        "name": "What is the Rule of 72?",
        "acceptedAnswer": { "@type": "Answer", "text": "The Rule of 72 is a mental shortcut to estimate how long it takes for an investment to double: divide 72 by the annual interest rate. At 6% per year, your money doubles in roughly 72/6 = 12 years. At 9%, it doubles in 8 years. The rule is an approximation - the exact formula uses logarithms - but it is accurate to within 10% for rates between 1% and 25%." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between compound interest and simple interest?",
        "acceptedAnswer": { "@type": "Answer", "text": "Simple interest: A = P(1 + rt) - interest is earned only on the original principal. Compound interest: A = P(1 + r/n)^(nt) - interest is earned on principal plus accumulated interest. Over time, the difference compounds dramatically. $10,000 at 8% for 30 years: simple interest = $34,000; compound (annual) = $100,627; compound (monthly) = $109,882." }
      }
    ]
  }
];
---

<CalculatorLayout
  title="Compound Interest Calculator"
  youtubeId="vyQYTns-Y8s"
  youtubeUploadDate="2026-05-06"
  youtubeSummary="Keep an eye out when setting the compounding frequency. A simple mistake would be setting it to yearly when most savings accounts and investments compound monthly or daily. You can check your account terms for the compounding frequency - monthly is the most common for savings accounts and gives a noticeably different result over long periods."
  metaTitle="Compound Interest Calculator - Formula & Growth Table"
  description="Calculate compound interest for any principal, rate, frequency, and time. Compare two scenarios side by side - different timelines or rates - to see the exact amount difference instantly."
  canonical="https://calculations.tools/finance/compound-interest-calculator"
  tocItems={tocItems}
  schema={schema}
  sources={sources}
  embedSlug="compound-interest-calculator"
  ogFormula="A = P(1 + r/n)^(nt)"
  ogExample="$10,000 at 8% monthly for 10 yrs = $22,196"
>
  <div slot="calculator">
    <section class="calculator-interface">
      <div class="calculator-container bmi-container">
        <div class="calculator-header">
          <h2>Calculate Compound Interest Instantly</h2>
          <p>See how your money grows with the power of compounding</p>
        </div>
        <div class="bmi-field">
          <label class="bmi-label" for="ci-principal">Principal (starting amount)</label>
          <div class="bmi-input-wrap">
            <input type="text" inputmode="decimal" id="ci-principal" class="bmi-input" placeholder="e.g. 10000" />
          </div>
        </div>
        <div class="bmi-field">
          <label class="bmi-label" for="ci-rate">Annual Interest Rate (%)</label>
          <div class="bmi-input-wrap">
            <input type="text" inputmode="decimal" id="ci-rate" class="bmi-input" placeholder="e.g. 8" />
          </div>
        </div>
        <div class="bmi-field">
          <label class="bmi-label" for="ci-years">Time Period (years)</label>
          <div class="bmi-input-wrap">
            <input type="text" inputmode="decimal" id="ci-years" class="bmi-input" placeholder="e.g. 10" />
          </div>
        </div>
        <div class="bmi-field">
          <label class="bmi-label" for="ci-n">Compounding Frequency (times per year)</label>
          <div class="bmi-input-wrap">
            <input type="text" inputmode="decimal" id="ci-n" class="bmi-input" placeholder="12 = monthly (default)" />
          </div>
        </div>
        <div class="ci-compare-wrap">
          <button id="ci-compare-btn" type="button" class="ci-compare-btn">&#x21C4; Compare two scenarios</button>
