const f = {
  roce:  "$$\\text{ROCE} = \\frac{\\text{EBIT}}{\\text{Capital Employed}} \\times 100$$",
  ce:    "$$\\text{Capital Employed} = \\text{Total Assets} - \\text{Current Liabilities}$$",
  ceAlt: "$$\\text{Capital Employed} = \\text{Shareholders' Equity} + \\text{Long-term Debt}$$",
};

const sources: Source[] = [
  {
    author: 'CFA Institute',
    title: 'Capital Investments and Capital Allocation',
    journal: 'CFA Institute Professional Learning',
