    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to calculate ROCE",
    "description": "Calculate Return on Capital Employed using EBIT and balance sheet figures.",
