      'Manufacturing (capital-intensive)',
    ] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'Software and technology companies are asset-light - they require very little physical capital to operate. This keeps the Capital Employed denominator small, producing high ROCE (often 30-60%+). Capital-intensive sectors like utilities and oil & gas have large asset bases, compressing their ROCE to 8-15%.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const schema = [
  {
