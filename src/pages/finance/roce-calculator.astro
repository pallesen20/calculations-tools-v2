      { "@type": "HowToStep", "position": 1, "name": "Enter EBIT", "text": "Type in the company's EBIT (Earnings Before Interest and Tax) from the income statement." },
      { "@type": "HowToStep", "position": 2, "name": "Enter Total Assets", "text": "Enter the Total Assets figure from the balance sheet - typically the bottom-line total on the asset side." },
      { "@type": "HowToStep", "position": 3, "name": "Enter Current Liabilities", "text": "Enter Current Liabilities from the balance sheet. These are obligations due within one year." },
      { "@type": "HowToStep", "position": 4, "name": "Read the result", "text": "The calculator computes Capital Employed (Total Assets minus Current Liabilities) and ROCE (EBIT / Capital Employed x 100), with an interpretation badge." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
