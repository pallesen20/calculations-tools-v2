        { path: '/finance/roi-calculator',                 blurb: 'Calculate ROI, multiple, and annualized return on any investment.' },
        { path: '/finance/gross-profit-margin-calculator', blurb: 'Gross profit margin from revenue and cost of goods sold.' },
        { path: '/math/percentage-calculator',             blurb: 'General percentage and percentage change calculator.' },
      ]} />

      <RelatedGlossaryTerms toolPath="/finance/break-even-calculator" />

    </div>
  </div>

</CalculatorLayout>

