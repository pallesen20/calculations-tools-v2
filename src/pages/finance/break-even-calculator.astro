const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Break-Even Calculator",
    "url": "https://calculations.tools/finance/break-even-calculator",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Any",
    "description": "Calculate break-even point in units and revenue from fixed costs, selling price, and variable cost per unit. Shows contribution margin and CM ratio.",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a break-even point?",
        "acceptedAnswer": { "@type": "Answer", "text": "The break-even point is the level of sales at which total revenue exactly equals total costs - neither profit nor loss is made. Below the break-even point, the business loses money; above it, the business makes a profit. Break-even can be expressed in units (how many products must be sold) or revenue (how much total sales are needed)." }
      },
      {
        "@type": "Question",
        "name": "What is the break-even formula?",
        "acceptedAnswer": { "@type": "Answer", "text": "Break-Even Units = Fixed Costs / Contribution Margin per Unit. Break-Even Revenue = Fixed Costs / CM Ratio. Contribution Margin = Selling Price − Variable Cost per Unit. CM Ratio = Contribution Margin / Selling Price. For example: Fixed costs $50,000, selling price $100, variable cost $60 → CM = $40, CM ratio = 40%, Break-even = 1,250 units or $125,000 revenue." }
      },
      {
        "@type": "Question",
        "name": "What are fixed costs and variable costs?",
        "acceptedAnswer": { "@type": "Answer", "text": "Fixed costs stay constant regardless of production volume - rent, salaries, insurance, software subscriptions, loan payments. Variable costs change directly with production or sales volume - raw materials, packaging, direct labour paid per unit, sales commissions, shipping. The distinction is critical: fixed costs create the 'floor' you must cover before making a profit; variable costs determine how much margin each additional unit contributes." }
      },
      {
        "@type": "Question",
        "name": "What is contribution margin?",
        "acceptedAnswer": { "@type": "Answer", "text": "Contribution margin (CM) is the amount each unit sold contributes to covering fixed costs and generating profit. CM = Selling Price − Variable Cost per Unit. If you sell a product for $100 and variable costs are $60, CM = $40. Every unit sold after break-even adds $40 in pure profit. The CM ratio (CM / Selling Price × 100) expresses this as a percentage of revenue - useful for comparing products with different price points." }
      },
      {
        "@type": "Question",
        "name": "How does the break-even point help in business planning?",
        "acceptedAnswer": { "@type": "Answer", "text": "Break-even analysis answers the most fundamental business question: how many units do I need to sell to stop losing money? It helps with: pricing decisions (if variable costs rise, what price increase is needed to maintain break-even?), cost structure decisions (should I hire employees at fixed salary or use contractors at variable cost?), investment decisions (if I add a new production line, how much extra sales volume is needed to justify it?), and risk assessment (how far can sales drop before we lose money - the margin of safety)." }
      }
    ]
  }
