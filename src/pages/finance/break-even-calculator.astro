    ] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'MOS = ($200,000 - $125,000) / $200,000 x 100 = 37.5%. The page states a margin of safety above 20% is generally considered healthy; below 10% indicates vulnerability. At 37.5%, this business has a solid buffer.',
