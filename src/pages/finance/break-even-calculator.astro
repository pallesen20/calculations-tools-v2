---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Formula from '../../components/Formula.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedGlossaryTerms from '../../components/RelatedGlossaryTerms.astro';
import QuizBlock from '../../components/QuizBlock.astro';

const f = {
  cm:         "$$\\text{Contribution Margin} = \\text{Selling Price} - \\text{Variable Cost per Unit}$$",
  cmRatio:    "$$\\text{CM Ratio} = \\frac{\\text{Contribution Margin}}{\\text{Selling Price}} \\times 100$$",
  beUnits:    "$$\\text{Break-Even Units} = \\frac{\\text{Fixed Costs}}{\\text{Contribution Margin per Unit}}$$",
  beRevenue:  "$$\\text{Break-Even Revenue} = \\frac{\\text{Fixed Costs}}{\\text{CM Ratio}}$$",
  mos:        "$$\\text{Margin of Safety} = \\frac{\\text{Actual Revenue} - \\text{Break-Even Revenue}}{\\text{Actual Revenue}} \\times 100$$",
};

const tocItems = [
  { id: 'how-to-use',           label: 'How to use' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'formula',              label: 'Break-even formula' },
  { id: 'cm',            label: 'Contribution margin' },
  { id: 'examples',      label: 'Worked examples' },
  { id: 'margin-safety', label: 'Margin of safety' },
  { id: 'applications',  label: 'Business applications' },
  { id: 'faq',           label: 'FAQs' },
  { id: 'quiz',          label: 'Quiz: test your knowledge' },
  { id: 'related-tools', label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'What does contribution margin measure, according to this page?',
    options: [
      'Total revenue minus all fixed costs for the period',
      'The amount each unit sold contributes to covering fixed costs and generating profit',
      'The percentage of revenue retained as net profit after all expenses',
      'Annual sales volume required to recover the initial investment',
    ] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Contribution margin (CM) = Selling Price minus Variable Cost per Unit. It represents what each unit contributes first to covering fixed costs, and then to profit once fixed costs are fully covered.',
