---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import QuizBlock from '../components/QuizBlock.astro';
import type { Source } from '../components/Sources.astro';
import RelatedGlossaryTerms from '../components/RelatedGlossaryTerms.astro';

const tocItems = [
  { id: 'how-to-use',           label: 'How to use this calculator' },
  { id: 'explained-to-beginner', label: 'Explained to a beginner' },
  { id: 'days-between',         label: 'Days between dates' },
  { id: 'workdays',         label: 'Workdays vs calendar days' },
  { id: 'add-subtract',     label: 'Adding and subtracting days' },
  { id: 'month-arithmetic', label: 'Month and year arithmetic' },
  { id: 'excel-formulas',   label: 'Excel & Sheets formulas' },
  { id: 'common-mistakes',  label: 'Common mistakes' },
  { id: 'faq',              label: 'FAQs' },
  { id: 'quiz',             label: 'Quiz: test your knowledge' },
  { id: 'related-tools',    label: 'Related tools' },
];

const quizQuestions = [
  {
    q: 'This calculator uses "exclusive counting." What does that mean for January 1 to January 5?',
    options: ['Both dates are counted, giving 5 days', 'Only the start date is counted, giving 1 day', 'The start date is not counted and the end date is, giving 4 days', 'Neither date is counted, giving 3 days'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'Exclusive counting means the start date is not counted but the end date is. January 1 to January 5 = 4 days (Jan 2, 3, 4, 5). If your context requires inclusive counting - both dates counted - add 1 to the result.',
  },
  {
    q: 'How many workdays does a standard calendar year typically contain?',
    options: ['About 250', 'About 255', 'About 261 (range: 260-262)', 'About 270'] as [string, string, string, string],
    correct: 2 as const,
    explanation: 'A standard year contains approximately 261 workdays, ranging between 260 and 262 depending on how weekends align with January 1 and December 31. A typical month averages 21-22 workdays.',
  },
  {
    q: 'A Net 30 invoice is issued on a Tuesday. When is payment due under standard payment terms?',
    options: ['30 workdays later (Mon-Fri only)', '30 calendar days later regardless of weekends', 'The last business day of the following month', '4 weeks later'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'Net 30 and similar payment terms count calendar days, not workdays. A 30-day invoice is due exactly 30 calendar days later regardless of weekends or public holidays.',
  },
  {
    q: 'How does Excel\'s NETWORKDAYS(A1,B1) result compare to this calculator\'s workday count for the same range?',
    options: ['Exactly the same', 'One more - NETWORKDAYS counts both start and end dates as workdays (inclusive)', 'One fewer - NETWORKDAYS excludes the start date', 'Different only when the range crosses a leap year'] as [string, string, string, string],
    correct: 1 as const,
    explanation: 'NETWORKDAYS gives an inclusive count, treating both start and end dates as workdays when they fall on weekdays. This calculator uses exclusive counting (start not counted), so NETWORKDAYS returns 1 more than this calculator\'s workday figure when both dates are weekdays.',
  },
  {
    q: 'What is the result of adding one calendar month to January 31?',
    options: ['March 3', 'March 1', 'February 28 or 29', 'February 1'] as [string, string, string, string],
    correct: 2 as const,
    explanation: '"Add 1 month" and "add 30 days" are different operations. One calendar month from January 31 lands on February 28 or 29 - the last valid day of February. Some programming languages overflow to March 3 instead, which is a common source of billing system bugs.',
  },
] satisfies { q: string; options: [string, string, string, string]; correct: 0 | 1 | 2 | 3; explanation: string }[];

const sources: Source[] = [
  {
    author: 'Wikipedia contributors',
    title: 'Leap year',
    journal: 'Wikipedia',
    year: 2024,
    url: 'https://en.wikipedia.org/wiki/Leap_year',
  },
  {
    author: 'Microsoft',
    title: 'DATEDIF function',
    journal: 'Microsoft Support',
    year: 2024,
    url: 'https://support.microsoft.com/en-us/office/datedif-function-25dba1a4-2812-480b-84dd-8b32a451b35c',
  },
  {
    author: 'Microsoft',
    title: 'WORKDAY function',
    journal: 'Microsoft Support',
    year: 2024,
    url: 'https://support.microsoft.com/en-us/office/workday-function-f764a5b7-05fc-4494-9486-60d494efbf33',
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Date Calculator",
    "url": "https://calculations.tools/date-calculator",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Any",
    "description": "Calculate the number of days between two dates or add and subtract days from any date. Shows total days, workdays, weeks, years, months, and days. Free, instant, no sign-up.",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to calculate the number of days between two dates",
    "description": "Use this date calculator to find the difference between two dates in days, weeks, workdays, and a years-months-days breakdown.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter your start date", "text": "Type or pick your start date in the first date field. Click the Today button to use today's date." },
      { "@type": "HowToStep", "position": 2, "name": "Enter your end date", "text": "Type or pick your end date in the second date field. The calculator accepts dates in either order." },
      { "@type": "HowToStep", "position": 3, "name": "Read the results", "text": "The calculator instantly shows the difference as total days, weeks, workdays (Monday to Friday), a years-months-days breakdown, hours, and minutes." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How do I calculate the number of days between two dates?", "acceptedAnswer": { "@type": "Answer", "text": "Subtract the earlier date from the later date. Each calendar day counts as 1. For example, January 1 to March 1 is 59 days in a non-leap year and 60 days in a leap year. This calculator shows the result in days, weeks, workdays, and a years-months-days breakdown." } },
      { "@type": "Question", "name": "How many days are between two dates?", "acceptedAnswer": { "@type": "Answer", "text": "Enter both dates in the Date Difference tab. The calculator shows the exact count instantly in total days, workdays, weeks, and years-months-days. No button press is needed - results update as you change the dates." } },
      { "@type": "Question", "name": "How do I add days to a date?", "acceptedAnswer": { "@type": "Answer", "text": "Switch to the Add / Subtract tab. Enter your start date, select Add, enter the number of days, and the resulting date appears instantly along with its day of the week and ISO week number." } },
      { "@type": "Question", "name": "What counts as a workday in this calculator?", "acceptedAnswer": { "@type": "Answer", "text": "Monday through Friday. Saturdays and Sundays are excluded. Public holidays are not excluded because they vary by country, region, and employer. To adjust for holidays, subtract the number of public holidays in the period from the workday total." } },
      { "@type": "Question", "name": "Does February have 28 or 29 days?", "acceptedAnswer": { "@type": "Answer", "text": "February has 28 days in non-leap years and 29 days in leap years. A year is a leap year if divisible by 4, except for years divisible by 100, which must also be divisible by 400. This calculator handles leap years automatically." } },
      { "@type": "Question", "name": "How do I calculate the number of days between two dates in Excel?", "acceptedAnswer": { "@type": "Answer", "text": "Use =B1-A1 and format the result as a number. For workdays only, use =NETWORKDAYS(A1,B1). For a years-months-days breakdown, use DATEDIF: =DATEDIF(A1,B1,\"Y\") for years, =DATEDIF(A1,B1,\"YM\") for remaining months, =DATEDIF(A1,B1,\"MD\") for remaining days." } },
      { "@type": "Question", "name": "Why is the months calculation sometimes surprising?", "acceptedAnswer": { "@type": "Answer", "text": "Month arithmetic is not simply adding 30 days. Calendar months have different lengths (28-31 days). January 31 plus one month is February 28 or 29, not March 3. This calculator uses standard date arithmetic: counting complete calendar months that have elapsed, then remaining days." } },
      { "@type": "Question", "name": "How do I find what date is 90 days from today?", "acceptedAnswer": { "@type": "Answer", "text": "Switch to the Add / Subtract tab. Click Today to set the start date, select Add, and enter 90 in the days field. The resulting date appears instantly. This is useful for calculating deadlines, expiration dates, notice periods, and contract terms." } }
    ]
  }
