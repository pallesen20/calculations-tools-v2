---
import EmbedLayout from '../../layouts/EmbedLayout.astro';
---

<EmbedLayout title="ADHD Break Calculator - calculations.tools">
  <section class="calculator-interface">
    <div class="calculator-container" style="display:flex;flex-direction:column;gap:0.9rem;">
      <div class="calculator-header">
        <h2>ADHD Break Calculator</h2>
        <p>Personalised focus blocks and break intervals</p>
      </div>

      <div class="bmi-field">
        <label class="bmi-label" for="adb-focus-time">Your typical focus time (minutes)</label>
        <div class="bmi-input-wrap">
          <input type="text" inputmode="decimal" id="adb-focus-time" class="bmi-input" placeholder="e.g. 20" value="20" />
          <span class="bmi-unit-tag">min</span>
        </div>
      </div>

      <div class="bmi-field">
        <label class="bmi-label">Task type</label>
        <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-top:0.25rem;">
          <button class="adb-task-btn bmi-unit-btn" data-task="routine">Routine</button>
          <button class="adb-task-btn bmi-unit-btn active" data-task="moderate">Moderate</button>
          <button class="adb-task-btn bmi-unit-btn" data-task="deep">Deep work</button>
        </div>
      </div>

      <div class="bmi-field" style="flex-direction:row;align-items:center;gap:0.6rem;cursor:pointer;">
        <input type="checkbox" id="adb-medication" style="width:1rem;height:1rem;accent-color:#818cf8;flex-shrink:0;cursor:pointer;" />
        <label class="bmi-label" for="adb-medication" style="margin:0;cursor:pointer;">Taking ADHD medication today</label>
      </div>

      <div class="bmi-field">
        <label class="bmi-label" for="adb-session-hours">Total session length (optional)</label>
        <div class="bmi-input-wrap">
          <input type="text" inputmode="decimal" id="adb-session-hours" class="bmi-input" placeholder="e.g. 3" />
          <span class="bmi-unit-tag">hours</span>
        </div>
      </div>

      <div id="adb-result"></div>

      <div class="abr-attribution">
        <a href="https://calculations.tools/health/adhd-break-calculator" target="_blank" rel="noopener">
          calculations.tools
        </a>
      </div>
    </div>
  </section>

  <script src="/js/adhd-break-calculator.js" is:inline></script>
</EmbedLayout>

<style is:global>
  .calculator-interface {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 1.25rem;
  }
  .calculator-container {
    width: 100%;
    max-width: 420px;
  }
  .adb-result-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 480px) { .adb-result-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 300px) { .adb-result-grid { grid-template-columns: 1fr; } }
  .adb-result-block {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    padding: 1.1rem;
  }
  .adb-result-block--main {
    background: rgba(167,139,250,0.1);
    border-color: rgba(167,139,250,0.3);
    grid-column: 1 / -1;
  }
  .adb-result-label {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.4);
    margin-bottom: 0.5rem;
  }
  .adb-result-block--main .adb-result-label { color: rgba(167,139,250,0.7); }
  .adb-result-value {
    font-size: 1.35rem;
    font-weight: 700;
    color: white;
    line-height: 1.3;
  }
  .adb-result-block--main .adb-result-value { font-size: 1.8rem; }
  .adb-result-sub {
    font-size: 0.68rem;
    color: rgba(255,255,255,0.4);
    margin-top: 0.35rem;
  }
  .adb-result-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .adb-detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 0.75rem;
    background: rgba(255,255,255,0.03);
    border-radius: 6px;
    font-size: 0.8rem;
  }
  .adb-detail-label { color: rgba(255,255,255,0.5); }
  .adb-detail-value { color: rgba(255,255,255,0.85); font-weight: 600; }
  .adb-result-note {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.45);
    margin-top: 1rem;
    text-align: center;
  }
</style>
