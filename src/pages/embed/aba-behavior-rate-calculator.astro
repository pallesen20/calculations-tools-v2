---
import EmbedLayout from '../../layouts/EmbedLayout.astro';
---

<EmbedLayout title="ABA Behavior Rate Calculator - calculations.tools">
  <section class="calculator-interface">
    <div class="calculator-container">
      <div class="calculator-header">
        <h2>ABA Behavior Rate Calculator</h2>
        <p>Frequency rate, duration %, and latency recording</p>
      </div>

      <div class="abr-mode-toggle bmi-unit-toggle">
        <button class="abr-mode-btn bmi-unit-btn active" data-mode="rate">Frequency rate</button>
        <button class="abr-mode-btn bmi-unit-btn" data-mode="duration">Duration %</button>
        <button class="abr-mode-btn bmi-unit-btn" data-mode="latency">Latency</button>
      </div>

      <div id="abr-rate-section">
        <div class="bmi-field">
          <label class="bmi-label" for="abr-count">Response count</label>
          <div class="bmi-input-wrap">
            <input type="text" inputmode="decimal" id="abr-count" class="bmi-input" placeholder="e.g. 24" />
            <span class="bmi-unit-tag">responses</span>
          </div>
        </div>
        <div class="bmi-field">
          <label class="bmi-label" for="abr-obs-time">Observation time</label>
          <div class="bmi-input-wrap">
            <input type="text" inputmode="decimal" id="abr-obs-time" class="bmi-input" placeholder="e.g. 30" />
            <span class="bmi-unit-tag">min</span>
          </div>
        </div>
      </div>

      <div id="abr-duration-section" style="display:none;">
        <div class="bmi-field">
          <label class="bmi-label" for="abr-session">Session length</label>
          <div class="bmi-input-wrap">
            <input type="text" inputmode="decimal" id="abr-session" class="bmi-input" placeholder="e.g. 30" />
            <span class="bmi-unit-tag">min</span>
          </div>
        </div>
        <div class="bmi-field">
          <label class="bmi-label" for="abr-behavior">Behavior duration</label>
          <div class="bmi-input-wrap">
            <input type="text" inputmode="decimal" id="abr-behavior" class="bmi-input" placeholder="e.g. 18" />
            <span class="bmi-unit-tag">min</span>
          </div>
        </div>
      </div>

      <div id="abr-latency-section" style="display:none;">
        <p class="abr-latency-hint">Enter latency in seconds for each trial. Add up to 10 trials.</p>
        <div id="abr-latency-trials"></div>
        <button id="abr-add-trial" class="abr-add-btn">+ Add trial</button>
      </div>

      <div id="abr-result"></div>

      <div class="abr-attribution">
        <a href="https://calculations.tools/health/aba-behavior-rate-calculator" target="_blank" rel="noopener">calculations.tools</a>
      </div>
    </div>
  </section>

  <script src="/js/aba-behavior-rate-calculator.js" is:inline></script>
</EmbedLayout>

<style is:global>
  .calculator-container { padding: 1.25rem; }
  .bmi-unit-toggle { display: flex; background: rgba(255,255,255,0.08); border-radius: 8px; padding: 3px; gap: 2px; margin-bottom: 1.25rem; }
  .bmi-unit-btn { background: transparent; border: none; color: rgba(255,255,255,0.6); font-size: 0.8rem; padding: 0.3rem 0.7rem; border-radius: 6px; cursor: pointer; white-space: nowrap; flex: 1; }
  .bmi-unit-btn.active { background: rgba(255,255,255,0.15); color: white; }
  .bmi-field { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; gap: 0.5rem; }
  .bmi-label { font-size: 0.82rem; color: rgba(255,255,255,0.75); }
  .bmi-input-wrap { display: flex; align-items: center; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; overflow: hidden; }
  .bmi-input { width: 5.5rem; padding: 0.4rem 0.5rem; background: rgba(255,255,255,0.08); border: none; color: white; font-size: 0.9rem; text-align: right; }
  .bmi-unit-tag { padding: 0 0.5rem; background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.55); font-size: 0.8rem; white-space: nowrap; align-self: stretch; display: flex; align-items: center; }
  .abr-attribution { text-align: center; margin-top: 0.75rem; }
  .abr-attribution a { font-size: 0.72rem; color: rgba(255,255,255,0.3); text-decoration: none; }
  .abr-attribution a:hover { color: rgba(255,255,255,0.6); }
</style>
