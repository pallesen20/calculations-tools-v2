---
import EmbedLayout from '../../layouts/EmbedLayout.astro';
---

<EmbedLayout title="m/s to km/h Converter - calculations.tools">
  <section class="calculator-interface">
    <div class="calculator-container">

      <div class="calculator-header">
        <h2>m/s to km/h Converter</h2>
        <p>Type in any field — all units update instantly</p>
      </div>

      <div class="bmi-field">
        <label class="bmi-label" for="sk-ms">Meters per second</label>
        <div class="bmi-input-wrap">
          <input id="sk-ms" class="bmi-input" type="text" inputmode="decimal" placeholder="e.g. 10" />
          <span class="bmi-unit-tag">m/s</span>
        </div>
      </div>

      <div class="bmi-field">
        <label class="bmi-label" for="sk-kmh">Kilometers per hour</label>
        <div class="bmi-input-wrap">
          <input id="sk-kmh" class="bmi-input" type="text" inputmode="decimal" placeholder="e.g. 36" />
          <span class="bmi-unit-tag">km/h</span>
        </div>
      </div>

      <div class="bmi-field">
        <label class="bmi-label" for="sk-mph">Miles per hour</label>
        <div class="bmi-input-wrap">
          <input id="sk-mph" class="bmi-input" type="text" inputmode="decimal" placeholder="e.g. 22.37" />
          <span class="bmi-unit-tag">mph</span>
        </div>
      </div>

      <div class="bmi-field">
        <label class="bmi-label" for="sk-fts">Feet per second</label>
        <div class="bmi-input-wrap">
          <input id="sk-fts" class="bmi-input" type="text" inputmode="decimal" placeholder="e.g. 32.81" />
          <span class="bmi-unit-tag">ft/s</span>
        </div>
      </div>

      <div class="bmi-field">
        <label class="bmi-label" for="sk-kn">Knots</label>
        <div class="bmi-input-wrap">
          <input id="sk-kn" class="bmi-input" type="text" inputmode="decimal" placeholder="e.g. 19.44" />
          <span class="bmi-unit-tag">kn</span>
        </div>
      </div>

      <div class="pair-formula-note">1 m/s = 3.6 km/h = 2.237 mph = 3.281 ft/s = 1.944 kn</div>

    </div>
  </section>

  <script src="/js/ms-to-kmh.js" is:inline></script>
</EmbedLayout>

<style>
  .pair-formula-note { text-align: center; font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 0.5rem; }
</style>
