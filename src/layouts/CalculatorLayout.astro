---
import { execSync } from 'child_process';
import BaseLayout from './BaseLayout.astro';
import Sources from '../components/Sources.astro';
import type { Source } from '../components/Sources.astro';
import { socials } from '../data/socials';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import HelpfulVote from '../components/HelpfulVote.astro';

interface TocItem {
  id: string;
  label: string;
}

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  canonical?: string;
  schema?: object | object[];
  tocItems?: TocItem[];
  embedSlug?: string;
  sources?: Source[];
  ogFormula?: string;
  ogExample?: string;
  noindex?: boolean;
  youtubeId?: string;
  youtubeSummary?: string;
  youtubeUploadDate?: string;
  credential?: string;
}

const { title, metaTitle, description, canonical, schema, tocItems = [], embedSlug, sources, ogFormula, ogExample, noindex, youtubeId, youtubeSummary, youtubeUploadDate, credential: credentialOverride } = Astro.props;

const _pathname = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/index';
const _filePath = `src/pages${_pathname}.astro`;
const _category = _pathname.startsWith('/math') ? 'Math'
  : _pathname.startsWith('/health') ? 'Health'
  : _pathname.startsWith('/conversion') ? 'Conversion'
  : _pathname.startsWith('/finance') ? 'Finance'
  : 'Tools';
const _credential = credentialOverride
  ?? (_category === 'Health'
  ? 'Formulas sourced from WHO & peer-reviewed research'
  : _category === 'Finance'
  ? 'Formulas follow CFA Institute & GAAP standards'
  : _category === 'Conversion' || _category === 'Math'
  ? 'Verified against NIST & ISO reference values'
  : 'Verified against primary reference sources');
const ogImage = (ogFormula && ogExample)
  ? `https://calculations-image-generator.vercel.app/api/og-web?category=${encodeURIComponent(_category)}&calculator=${encodeURIComponent(title)}&formula=${encodeURIComponent(ogFormula)}&example=${encodeURIComponent(ogExample)}`
  : undefined;

const AUTHOR = {
  "@type": "Person",
    "name": "Jesper Pallesen",
    "url": "https://calculations.tools/about-us/jesper-pallesen",
    "sameAs": ["https://www.linkedin.com/in/jesperpallesen20/", "https://gamesevenmarketing.com/", "https://getdutix.com/"],
    "jobTitle": "Founder & Developer",
    "worksFor": {
      "@type": "Organization",
      "name": "Calculations.tools",
      "logo": "https://calculations.tools/open-graph.webp",
      "description": "Free, accurate calculators and converters - no sign-up, no paid content, instant results.",
      "url": "https://calculations.tools",
      "foundingDate": "2025",
      "sameAs": socials.map(s => s.href),
      "areaServed": "Worldwide"
    },
    "description": "SEO strategist, software developer, and former professional hockey player. Founder of calculations.tools.",
    "knowsAbout": ["SEO", "Software Development", "Data Analytics", "Technical SEO", "Content Strategy"]
};

const augmentedSchema = schema
  ? (Array.isArray(schema) ? schema : [schema]).map((s: any) => {
      if (s['@type'] !== 'WebApplication') return s;
      const withImage = (ogImage && !s.image) ? { ...s, image: ogImage } : s;
      const withAuthor = !withImage.author ? { ...withImage, author: AUTHOR } : withImage;
      return !withAuthor.publishingPrinciples ? { ...withAuthor, publishingPrinciples: "https://calculations.tools/editorial-standards" } : withAuthor;
    })
  : schema;

let lastUpdated = '';
try {
  const result = execSync(
    `git log -1 --format="%ci" -- "${_filePath}"`,
    { encoding: 'utf-8' }
  ).trim();
  lastUpdated = result
    ? new Date(result).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
    : new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
} catch {
  lastUpdated = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const embedUrl = embedSlug ? `https://calculations.tools/embed/${embedSlug}` : null;
const iframeSnippet = embedUrl
  ? `<iframe src="${embedUrl}" width="100%" height="480" frameborder="0" style="border-radius:12px"></iframe>`
  : null;
---

<BaseLayout {title} {metaTitle} {description} {canonical} schema={augmentedSchema} {ogImage} usesKatex={true} {noindex}>
  <main class="main-content" style="margin-top: 1rem;">
    <div class="container">
      <div class="calculator-page-container">
        <div class="page-header">
          <h1 class="main-title">{title}</h1>
          <p class="subtitle">{description}</p>
        </div>
        <div class="page-calculator">
          <slot name="calculator" />
          {youtubeId && <YouTubeEmbed id={youtubeId} title={`${title} - Video Tutorial`} summary={youtubeSummary} uploadDate={youtubeUploadDate} />}
        </div>
        <aside class="page-sidebar">
          <div class="info-box">
            <aside>
              <img src="/jesper.webp" height="50" width="50" alt="Jesper Pallesen" />
              <div class="author-box">
                <span class="eyebrow">Created by</span>
                <a class="author" href="/about-us/jesper-pallesen" id="author-link">Jesper Pallesen</a>
              </div>
              <div class="last-updated">
                <span class="eyebrow">Last updated</span>
                <time datetime={lastUpdated}><span>{lastUpdated}</span></time>
              </div>
            </aside>
            <span class="author-credential">{_credential}</span>
            <div class="author-tooltip" id="author-tooltip" role="tooltip" aria-hidden="true">
              <div class="at-header">
                <img src="/jesper.webp" width="52" height="52" alt="Jesper Pallesen" class="at-photo" />
                <div class="at-name-block">
                  <div class="at-name">Jesper Pallesen</div>
                  <a class="at-link" href="https://www.linkedin.com/in/jesperpallesen20/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                </div>
              </div>
              <p class="at-bio">Developer with a Business & Economics degree. Data analytics enthusiast and passionate stock investor. Founder of calculations.tools. Former professional hockey player.</p>
              <div class="at-footer">
                <a href="/about-us/jesper-pallesen" class="at-link">See author page</a>
                <a href="/editorial-standards" class="at-link">See editorial standards</a>
              </div>
            </div>
          </div>
          {tocItems.length > 0 && (
            <nav class="toc" aria-label="Table of contents">
              <p class="toc-title">Table of contents</p>
              <ul class="toc-list">
                {tocItems.map(item => (
                  <li><a href={`#${item.id}`} class="toc-link">{item.label}</a></li>
                ))}
              </ul>
            </nav>
          )}
          <HelpfulVote canonical={canonical ?? '/'} variant="sidebar" />
          {embedUrl && (
            <div class="embed-section">
              <button class="embed-button" id="embedToggle"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:0.5rem"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg> Embed this tool
              </button>
              <div class="embed-panel hidden" id="embedPanel">
                <p class="embed-label">Copy and paste this code into your website:</p>
                <textarea class="embed-code" readonly id="embedCode">{iframeSnippet}</textarea>
                <button class="copy-embed-btn" id="copyEmbedBtn">Copy code</button>
                <p class="embed-attribution">
                  Powered by <a href="https://calculations.tools?utm_source=pre_embed&utm_medium=organic&utm_campaign=embed" target="_blank">calculations.tools</a>
                </p>
              </div>
            </div>
          )}
          {sources && sources.length > 0 && <Sources sources={sources} />}
        </aside>
        <div class="page-content">
          <slot name="content" />
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
<script>
  document.querySelectorAll('.toc-link').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.querySelector((link as HTMLAnchorElement).getAttribute('href')!);
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  const embedToggle = document.getElementById('embedToggle');
  const embedPanel = document.getElementById('embedPanel');
  const copyEmbedBtn = document.getElementById('copyEmbedBtn');
  const embedCode = document.getElementById('embedCode') as HTMLTextAreaElement;

  embedToggle?.addEventListener('click', () => embedPanel?.classList.toggle('hidden'));

  copyEmbedBtn?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(embedCode.value);
    copyEmbedBtn.textContent = 'Copied!';
    setTimeout(() => copyEmbedBtn.textContent = 'Copy code', 2000);
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'embed_code_copied', method: 'button' });
  });

  embedCode?.addEventListener('copy', () => {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'embed_code_copied', method: 'keyboard' });
  });

  const authorLink = document.getElementById('author-link');
  const authorTooltip = document.getElementById('author-tooltip');
  if (authorLink && authorTooltip) {
    let hideTimer: ReturnType<typeof setTimeout>;
    function showTooltip() {
      if (window.innerWidth < 900) return;
      const r = authorLink.getBoundingClientRect();
      (authorTooltip as HTMLElement).style.top = (r.bottom + 8) + 'px';
      (authorTooltip as HTMLElement).style.left = r.left + 'px';
      authorTooltip.classList.add('visible');
      authorTooltip.setAttribute('aria-hidden', 'false');
      clearTimeout(hideTimer);
    }
    function hideTooltip() {
      hideTimer = setTimeout(() => {
        authorTooltip.classList.remove('visible');
        authorTooltip.setAttribute('aria-hidden', 'true');
      }, 150);
    }
    authorLink.addEventListener('mouseenter', showTooltip);
    authorLink.addEventListener('mouseleave', hideTooltip);
    authorTooltip.addEventListener('mouseenter', () => clearTimeout(hideTimer));
    authorTooltip.addEventListener('mouseleave', hideTooltip);
  }
</script>
<style>
  .calculator-page-container {
    display: grid;
    grid-template-columns: 350px 1fr;
    grid-template-rows: auto auto auto;
    grid-template-areas:
      "header    calculator"
      "sidebar   calculator"
      "sidebar   content";
    gap: 2rem;
    align-items: start;
  }
  .page-header     { grid-area: header; }
  .page-calculator { grid-area: calculator; min-width: 0; align-self: center; }
  .page-sidebar    { grid-area: sidebar; position: sticky; top: 1rem; display: grid; gap: .75rem; }
  .page-content    { grid-area: content; min-width: 0; }
  .info-box {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 1rem;
  }
  .info-box aside {
    display: grid;
    grid-template-columns: 50px 1fr 1fr;
    align-items: center;
    gap: 0.75rem;
    /* background: rgba(255,255,255,0.05);
    border-radius: 12px;
    padding: 1rem; */
  }
  .info-box img {
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    height: 50px;
  }
  .eyebrow {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(255,255,255,0.4);
    margin-bottom: 0.2rem;
  }
  .author {
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    text-decoration: none;
  }
  .author-credential {
    display: block;
    font-size: 0.72rem;
    color: rgba(255,255,255,0.45);
    margin-left: calc(50px + 0.75rem);
    margin-top: 5px;
  }
  .author:hover { text-decoration: underline; }
  .last-updated time {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.75);
  }
  .toc {
    background: rgba(255,255,255,0.05);
    border-radius: 8px;
    padding: 1.25rem;
    user-select: none;
  }
  .toc-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.5);
    margin-bottom: 0.75rem;
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .toc-link {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.2s;
  }
  .toc-link:hover { color: white; }
  .embed-button {
    width: 100%;
    padding: 0.6rem 1rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 8px;
    color: rgba(255,255,255,0.8);
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .embed-button:hover { background: rgba(255,255,255,0.12); }
  .embed-panel {
    margin-top: 0.75rem;
    padding: 1rem;
    background: rgba(0,0,0,0.2);
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .embed-label {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.6);
    margin-bottom: 0.5rem;
  }
  .embed-code {
    width: 100%;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    color: rgba(255,255,255,0.8);
    font-size: 0.75rem;
    font-family: monospace;
    padding: 0.5rem;
    resize: none;
    height: 80px;
    box-sizing: border-box;
  }
  .copy-embed-btn {
    margin-top: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 6px;
    color: white;
    font-size: 0.8rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .copy-embed-btn:hover { background: rgba(255,255,255,0.18); }
  .embed-attribution {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
    margin-top: 0.5rem;
    text-align: center;
  }
  .embed-attribution a { color: rgba(255,255,255,0.6); }
  .author-tooltip {
    position: fixed;
    z-index: 1000;
    width: 280px;
    background: #fff;
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0 8px 32px rgba(0,0,0,0.2), 0 1px 4px rgba(0,0,0,0.08);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
    color: #111;
  }
  .author-tooltip.visible {
    opacity: 1;
    pointer-events: auto;
  }
  .at-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .at-photo {
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    flex-shrink: 0;
  }
  .at-name-block { display: flex; flex-direction: column; gap: 0.2rem; }
  .at-name { font-weight: 700; font-size: 0.95rem; color: #111; }
  .at-link { font-size: 0.8rem; color: var(--brand-from); }
  .at-link:hover { text-decoration: underline; }
  .at-bio { font-size: 0.8rem; color: #555; line-height: 1.5; margin-bottom: 0.75rem; }
  .at-footer { display: flex; flex-direction: column; gap: 0.3rem; }
  @media (max-width: 768px) {
    .calculator-page-container {
      grid-template-columns: 1fr;
      grid-template-areas:
        "header"
        "calculator"
        "sidebar"
        "content";
    }
    .page-sidebar { position: static; }
  }
  @media (min-width: 769px) {
    .page-sidebar { margin-bottom: 2rem; }
  }
</style>